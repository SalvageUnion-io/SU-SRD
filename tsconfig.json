{
  // The repo's compiler options, and the type-check of `tools/` and every
  // `packages/*` (Node + Bun). `bun run typecheck` is one `tsc -b` over this
  // project and the three apps it references; each app extends these options
  // and adds its own runtime: the DOM and JSX (`apps/web`) or the workerd
  // globals (the two Workers, one project each so their generated `Env`s do not
  // merge). An app checks the package sources it imports under its own runtime.
  "compilerOptions": {
    /* Strict Type-Checking Options */
    "strict": true,

    /* Additional Checks */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    /* Module Resolution Options */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    /* Emit: none. Every project is a type-check; bundlers do the building. */
    "noEmit": true,

    /* Interop Constraints */
    "isolatedModules": true,
    "allowJs": false,
    "checkJs": false,

    /* Language and Environment */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleDetection": "force",
    "types": ["node", "bun-types"],

    /* Type Checking */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Incremental builds */
    "incremental": true
  },
  "include": ["tools", "packages"]
}
