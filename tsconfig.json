{
  // The solution: `bun run typecheck` is one `tsc -b` over these references,
  // so every file is checked once. Consumers read a referenced library through
  // its declarations instead of re-checking its source. Options live in
  // tsconfig.base.json (via tsconfig.dom.json / tsconfig.worker.json).
  //
  // Build mode will not reference a `noEmit` project (TS6310), so the
  // libraries are `composite` and emit declarations only, into the gitignored
  // `.tsbuild/`; the apps and tools stay `noEmit`.
  "files": [],
  "references": [
    { "path": "packages/salvageunion-reference" },
    { "path": "packages/cantina-domain" },
    { "path": "packages/gates" },
    { "path": "apps/web" },
    { "path": "apps/discord-bot" },
    { "path": "apps/su-assets" },
    { "path": "tools" }
  ]
}
