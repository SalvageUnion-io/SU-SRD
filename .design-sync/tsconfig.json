{
  // The type-check for the authored design-sync previews, run by the `tools`
  // workspace's `typecheck` (so `bun run typecheck`, `bun run check` and CI all
  // reach it). Without it the previews were type-checked by nothing: a renamed
  // component-lib prop left a stale preview that only the converter would find.
  //
  // Separate from `tsconfig.dts.json`, which EMITS component-lib's declarations
  // for the sync and is not a check. This one emits nothing.
  //
  // `.design-sync/` is not a workspace, so `component-lib` and
  // `salvageunion-reference` do not resolve from here through `node_modules`
  // (the isolated linker links them only into their consumers). `paths` points
  // both at the workspace sources, which is what the converter bundles.
  "extends": "../packages/component-lib/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "component-lib": ["../packages/component-lib/src/index.ts"],
      "salvageunion-reference": ["../packages/salvageunion-reference/lib/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".cache", "learnings"]
}
