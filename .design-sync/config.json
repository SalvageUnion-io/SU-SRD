{
  "projectId": "ef3d846c-aff3-488c-a208-695068f62ae3",
  "shape": "package",
  "pkg": "component-lib",
  "globalName": "SalvageUnion",
  "srcDir": "src",
  "tsconfig": "tsconfig.json",
  "buildCmd": "bun run build:package && ./node_modules/.bin/tsc -p .design-sync/tsconfig.dts.json && .ds-sync/node_modules/.bin/tailwindcss -i .design-sync/tailwind-entry.css -o packages/component-lib/.ds-css/compiled.css",
  "cssEntry": ".ds-css/compiled.css",
  "readmeHeader": ".design-sync/conventions.md",
  "extraEntries": ["salvageunion-reference", "../../.design-sync/ds-provider.tsx"],
  "extraFonts": [
    "../../apps/itun/node_modules/@fontsource/barlow/400.css",
    "../../apps/itun/node_modules/@fontsource/barlow/500.css",
    "../../apps/itun/node_modules/@fontsource/barlow/600.css",
    "../../apps/itun/node_modules/@fontsource/barlow/700.css",
    "../../apps/itun/node_modules/@fontsource/barlow-semi-condensed/500.css",
    "../../apps/itun/node_modules/@fontsource/barlow-semi-condensed/600.css",
    "../../apps/itun/node_modules/@fontsource/barlow-semi-condensed/700.css"
  ],
  "provider": {
    "component": "SalvageUnionDataProvider"
  },
  "dtsPropsFor": {
    "EntityHrefProvider": "/** Builds a navigable show-page href for an entity. The route shape is the consuming app's concern, so the library stays route-agnostic. Return `undefined` for entities with no page. */\n  value: ((entity: SURefEntity) => string | undefined) | undefined;\n  children?: React.ReactNode;",
    "EntityDetailLinkProvider": "/** When true, nested \"View details\" controls open the entity's show page in a new tab (via the EntityHrefProvider builder) instead of the in-place modal. The SRD sets this; ITUN leaves it false so detail stays an in-app modal. */\n  value: boolean;\n  children?: React.ReactNode;",
    "EntityExternalLinkProvider": "/** Builds an external cross-link node for an entity (e.g. a \"View in SRD →\" deep link). Full entity cards render it in their foot band. Return `undefined` for entities with no external page. */\n  value: ((entity: SURefEntity) => React.ReactNode | undefined) | undefined;\n  children?: React.ReactNode;",
    "PatternHrefProvider": "/** Builds the href of a chassis PATTERN's own page. Patterns are nested objects on a chassis, not entities — they have no id and no schemaName — so this builder takes both halves of the identity. Provide nothing and pattern rows stay inert. */\n  value: ((chassis: SURefEntity, pattern: SURefObjectPattern) => string | undefined) | undefined;\n  children?: React.ReactNode;"
  },
  "storyImports": {
    "loaders": {
      ".md": "text"
    }
  },
  "overrides": {
    "ReferenceEntityCard": { "viewport": "900x1900" },
    "ClassAbilityTree": { "viewport": "900x1600" },
    "Content": { "viewport": "900x1200" },
    "MasonryColumns": { "viewport": "900x1200" },
