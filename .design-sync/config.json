    "FilterRow": { "cardMode": "column", "viewport": "900x1000" },
    "SheetPickerModal": { "cardMode": "single", "primaryStory": "Picker", "viewport": "1200x1400" },
    "Toaster": { "cardMode": "single", "primaryStory": "Statuses", "viewport": "900x700" },
    "ActiveItemBand": { "cardMode": "column", "viewport": "900x900" },
    "WizTracker": { "cardMode": "column", "viewport": "900x1100" },
    "ClassAbilityTree": { "cardMode": "column", "viewport": "900x1600" },
    "Content": { "cardMode": "column", "viewport": "900x1200" },
