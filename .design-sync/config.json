    "ClassAbilityStep": { "viewport": "900x1900" },
    "EquipmentStep": { "viewport": "900x1900" },
    "CrawlerTypeSelectStep": { "viewport": "900x1900" },
    "SystemsList": { "viewport": "900x1400" },
    "WizShell": { "viewport": "900x1100" },
    "WizTracker": { "viewport": "900x1100" },
    "BackgroundStep": { "viewport": "900x1000" },
    "DisplayPanel": { "viewport": "900x1300" },
    "ActionsDeck": { "viewport": "900x1300" },
    "ModalShell": { "cardMode": "single", "primaryStory": "Action", "viewport": "900x700" },
    "MobileSearchDialog": { "cardMode": "single", "primaryStory": "OpenSheet", "viewport": "900x700" },
    "NavDrawer": { "cardMode": "single", "primaryStory": "SrdForm", "viewport": "900x900" },
    "EntitySearcher": { "cardMode": "column", "viewport": "1200x1400" },
