# R2 credentials for `assets:upload` and `assets:export` (packages/gates/lib/r2.ts).
#
# Secret-free by design: each value is a 1Password reference (vault SUSRD,
# item lp-bucket-api), resolved for one command by
#
#   op run --env-file=tools/r2.op.env -- bun run assets:export <out-dir>
#
# tools/__tests__/op-env-files.test.ts fails a value here that is neither
# empty nor `op://…`.

# The S3 endpoint URL; r2.ts takes the account id from it
R2_ACCOUNT_ID=op://SUSRD/lp-bucket-api/Jurisdiction Endpoint
R2_ACCESS_KEY_ID=op://SUSRD/lp-bucket-api/Account Key ID
R2_SECRET_ACCESS_KEY=op://SUSRD/lp-bucket-api/Secret Access Key
