{
  // The `tools` workspace's type-check, which also owns `test/**`: the preload
  // files every workspace bunfig loads belong to no workspace of their own, so
  // the workspace that holds the repo's root-level TypeScript checks them.
  //
  // Before `tools/` was a workspace this file was `tsconfig.tools.json` at the
  // root, run beside `bun --filter "*" typecheck` by a second process, because
  // nothing else type-checked either directory: a type error in a gate could
  // merge green. As a workspace, `bun --filter "*" typecheck` reaches it.
  //
  // `.design-sync/` (the claude.ai/design previews) is checked by this
  // workspace's `typecheck` too, with its own tsconfig: it needs JSX, the DOM
  // and the component-lib sources, none of which a gate script should see.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // `tools/` reads JSON baselines (styling-baseline, a11y-baseline) directly.
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "../test/**/*.ts"]
}
