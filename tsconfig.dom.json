{
  // Shared base for the browser app (apps/web) and the packages it renders
  // through (observability): the repo base plus the DOM and JSX.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx"
  }
}
