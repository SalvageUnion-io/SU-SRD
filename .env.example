# Root-level environment variables.
#
# ITUN runs with none of these set: an unset VITE_CONVEX_URL means nobody can
# sign in, so every visitor gets the read-only Solo mode. The storage modes are
# the table at the top of apps/itun/CLAUDE.md.
#
# Per-app env (e.g. the Discord bot's DISCORD_TOKEN) lives in each app's own
# .env / .env.example. None of the VITE_-prefixed variables below is a secret —
# anything VITE_-prefixed is inlined into the browser bundle, so never put one
# there that is.

# --- apps/itun ---
# Convex deployment URL. Unset = nobody can sign in: read-only (ADR-034).
VITE_CONVEX_URL=
# Test-only auth bridge.
VITE_TEST_AUTH=

# --- both browser apps ---
# Sentry. With no DSN the SDK is tree-shaken out and the build looks identical
# to a working one — see tools/check-observability.ts.
VITE_SENTRY_DSN=
# Commit SHA, used as the Sentry release.
VITE_COMMIT_REF=
