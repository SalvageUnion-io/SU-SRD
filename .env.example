# Root-level environment variables.
#
# Per-app env (e.g. the Discord bot's DISCORD_TOKEN) lives in each app's own
# .env / .env.example. A local script's credentials are committed as 1Password
# references instead (apps/discord-bot/.env.example, tools/r2.op.env), resolved
# by `op run --env-file=<file> -- <command>`; never put a secret in either. None of the VITE_-prefixed variables below is a secret —
# anything VITE_-prefixed is inlined into the browser bundle, so never put one
# there that is.

# --- apps/web (the Cantina) ---
# Convex deployment URL. Every build needs one, and apps/web/vite.cantina.config.ts
# refuses to start without it: `bun run dev` writes the local
# deployment's into apps/web/.env.local; CI and the deploy pass it in.
VITE_CONVEX_URL=
# Test-only auth bridge.
VITE_TEST_AUTH=

# --- both browser apps ---
# Commit SHA, sent as the release with each browser error report.
VITE_COMMIT_REF=
