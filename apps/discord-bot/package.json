{
  "name": "@suref/discord-bot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy-commands": "bun run src/deploy-commands.ts",
    "deploy-commands:global": "DEPLOY_GLOBAL=true bun run src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo 'No tests configured'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "salvageunion-reference": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
