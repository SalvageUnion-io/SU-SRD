{
  "name": "discord-bot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "scripts": {
    "deploy-commands": "bun run src/deploy-commands.ts",
    "deploy-commands:global": "DEPLOY_GLOBAL=true bun run src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "clean": "true"
  },
  "dependencies": {
    "@discordjs/builders": "1.14.1",
    "@discordjs/collection": "2.1.1",
    "@discordjs/rest": "2.6.3",
    "@randsum/roller": "catalog:",
    "discord-api-types": "0.38.53",
    "discord.js": "^14.27.0",
    "observability": "workspace:*",
    "salvageunion-reference": "workspace:*"
  },
  "devDependencies": {}
}
