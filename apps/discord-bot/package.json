{
  "name": "discord-bot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "scripts": {
    "deploy-commands": "bun run src/deploy-commands.ts",
    "deploy-commands:global": "DEPLOY_GLOBAL=true bun run src/deploy-commands.ts",
    "typecheck": "bun ../../packages/salvageunion-reference/tools/ensureGenerated.ts && tsc -b",
    "test": "bun test --parallel=4 --no-isolate",
    "clean": "true",
    "deploy": "wrangler deploy",
    "worker:bundle": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "build": "bun run typecheck && bun run worker:bundle"
  },
  "dependencies": {
    "@discordjs/builders": "1.14.1",
    "@discordjs/rest": "2.6.3",
    "@randsum/roller": "catalog:",
    "@randsum/salvageunion": "catalog:",
    "discord-api-types": "0.38.53",
    "itun-domain": "workspace:*",
    "observability": "workspace:*",
    "salvageunion-reference": "workspace:*"
  }
}
