{
  "name": "@suref/discord-bot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:watch": "bun --watch run src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "deploy-commands": "bun run src/deploy-commands.ts",
    "deploy-commands:global": "DEPLOY_GLOBAL=true bun run src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@randsum/roller": "^2.0.0",
    "@sentry/node": "10.57.0",
    "discord.js": "^14.26.4",
    "salvageunion-reference": "workspace:*"
  },
  "devDependencies": {}
}
