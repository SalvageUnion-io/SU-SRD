{
  // Discord HTTP interactions (ADR-033 §1); the application's Interactions
  // Endpoint URL points here. No `nodejs_compat`: the portable Discord packages
  // run on workerd unaided, and the shim would hide a Node-only import.
  "name": "su-discord-bot",
  "main": "src/worker/index.ts",
  // Explicit, and what it was while unset: with no `routes`, the
  // Interactions Endpoint URL is su-discord-bot's workers.dev address.
  "workers_dev": true,

  // At or below the workerd the wrangler devDependency bundles (deploy-cloudflare.yml).
  "compatibility_date": "2026-07-13",

  // Public, not secrets: the application id is in every invite URL and the
  // public key only verifies Discord's signatures.
  "vars": {
    "DISCORD_APPLICATION_ID": "1442878052823470172",
    "DISCORD_PUBLIC_KEY": "3cda4815a9676fee399a6475c5533f7d2375d1293af87993c5cd1f4e4f2c0200"
  },

  // A deploy fails while one is unset; set with `wrangler secret put`.
  // BACKEND_SITE_URL is the `.convex.site` origin.
  "secrets": {
    "required": ["DISCORD_TOKEN", "BACKEND_SITE_URL", "BOT_SECRET"]
  },

  // The site Worker's BotGateway (apps/web/src/worker/botGateway.ts): the
  // Game client's first stop, ahead of Convex's /bot/*.
  "services": [{ "binding": "SITE", "service": "su-srd", "entrypoint": "BotGateway" }],

  // Per-command usage, one data point per interaction (src/worker/index.ts),
  // queryable with SQL for months; Workers Logs keep the same line for days.
  // The dataset is created on the first write.
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "su_discord_bot_usage" }],

  // Traces: a span per binding call and outbound fetch (Convex, R2, Images,
  // Browser Rendering), in the dashboard next to the logs. Issues is the error
  // tracker: it groups uncaught exceptions, 5xx answers and `console.error`
  // (`reportError`, `src/reportError.ts`) into issues, alerted on by the
  // dashboard's Issues automations. tools/check-observability.ts requires all three.
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
    "issues": { "enabled": true }
  },

  // Issues' stacks point at the source, not the bundle.
  "upload_source_maps": true
}
