{
  // Discord bot as a Cloudflare Worker serving HTTP interactions (ADR-033 §1).
  //
  // The Discord application's Interactions Endpoint URL points here; the
  // setting is application-wide, so this Worker serves every server at once.
  //
  // No `nodejs_compat`: the portable Discord packages (@discordjs/builders,
  // /collection, /rest and discord-api-types) run on workerd unaided, and the
  // Node shim would both grow the bundle and make it easy to reintroduce a
  // Node-only import without noticing.
  //
  // That note asked anything that genuinely needed a flag to "add it
  // deliberately and say what". `@sentry/cloudflare` did — see
  // `compatibility_flags` above, which grants AsyncLocalStorage and nothing
  // else.
  "name": "su-discord-bot",
  "main": "src/http/worker.ts",

  // Held at or below the workerd that the wrangler devDependency bundles, so
  // `wrangler dev` runs locally. A newer date fails with "requires
  // compatibility date X, but the newest date supported by this server binary
  // is Y" — which reads like a config error and is really a version skew.
  "compatibility_date": "2026-07-13",

  // `nodejs_als` — AsyncLocalStorage ONLY, not the full `nodejs_compat` shim.
  //
  // `@sentry/cloudflare` imports `node:async_hooks` to isolate scope per
  // request. Without a flag wrangler warns and the Worker throws at runtime.
  //
  // This is the narrow flag on purpose, and it is the deliberate exception the
  // note below reserved. `nodejs_compat` would pull the whole Node shim and
  // make it easy to reintroduce a Node-only import without noticing; measured,
  // `nodejs_als` alone clears the warning, so the broad flag buys nothing.
  "compatibility_flags": ["nodejs_als"],

  // ---------------------------------------------------------------------------
  // Public configuration. NOT secrets, and treating them as secrets was a
  // mistake worth naming: it put two values that Discord publishes to every app
  // owner behind a manual `wrangler secret put`, which is friction that buys
  // nothing and hides which values genuinely need protecting.
  //
  //   DISCORD_APPLICATION_ID  appears in every invite URL for this app.
  //   DISCORD_PUBLIC_KEY      the Ed25519 *verification* key. It can check that
  //                           a request came from Discord; it cannot produce one.
  //                           Publishing it is what public keys are for.
  //
  // Committing them means a mismatch is reviewable in a diff rather than
  // discovered as a silent 401 on every interaction.
  // ---------------------------------------------------------------------------
  "vars": {
    "DISCORD_APPLICATION_ID": "1442878052823470172",
    "DISCORD_PUBLIC_KEY": "3cda4815a9676fee399a6475c5533f7d2375d1293af87993c5cd1f4e4f2c0200"
  },

  // Secrets this Worker cannot run correctly without. A deploy fails while one
  // is unset (wrangler binds each as `inherit`, and the API rejects a missing
  // one), so Sentry can never go dark here unnoticed. Set out of band with
  // `wrangler secret put`; the value is never in this file.
  //
  //   SENTRY_DSN         where this Worker reports errors.
  //   DISCORD_TOKEN      bot token — a bearer credential for follow-up webhook
  //                      calls.
  //   ITUN_BOT_SECRET    ITUN bot credential (the same value as the Convex
  //                      deployment's ITUN_BOT_SECRET).
  //   ITUN_CONVEX_SITE_URL  the Convex HTTP-actions origin. Not itself a secret,
  //                      but paired with the one above; `/health` answers 503
  //                      while either is missing.
  //
  // One plain value stays optional, so it is not listed here:
  //
  //   ITUN_WEB_URL       the ITUN origin the bot links to; defaults to
  //                      https://intheunionnow.com.
  //
  // Declaring `secrets` makes a local `wrangler dev` bind only `vars` and these
  // required names from .dev.vars, .env and process.env, so ITUN_WEB_URL never
  // reaches a top-level local run. `env.local` below is the local run.
  "secrets": {
    "required": ["SENTRY_DSN", "DISCORD_TOKEN", "ITUN_BOT_SECRET", "ITUN_CONVEX_SITE_URL"]
  },

  // Cron Trigger for the liveness heartbeat.
  //
  // Every 5 minutes, matching HEARTBEAT_INTERVAL_MINUTES in
  // `src/observability.ts` — the Sentry cron monitor's expected interval is
  // configured against that number, so the two move together or the monitor
  // alerts on a schedule nobody changed.

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "observability": {
    "enabled": true
  },

  // Local runs only: `bunx wrangler dev --env local`. Never deploy it.
  //
  // `secrets` and `vars` are not inherited by a named environment, so this one
  // declares no `secrets` and wrangler binds everything in .dev.vars or .env,
  // ITUN_WEB_URL included. wrangler warns that
  // "secrets" is missing here; that absence is the point. `vars` must repeat
  // the top-level block exactly. package.json's deploy scripts pass `--env=""`,
  // so a deploy always targets the top level.
  "env": {
    "local": {
      "vars": {
        "DISCORD_APPLICATION_ID": "1442878052823470172",
        "DISCORD_PUBLIC_KEY": "3cda4815a9676fee399a6475c5533f7d2375d1293af87993c5cd1f4e4f2c0200"
      }
    }
  }
}
