# Discord bot — the credentials deploy-commands.ts reads.
#
# Secret-free by design: each value is a 1Password reference (or empty), never
# the secret. `op run` resolves them for one command, so no local .env is
# needed. From the repo root:
#
#   op run --env-file=apps/discord-bot/.env.example -- bun run deploy-commands:global
#
# tools/__tests__/op-env-files.test.ts fails a value here that is neither empty
# nor `op://…`.

# Bot token (vault SUSRD, item discord-bot)
DISCORD_TOKEN=op://SUSRD/discord-bot/Bot Token

# Application/Client ID
DISCORD_CLIENT_ID=op://SUSRD/discord-bot/client id

# Guild ID for `deploy-commands` (instant updates in one test guild). Not a
# secret, and left commented out: a blank line here would override the value
# from your shell or a local .env.
# DISCORD_GUILD_ID=
