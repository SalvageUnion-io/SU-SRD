# Discord Bot Configuration
# Get these from: https://discord.com/developers/applications

# Bot token (keep secret!)
DISCORD_TOKEN=

# Application/Client ID
DISCORD_CLIENT_ID=

# Guild ID for development (optional, for instant command updates)
# Leave empty for global command deployment
DISCORD_GUILD_ID=

# Sentry error tracking DSN (a deploy requires it; a local run without it is a no-op)
SENTRY_DSN=
