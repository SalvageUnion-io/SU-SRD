{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext"
  },
  // `test/env.ts` is preloaded by bunfig.toml for every test in this workspace
  // (src/config.ts calls requireEnv at module scope), but was outside this
  // include and so type-checked by nothing.
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
