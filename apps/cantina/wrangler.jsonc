{
  // The Cantina at salvageunion.io/build (ADR-048) — the SPA on Workers Static Assets
  // (ADR-033). The script runs first for every request: outside `/build/` it
  // answers the old host's 301s, and under it it reads every answer through
  // the asset binding, turning a missing file into a 404 (src/worker/index.ts).
  // Every header is public/_headers, which the build moves to `dist/_headers`
  // (vite.config.ts) and the asset server applies to what the binding answers.
  "name": "su-cantina",

  // A Workers ROUTE, not a Custom Domain: a route runs before su-srd's Custom
  // Domain on the same hostname, so `/build*` never reaches srd. Publishing it
  // needs the deploy token's Zone → Workers Routes: Edit on salvageunion.io,
  // which deploy-cloudflare.yml checks before anything ships.
  //
  // intheunionnow.com and its `www` stay attached, where the Cantina lived until
  // ADR-048: the Worker 301s them to the same page here (legacyHost.ts). `www`
  // also keeps the zone's Redirect Rule acting on it (ADR-033, "Configuration
  // outside the repo").
  "routes": [
    { "pattern": "salvageunion.io/build*", "zone_name": "salvageunion.io" },
    { "pattern": "intheunionnow.com", "custom_domain": true },
    { "pattern": "www.intheunionnow.com", "custom_domain": true }
  ],
  "workers_dev": false,
  // Preview URLs (`pr-<n>-su-cantina.alxjrvs.workers.dev`), for the Worker
  // Previews (.github/workflows/deploy-preview.yml). Separate from
  // `workers_dev`: su-cantina.alxjrvs.workers.dev stays off. Unset, they follow
  // `workers_dev` and are off.
  "preview_urls": true,
  "main": "src/worker/index.ts",
  // At or below the workerd the wrangler devDependency bundles (deploy-cloudflare.yml).
  "compatibility_date": "2026-07-13",

  // Secrets, set with `wrangler secret put`, all OPTIONAL and so not listed in
  // a `secrets.required` block:
  //
  // - CF_ACCOUNT_ID and BROWSER_RENDERING_TOKEN (a token with Browser
  //   Rendering edit permission). With both, a shared thing's link preview
  //   carries its rendered card (src/worker/linkPreview.ts, issue 1280);
  //   without them it unfurls as text.
  // - CONVEX_LOG_STREAM_SECRET, the production Convex log stream's webhook
  //   secret. Without it POST /build/__convex-logs answers 503 and Convex's
  //   errors reach nothing (packages/observability/src/cloudflare.ts).

  // CONVEX_URL: the Convex deployment a link preview reads what a stranger
  // may see from (`publicSheet.preview`, issue 1280): the URL the SPA is built
  // against, `CANTINA_CONVEX_URL` in deploy-cloudflare.yml. BASE_PATH: the base
  // the SPA is built under, `SITE.base` (src/lib/site.ts). The routing test
  // holds both equal.
  "vars": {
    "CONVEX_URL": "https://exuberant-porpoise-183.convex.cloud",
    "BASE_PATH": "/build"
  },

  // A Worker Preview (deploy-preview.yml) inherits none of the vars above:
  // the staging deployment its SPA is built against, and the same base.
  "previews": {
    "vars": {
      "CONVEX_URL": "https://perfect-donkey-72.convex.cloud",
      "BASE_PATH": "/build"
    }
  },

  // Caps fresh link-preview renders (Browser Rendering time) per Cloudflare
  // location: src/worker/linkPreview.ts. A cached picture is never counted.
  // `namespace_id` is any integer unique on the account.
  //
  // ERROR_REPORT_LIMIT caps browser error reports (POST /build/__errors) per
  // address.
  "ratelimits": [
    { "name": "OG_RENDER_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    {
      "name": "ERROR_REPORT_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A miss is answered with index.html: the shell for every client route.
    // The Worker turns it into a 404 for a missing FILE, which keeps a rotated
    // chunk a 404 (#759).
    "not_found_handling": "single-page-application",
    // Every request (RUN_WORKER_FIRST in src/worker/legacyHost.ts, which the
    // routing test holds this equal to). Never a pattern list: a negative
    // pattern such as `!/build/*` sends its matches straight to the assets, so a
    // missing `/build/assets/*` chunk got the shell, pinned `immutable`.
    "run_worker_first": true
  },

  // Traces: a span per binding call and outbound fetch (Convex, R2, Images,
  // Browser Rendering), in the dashboard next to the logs. Issues is the error
  // tracker: it groups uncaught exceptions, 5xx answers and `console.error`
  // (`observability/cloudflare`'s `reportError`) into issues, alerted on by the
  // dashboard's Issues automations. tools/check-observability.ts requires all three.
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
    "issues": { "enabled": true }
  },

  // Issues' stacks point at the source, not the bundle.
  "upload_source_maps": true,

  // `bun run preview` (`wrangler dev`) serves the built `dist/` through this
  // Worker on the dev server's port: the e2e suite's CI server.
  "dev": { "port": 5173 }
}
