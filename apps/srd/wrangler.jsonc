{
  // salvageunion.io — the static SRD on Workers Static Assets (ADR-033). The
  // script runs only for a miss (src/worker/index.ts); every header on a real
  // file is public/_headers. Built in GitHub Actions, not Workers Builds
  // (ADR-033 §4).
  "name": "su-srd",
  "main": "src/worker/index.ts",
  // At or below the workerd the wrangler devDependency bundles (deploy-cloudflare.yml).
  "compatibility_date": "2026-07-13",
  // AsyncLocalStorage for @sentry/cloudflare; tools/check-observability.ts requires it.
  "compatibility_flags": ["nodejs_als"],

  // A deploy fails while one is unset; set with `wrangler secret put`. The
  // `srd` Sentry project's DSN, the one the browser bundle inlines.
  "secrets": {
    "required": ["SENTRY_DSN"]
  },

  // `www` is attached so the zone's Redirect Rule can act on it; the redirect
  // cannot live in `_redirects` (ADR-033, "Configuration outside the repo").
  "routes": [
    { "pattern": "salvageunion.io", "custom_domain": true },
    { "pattern": "www.salvageunion.io", "custom_domain": true }
  ],
  // Explicit: `routes` turns workers.dev off otherwise, and the smoke list
  // probes su-srd there to tell a broken route from a broken deploy
  // (tools/smoke-production.sh).
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A miss runs the Worker, which answers dist/404.html (or a bare 404 under
    // `/assets/`) with `no-store`. Not `404-page`: Static Assets applies
    // `_headers` to that response by path, so a missing chunk's 404 took the
    // `/assets/*` rule's year of `immutable`. Not SPA mode either: srd is
    // pre-rendered, so a miss is genuinely a miss.
    "not_found_handling": "none"
  },

  "observability": {
    "enabled": true
  },

  // `bun run preview` (`wrangler dev`) serves the built `dist/` exactly as
  // above on the dev server's port: the e2e suite's CI server, and the one
  // `scripts/og-screenshots.ts` renders through.
  "dev": { "port": 4321 }
}
