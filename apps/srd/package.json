{
  "name": "srd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "scripts": {
    "dev": "bun ../../packages/salvageunion-reference/tools/ensureGenerated.ts && bun ssg/dev.ts",
    "typecheck": "bun ../../packages/salvageunion-reference/tools/ensureGenerated.ts && tsc --noEmit -p tsconfig.json",
    "build": "bun run typecheck && bun ssg/build.ts",
    "og:generate": "bun ssg/build.ts && OG_SCREENSHOTS=1 bun scripts/og-screenshots.ts",
    "og:install-browser": "playwright install chromium",
    "preview": "wrangler dev",
    "test": "bun test --parallel=4 --no-isolate",
    "clean": "rm -rf dist node_modules/.vite",
    "check:examples": "bun ssg/checkPageExamples.ts",
    "deploy": "wrangler deploy",
    "worker:bundle": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource/barlow": "catalog:",
    "@fontsource/barlow-semi-condensed": "catalog:",
    "@sentry/browser": "catalog:",
    "component-lib": "workspace:*",
    "observability": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "salvageunion-reference": "workspace:*"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "vite-plugin-pwa": "1.3.0"
  }
}
