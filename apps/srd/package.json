{
  "name": "srd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "scripts": {
    "dev": "bun ssg/dev.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun ssg/build.ts",
    "og:generate": "bun ssg/build.ts && OG_SCREENSHOTS=1 bun scripts/og-screenshots.ts",
    "og:install-browser": "playwright install chromium",
    "preview": "bun ssg/preview.ts --port 4321",
    "test": "bun test",
    "clean": "rm -rf dist node_modules/.vite",
    "check:examples": "bun ssg/checkPageExamples.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource/barlow": "catalog:",
    "@fontsource/barlow-semi-condensed": "catalog:",
    "@sentry/browser": "catalog:",
    "component-lib": "workspace:*",
    "observability": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "salvageunion-reference": "workspace:*"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "workbox-build": "7.4.1"
  }
}
