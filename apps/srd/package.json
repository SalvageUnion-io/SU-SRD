{
  "name": "srd",
  "private": true,
  "version": "2.9.2",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "scripts": {
    "dev": "bun ssg/dev.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun ssg/build.ts",
    "og:generate": "bun ssg/build.ts && OG_SCREENSHOTS=1 bun scripts/og-screenshots.ts",
    "og:install-browser": "playwright install chromium",
    "preview": "bun ssg/preview.ts --port 4321",
    "snapshot": "bun ssg/snapshot.ts",
    "snapshot:update": "bun ssg/snapshot.ts --update",
    "gate": "bun ssg/build.ts && bun ssg/checkPageExamples.ts && bun ssg/snapshot.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "sanity": "bun run lint -- --write && bun run format && bun run typecheck",
    "format:check": "biome format .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:watch": "bun test --watch",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "clean": "rm -rf dist node_modules/.vite",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "check:examples": "bun ssg/checkPageExamples.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource/barlow": "catalog:",
    "@fontsource/barlow-semi-condensed": "catalog:",
    "@sentry/browser": "catalog:",
    "component-lib": "workspace:*",
    "observability": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "salvageunion-reference": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:",
    "playwright": "catalog:",
    "sharp": "0.35.3",
    "vite": "catalog:",
    "workbox-build": "7.4.1"
  }
}
