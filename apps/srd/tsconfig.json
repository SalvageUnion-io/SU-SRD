{
  // Extends the repo base like every sibling workspace. This file previously
  // restated a set of options inherited from `astro/tsconfigs/base.json`; with
  // Astro gone, only the ones srd genuinely needs remain.
  //
  // srd is also no longer pinned to TypeScript 6. The app-level
  // `typescript: 6.0.3` devDependency existed solely because
  // `@astrojs/check@0.9.10` peer-depends on `^5 || ^6` — verified against the
  // published manifest, and still true of the latest release. Removing Astro
  // removes the pin, so this workspace now typechecks on the repo's TypeScript
  // 7 like everything else.
  //
  // NOTE: the root `typescript-classic` alias (typescript@6) is NOT dead and
  // must stay — `tools/check-architecture.ts` and
  // `packages/salvageunion-reference/tools/generateApiReport.ts` both import it
  // for the TS 6 compiler API. Astro was never its only consumer.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    // Nothing is emitted from here; `allowImportingTsExtensions` is only legal
    // alongside `noEmit`.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // The repo base emits declarations; this workspace emits nothing.
    "declaration": false,
    "declarationMap": false,
    "composite": false,

    /* srd's own */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["development"],
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["node", "bun-types"]
  },
  // `e2e/**/*` + `playwright.config.ts`: Playwright transpiles specs without
  // type-checking them, and biome.jsonc disables the linter for both paths, so
  // until now they were covered by the formatter alone.
  "include": [
    "src/**/*",
    "ssg/**/*",
    "test/**/*",
    "scripts/**/*",
    "e2e/**/*",
    "playwright.config.ts"
  ],
  // `include` is explicit, but a stale build output must never be typechecked.
  "exclude": ["dist"]
}
