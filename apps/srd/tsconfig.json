{
  // Extends the repo base like every sibling workspace, and typechecks on the
  // repo's TypeScript 7. Only the options srd genuinely needs are set here.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    // Nothing is emitted from here; `allowImportingTsExtensions` is only legal
    // alongside `noEmit`.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // The repo base emits declarations; this workspace emits nothing.
    "declaration": false,
    "declarationMap": false,
    "composite": false,

    /* srd's own */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["node", "bun-types"]
  },
  // `e2e/**/*` + `playwright.config.ts`: Playwright transpiles specs without
  // type-checking them, and biome.jsonc disables the linter for both paths, so
  // until now they were covered by the formatter alone.
  "include": [
    "src/**/*",
    "ssg/**/*",
    "test/**/*",
    "scripts/**/*",
    "e2e/**/*",
    "playwright.config.ts"
  ],
  // `include` is explicit, but a stale build output must never be typechecked.
  "exclude": ["dist"]
}
