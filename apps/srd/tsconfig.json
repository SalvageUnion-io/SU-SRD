{
  // Extends the browser base like itun, and typechecks on the repo's
  // TypeScript 7. Only the options srd genuinely needs are set here.
  "extends": "../../tsconfig.dom.json",
  "compilerOptions": {
    "target": "ESNext"
  },
  // `e2e/**/*` + `playwright.config.ts`: Playwright transpiles specs without
  // type-checking them, and biome.jsonc disables the linter for both paths, so
  // this include is their only check beyond the formatter.
  "include": [
    "src/**/*",
    "ssg/**/*",
    "test/**/*",
    "scripts/**/*",
    "e2e/**/*",
    "playwright.config.ts"
  ],
  // `include` is explicit, but a stale build output must never be typechecked.
  "exclude": ["dist"]
}
