# SURef Web Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED - Supabase Configuration
# =============================================================================
# These are required for the app to function

# Supabase project URL
# Get this from: https://supabase.com/dashboard/project/<project-id>/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key
# Get this from: https://supabase.com/dashboard/project/<project-id>/settings/api
# This is safe to expose in the browser - RLS policies protect your data
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# OPTIONAL - Site Configuration
# =============================================================================
# These are optional and have sensible defaults

# Site URL for sitemap generation and canonical URLs
# Defaults to localhost in development
VITE_SITE_URL=http://localhost:5173

# Enable Discord sign-in button
# Set to "true" to show the Discord OAuth button
VITE_SHOW_DISCORD_SIGNIN=false

# Google Analytics measurement ID
# Leave empty to disable analytics
VITE_GA_MEASUREMENT_ID=

# =============================================================================
# TESTING - E2E Test Configuration
# =============================================================================
# These are used for Playwright E2E tests

# Base URL for Playwright tests
# Defaults to http://localhost:5173 if not set
PLAYWRIGHT_TEST_BASE_URL=http://localhost:5173
