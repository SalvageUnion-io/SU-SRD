---
import type { StaticEntitySummary } from 'salvageunion-reference'

type Props = {
  summary: StaticEntitySummary
}

const { summary } = Astro.props
---

<div data-static-fallback class="mx-auto w-full max-w-6xl px-4 text-sm text-su-black">
  {summary.description && (
    <p class="mb-3 italic">{summary.description}</p>
  )}

  {summary.stats.length > 0 && (
    <dl class="mb-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
      {summary.stats.map(({ label, value }) => (
        <>
          <dt class="font-mono font-bold uppercase">{label}</dt>
          <dd>{value}</dd>
        </>
      ))}
    </dl>
  )}

  {summary.contentParagraphs.length > 0 && (
    <div class="mb-3 space-y-2">
      {summary.contentParagraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  )}

  {summary.traits.length > 0 && (
    <p class="mb-3">
      <span class="font-mono font-bold uppercase">Traits:</span>{' '}
      {summary.traits.join(', ')}
    </p>
  )}

  {summary.source && (
    <p class="text-xs text-su-grey-dark">
      Source: {summary.source}{summary.page ? `, p. ${summary.page}` : ''}
    </p>
  )}
</div>
