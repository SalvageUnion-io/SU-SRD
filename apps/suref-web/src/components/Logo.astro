---
type Props = {
  compact?: boolean
}

const { compact = false } = Astro.props

const label = compact ? 'SU' : 'Salvage Union'
const fontSize = compact ? 'text-base' : 'text-xl'
---

<span
  class:list={[
    'inline-flex shrink-0 cursor-pointer border border-su-black font-mono font-bold uppercase leading-none tracking-tight',
    fontSize,
  ]}
>
  <span class="bg-su-black px-1 py-0.5 text-su-white">{label}</span>
  <span class="bg-su-white px-1 py-0.5 text-su-black">SRD</span>
</span>
