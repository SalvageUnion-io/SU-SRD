---
import { getSchemaCatalog, SalvageUnionReference, getReferenceEntityData } from '../lib/gameData'
import { MobileNavIsland } from './islands/MobileNavIsland'
import { SearchIsland } from './islands/SearchIsland'
import { getCatalogBg, getCatalogLabel } from '../lib/catalogColors'
import { buildCatalogCategories } from '../lib/catalogHelpers'

type BreadcrumbItem = {
  name: string
  url: string
}

type Props = {
  breadcrumbs?: BreadcrumbItem[]
}

const { breadcrumbs } = Astro.props

const catalog = getSchemaCatalog()
const schemas = catalog.schemas.filter((s) => !s.meta)
const schemaMap = new Map(schemas.map((s) => [s.id, s]))
const currentPath = Astro.url.pathname
const catalogCategories = SalvageUnionReference.CatalogCategories.all()

const categories = buildCatalogCategories({
  catalogCategories,
  schemaMap,
  findAllIn: (schemaName, pred) => SalvageUnionReference.findAllIn(schemaName, pred),
  getReferenceEntityData,
  getCatalogBg,
  getCatalogLabel,
})

function isActive(path: string) {
  return currentPath.startsWith(path)
}
---

<!-- Cargo brand header: SU mark + SalvageUnion.io wordmark on the left, existing
     nav links pushed to the right. Dark su-ink ground, 3px rust bottom border. -->
<nav aria-label="Main navigation" class="flex items-center gap-[14px] bg-su-ink-dark px-5 py-[18px] z-50 border-b-[3px] border-su-orange-dark sm:px-[34px] sm:py-[26px]" transition:name="nav" transition:animate="none">
  <!-- Brand: solid-orange SU mark + wordmark + sub-tag -->
  <a href="/" class="flex shrink-0 items-center gap-[14px] no-underline">
    <img
      src="/logos/su-cargo-dark.svg"
      alt="Salvage Union"
      width="64"
      height="64"
      class="block size-12 shrink-0 rounded-xl sm:size-16"
    />
    <span class="flex min-w-0 flex-col">
      <span class="font-cond text-[26px] font-bold leading-[0.98] tracking-[0.005em] text-su-paper sm:text-[34px]">
        SalvageUnion<span class="text-su-orange-dark">.io</span>
      </span>
      <span class="mt-[7px] whitespace-nowrap font-cond text-[13px] font-semibold uppercase leading-none tracking-[0.22em] text-su-orange-dark sm:mt-[9px]">
        The Salvage Union SRD
      </span>
    </span>
  </a>

  <!-- Existing nav links + search + buy — moved to the right (margin-left:auto) -->
  <div class="ml-auto hidden items-center gap-[26px] lg:flex">
    <a href="/" class:list={['nav-link', isActive('/schema') || currentPath === '/' ? 'nav-link-active' : '']} aria-current={isActive('/schema') || currentPath === '/' ? 'page' : undefined}>
      SRD
    </a>

    <a href="/about/" class:list={['nav-link', isActive('/about') ? 'nav-link-active' : '']} aria-current={isActive('/about') ? 'page' : undefined}>
      ABOUT
    </a>

    <a href="/changelog/" class:list={['nav-link', isActive('/changelog') ? 'nav-link-active' : '']} aria-current={isActive('/changelog') ? 'page' : undefined}>
      CHANGELOG
    </a>

    <a href="/api/" class:list={['nav-link', isActive('/api') ? 'nav-link-active' : '']} aria-current={isActive('/api') ? 'page' : undefined}>
      API
    </a>

    <SearchIsland client:idle />
    <a href="https://leyline.press/collections/salvage-union" target="_blank" rel="noopener noreferrer" class="btn btn-active shrink-0 font-cond text-[13px] uppercase tracking-[.06em]">
      BUY THE GAME
    </a>
  </div>

  <!-- Mobile: hamburger -->
  <div class="flex lg:hidden items-center gap-2 ml-auto">
    <MobileNavIsland
      client:idle
      categories={categories}
      currentPath={currentPath}
    />
  </div>
</nav>

{breadcrumbs && breadcrumbs.length > 0 && (
  <nav aria-label="Breadcrumb" class="border-b border-su-grey-light bg-su-white px-5 py-2 sm:px-[34px]">
    <ol class="flex flex-wrap items-center gap-1.5 font-cond text-xs uppercase tracking-[0.14em] text-su-grey-dark">
      {breadcrumbs.map((item, index) => (
        <>
          {index > 0 && <li aria-hidden="true" class="select-none text-su-grey-medium">/</li>}
          <li>
            {index === breadcrumbs.length - 1 ? (
              <span aria-current="page" class="font-semibold text-su-black">{item.name}</span>
            ) : (
              <a href={item.url} class="transition-colors hover:text-su-orange-dark">{item.name}</a>
            )}
          </li>
        </>
      ))}
    </ol>
  </nav>
)}

{breadcrumbs && breadcrumbs.length > 0 && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: item.url,
      })),
    })}
  />
)}
