---
import { getSchemaCatalog, SalvageUnionReference, getReferenceEntityData } from '../lib/gameData'
import { MobileNavIsland } from './islands/MobileNavIsland'
import { SearchIsland } from './islands/SearchIsland'
import { getCatalogBg, getCatalogLabel } from '../lib/catalogColors'
import { buildCatalogCategories } from '../lib/catalogHelpers'

type BreadcrumbItem = {
  name: string
  url: string
}

type Props = {
  breadcrumbs?: BreadcrumbItem[]
}

const { breadcrumbs } = Astro.props

const catalog = getSchemaCatalog()
const schemas = catalog.schemas.filter((s) => !s.meta)
const schemaMap = new Map(schemas.map((s) => [s.id, s]))
const currentPath = Astro.url.pathname
const catalogCategories = SalvageUnionReference.CatalogCategories.all()

const categories = buildCatalogCategories({
  catalogCategories,
  schemaMap,
  findAllIn: (schemaName, pred) => SalvageUnionReference.findAllIn(schemaName, pred),
  getReferenceEntityData,
  getCatalogBg,
  getCatalogLabel,
})

function isActive(path: string) {
  return currentPath.startsWith(path)
}
---

<nav aria-label="Main navigation" class="flex h-[62px] items-center gap-[22px] bg-su-black px-9 z-50 border-b-2 border-su-black" transition:name="nav" transition:animate="none">
  <!-- Wordmark -->
  <a href="/" class="shrink-0 font-cond font-bold text-xl uppercase tracking-[.04em] text-su-white no-underline">
    SALVAGE <span class="text-su-orange">UNION</span> SRD
  </a>

  <!-- Desktop nav links -->
  <div class="hidden lg:flex items-center gap-5">
    <a href="/" class:list={['nav-link', isActive('/schema') || currentPath === '/' ? 'nav-link-active' : '']} aria-current={isActive('/schema') || currentPath === '/' ? 'page' : undefined}>
      SRD
    </a>

    <a href="/randsum/" class:list={['nav-link', isActive('/randsum') ? 'nav-link-active' : '']} aria-current={isActive('/randsum') ? 'page' : undefined}>
      RANDSUM
    </a>

    <a href="/about/" class:list={['nav-link', isActive('/about') ? 'nav-link-active' : '']} aria-current={isActive('/about') ? 'page' : undefined}>
      ABOUT
    </a>

    <a href="/changelog/" class:list={['nav-link', isActive('/changelog') ? 'nav-link-active' : '']} aria-current={isActive('/changelog') ? 'page' : undefined}>
      CHANGELOG
    </a>

    <a href="/api/" class:list={['nav-link', isActive('/api') ? 'nav-link-active' : '']} aria-current={isActive('/api') ? 'page' : undefined}>
      API
    </a>
  </div>

  <!-- Right rail: breadcrumbs (when present) + search + buy — all pushed right -->
  <div class="ml-auto hidden lg:flex items-center gap-4 min-w-0">
    {breadcrumbs && breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="min-w-0 shrink">
        {/* .crumb treatment: font-mono, 12px, muted text; bold su-white on current segment */}
        <ol class="flex flex-wrap items-center gap-1 font-mono text-[12px] text-[#b9bdb6]">
          {breadcrumbs.map((item, index) => (
            <>
              {index > 0 && <li aria-hidden="true" class="select-none opacity-50">/</li>}
              <li>
                {index === breadcrumbs.length - 1 ? (
                  <span aria-current="page" class="font-medium text-su-white">{item.name}</span>
                ) : (
                  <a href={item.url} class="text-[#b9bdb6] hover:text-su-white transition-colors">{item.name}</a>
                )}
              </li>
            </>
          ))}
        </ol>
      </nav>
    )}
    <SearchIsland client:idle />
    <a href="https://leyline.press/collections/salvage-union" target="_blank" rel="noopener noreferrer" class="btn btn-active shrink-0 font-cond text-[13px] uppercase tracking-[.06em]">
      BUY THE GAME
    </a>
  </div>

  <!-- Mobile: hamburger -->
  <div class="flex lg:hidden items-center gap-2 ml-auto">
    <MobileNavIsland
      client:idle
      categories={categories}
      currentPath={currentPath}
    />
  </div>
</nav>

{breadcrumbs && breadcrumbs.length > 0 && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: item.url,
      })),
    })}
  />
)}
