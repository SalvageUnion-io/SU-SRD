---
import { getSchemaCatalog, SalvageUnionReference, getEntityDisplayData } from 'salvageunion-reference'
import type { SURefGuide } from 'salvageunion-reference'
import { MobileNavIsland } from './islands/MobileNavIsland'
import { SearchIsland } from './islands/SearchIsland'
import Logo from './Logo.astro'
import { getCatalogBg, getCatalogLabel } from '../lib/catalogColors'

const catalog = getSchemaCatalog()
const schemas = catalog.schemas.filter((s) => !s.meta)
const schemaMap = new Map(schemas.map((s) => [s.id, s]))
const currentPath = Astro.url.pathname
const catalogCategories = SalvageUnionReference.CatalogCategories.all()

const categories = catalogCategories.map((cat) => {
  if (cat.flat) {
    const schemaName = cat.schemas[0]!
    const items = SalvageUnionReference.findAllIn(schemaName, () => true)
    return {
      label: cat.name.toUpperCase(),
      schemas: items.map((item) => {
        const display = getEntityDisplayData(item)
        return {
          id: item.id,
          displayName: item.name,
          catalogBg: (item as SURefGuide).guideColor || getCatalogBg(schemaName),
          href: `/schema/${schemaName}/item/${display.slug}`,
        }
      }),
    }
  }
  return {
    label: cat.name.toUpperCase(),
    schemas: cat.schemas.flatMap((id) => {
      const s = schemaMap.get(id)
      return s ? [{ id: s.id, displayName: s.displayName || s.title.replace('Salvage Union ', ''), catalogBg: getCatalogBg(s.id), catalogLabel: getCatalogLabel(s.id) }] : []
    }),
  }
})

function isActive(path: string) {
  return currentPath.startsWith(path)
}
---

<nav aria-label="Main navigation" class="flex h-20 items-center justify-between bg-su-white px-6 py-3 z-50" transition:name="nav" transition:animate="none">
  <!-- Logo + Search -->
  <div class="flex items-center gap-2">
    <a href="/" class="p-2">
      <Logo />
    </a>
    <div class="hidden lg:block">
      <SearchIsland client:idle />
    </div>
  </div>

  <!-- Desktop nav -->
  <div class="hidden lg:flex items-center gap-2">
    <a href="/" class:list={['btn', isActive('/schema') || currentPath === '/' ? 'btn-active' : 'btn-inactive']} aria-current={isActive('/schema') || currentPath === '/' ? 'page' : undefined}>
      SRD
    </a>

    <a href="/randsum" class:list={['btn', isActive('/randsum') ? 'btn-active' : 'btn-inactive']} aria-current={isActive('/randsum') ? 'page' : undefined}>
      RANDSUM
    </a>

    <a href="/about" class:list={['btn', isActive('/about') ? 'btn-active' : 'btn-inactive']} aria-current={isActive('/about') ? 'page' : undefined}>
      ABOUT
    </a>

    <a href="https://leyline.press/collections/salvage-union" target="_blank" rel="noopener noreferrer" class="btn btn-inactive">
      BUY THE GAME
    </a>
  </div>

  <!-- Mobile: hamburger -->
  <div class="flex lg:hidden items-center gap-2">
    <MobileNavIsland
      client:idle
      categories={categories}
      currentPath={currentPath}
    />
  </div>
</nav>
