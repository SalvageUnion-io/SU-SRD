---
import { getSchemaCatalog } from 'salvageunion-reference'
import { MobileNavIsland } from './islands/MobileNavIsland'
import { SearchIsland } from './islands/SearchIsland'
import Logo from './Logo.astro'
import { getCatalogBg } from '../lib/catalogColors'
import { schemaCategories } from '../lib/schema-categories'

const catalog = getSchemaCatalog()
const schemas = catalog.schemas.filter((s) => !s.meta)
const schemaMap = new Map(schemas.map((s) => [s.id, s]))
const currentPath = Astro.url.pathname

const categories = schemaCategories.map((cat) => ({
  label: cat.label,
  schemas: cat.schemaIds.flatMap((id) => {
    const s = schemaMap.get(id)
    return s ? [{ id: s.id, displayName: s.displayName || s.title.replace('Salvage Union ', ''), catalogBg: getCatalogBg(s.id) }] : []
  }),
}))

function isActive(path: string) {
  return currentPath.startsWith(path)
}
---

<nav class="flex h-20 items-center justify-between bg-su-white px-6 py-3 z-50" transition:name="nav" transition:animate="none">
  <!-- Logo + Search -->
  <div class="flex items-center gap-2">
    <a href="/" class="p-2">
      <Logo />
    </a>
    <div class="hidden lg:block">
      <SearchIsland client:idle />
    </div>
  </div>

  <!-- Desktop nav -->
  <div class="hidden lg:flex items-center gap-2">
    <a href="/" class:list={['btn', isActive('/schema') || currentPath === '/' ? 'btn-active' : 'btn-inactive']}>
      SRD
    </a>

    <a href="/randsum" class:list={['btn', isActive('/randsum') ? 'btn-active' : 'btn-inactive']}>
      RANDSUM
    </a>

    <a href="/about" class:list={['btn', isActive('/about') ? 'btn-active' : 'btn-inactive']}>
      ABOUT
    </a>
  </div>

  <!-- Mobile: hamburger -->
  <div class="flex lg:hidden items-center gap-2">
    <MobileNavIsland
      client:idle
      categories={categories}
      currentPath={currentPath}
    />
  </div>
</nav>
