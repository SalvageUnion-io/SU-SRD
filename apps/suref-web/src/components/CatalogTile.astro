---
// Shared catalog-tile link. Callers resolve the colors/href/name and pass them in;
// this owns the .catalog-item markup so index.astro and 404.astro don't duplicate it.
type Props = {
  href: string
  name: string
  catalogBg: string
  catalogLabel?: string | null
}

const { href, name, catalogBg, catalogLabel } = Astro.props
const style = `--catalog-bg: ${catalogBg}${catalogLabel ? `; --catalog-label: ${catalogLabel}` : ''}`
---

<a href={href} class="catalog-item" style={style}>
  <span class:list={['catalog-item__name', catalogLabel && 'catalog-item-label']}>{name}</span>
</a>
