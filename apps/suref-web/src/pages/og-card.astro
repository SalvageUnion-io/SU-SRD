---
/**
 * Build-only OG-card render surface (1:1 with the on-page entity card).
 *
 * A single static page that renders the REAL ReferenceEntityDisplay for the
 * entity named by `?schema=&item=`, framed on a fixed 1200×630 SU-black canvas.
 * tools/og-screenshots.ts drives chromium across every entity here after the
 * build and writes each screenshot to dist/schema/{schemaId}/item/{itemId}.og.png.
 *
 * Resolving the entity client-side (OgCardIsland) keeps the build to ONE page
 * instead of ~1,700. Excluded from the sitemap (astro.config) and noindexed.
 */
import '@fontsource/barlow/400.css'
import '@fontsource/barlow/500.css'
import '@fontsource/barlow/600.css'
import '@fontsource/barlow/700.css'
import '@fontsource/barlow-semi-condensed/500.css'
import '@fontsource/barlow-semi-condensed/600.css'
import '@fontsource/barlow-semi-condensed/700.css'
import '../styles/global.css'
import { OgCardIsland } from '../components/islands/OgCardIsland'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>OG card render</title>
    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
      }
      body {
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: var(--color-su-black);
        /* Anchor the card to the top so the header (entity identity) is always
           in frame; tall cards crop at the bottom edge. */
        display: flex;
        align-items: flex-start;
        justify-content: center;
      }
      /* Neutralise the island's page padding (p-4) — the canvas owns the gutters. */
      #og-card > div {
        padding: 0;
      }
      #og-card {
        width: 1200px;
        padding: 24px;
      }
    </style>
  </head>
  <body>
    <div id="og-card">
      <OgCardIsland client:load />
    </div>
  </body>
</html>
