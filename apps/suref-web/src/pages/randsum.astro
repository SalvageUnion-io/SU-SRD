---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import roboSuExample from '../assets/robo-su-example.png'
---

<BaseLayout
  title="RANDSUM.dev Discord Bot - Salvage Union SRD"
  description="Roll on all Salvage Union Roll Tables with the RANDSUM.dev Discord bot."
>
  <div class="flex w-full flex-1 flex-col justify-center py-12">
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-8 px-6">

      <!-- Main content card -->
      <div class="rounded-md border-2 border-discord bg-su-white shadow-lg">
        <!-- Card header -->
        <div class="bg-discord px-6 py-4">
          <span class="inline-block box-decoration-clone bg-su-black px-1 font-mono font-bold uppercase leading-none text-su-white text-[1.75rem]" style="line-height: 1;">
            Unofficial Salvage Union Discord Bot
          </span>
        </div>

        <div class="flex flex-col gap-8 p-6 lg:p-8">
          <!-- Two-column layout -->
          <div class="flex flex-col items-center gap-8 lg:flex-row lg:items-start">
            <!-- Left: Screenshot -->
            <div class="w-full flex-1 lg:max-w-[50%]">
              <div class="overflow-hidden rounded-md border-2 border-su-grey-light">
                <Image
                  src={roboSuExample}
                  alt="Randsum Robo Discord Bot example"
                  widths={[400, 600]}
                  sizes="(max-width: 1024px) 100vw, 50vw"
                  loading="lazy"
                  class="h-auto w-full object-contain"
                />
              </div>
            </div>

            <!-- Right: Description + CTA -->
            <div class="w-full flex-1 lg:max-w-[50%]">
              <div class="flex flex-col gap-6">
                <p class="text-base font-medium leading-relaxed">
                  Roll on all Salvage Union Roll Tables with contextual results tailored to your
                  Salvage Union sessions with the RANDSUM.dev Discord bot!
                </p>
                <p class="text-base leading-relaxed">
                  Visit{' '}
                  <a
                    href="https://randsum.dev/packages/robo/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-bold text-discord hover:underline"
                  >
                    randsum.dev
                  </a>{' '}
                  to learn more about the RANDSUM.dev ecosystem of tools!
                </p>

                <!-- Add to Discord CTA -->
                <a
                  href="https://discord.com/oauth2/authorize?client_id=1290434147159904276&permissions=274877906944&scope=bot%20applications.commands"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full rounded-md bg-discord px-8 py-4 text-center font-mono text-lg font-bold uppercase text-su-white transition-colors hover:bg-discord-hover"
                >
                  + Add to Discord
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
