---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getSchemaCatalog } from '../lib/gameData'
import { getCatalogBg, getCatalogLabel } from '../lib/catalogColors'

const catalog = getSchemaCatalog()
const schemas = catalog.schemas.filter((s) => !s.meta).slice(0, 6)
---

<BaseLayout
  title="404 - Page Not Found - Salvage Union System Reference Document"
  description="The page you are looking for could not be found."
  noindex
>
  <div class="flex w-full flex-1 flex-col justify-center py-12">
    <div class="mx-auto flex w-full max-w-4xl flex-col gap-8 px-6">
      <div class="text-center">
        <h1 class="text-8xl font-bold text-su-orange-dark">404</h1>
        <p class="mt-2 text-sm uppercase tracking-wider text-su-orange-dark">
          Salvage Operation Failed
        </p>
      </div>

      <p class="text-center text-sm text-su-black">
        The page you're looking for has been lost to the wastes.
        It might have been scrapped, relocated, or never existed in the first place.
      </p>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <a
          href="/"
          class="flex min-h-[54px] items-center justify-center rounded-[3px] border border-su-black bg-su-white px-4 font-cond text-lg font-bold uppercase tracking-[.02em] text-su-black no-underline transition-all hover:-translate-y-0.5 hover:shadow-[0_5px_18px_rgba(34,30,23,0.18)]"
        >
          Return to Home
        </a>
        {schemas.map((schema) => {
          const label = getCatalogLabel(schema.id)
          return (
            <a
              href={`/schema/${schema.id}/`}
              class="catalog-item"
              style={`--catalog-bg: ${getCatalogBg(schema.id)}${label ? `; --catalog-label: ${label}` : ''}`}
            >
              {label ? (
                <span class="catalog-item__name catalog-item-label">{schema.displayName}</span>
              ) : (
                <span class="catalog-item__name">{schema.displayName}</span>
              )}
            </a>
          )
        })}
      </div>
    </div>
  </div>
</BaseLayout>
