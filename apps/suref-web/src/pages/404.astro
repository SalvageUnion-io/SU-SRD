---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getSchemaCatalog } from 'salvageunion-reference'
import { getCatalogBg, isHollowCatalog } from '../lib/catalogColors'

const catalog = getSchemaCatalog()
const schemas = catalog.schemas.filter((s) => !s.meta).slice(0, 6)
---

<BaseLayout
  title="404 - Page Not Found - Salvage Union System Reference Document"
  description="The page you are looking for could not be found."
  noindex
>
  <div class="flex w-full flex-1 flex-col justify-center py-12">
    <div class="mx-auto flex w-full max-w-4xl flex-col gap-8 px-6">
      <div class="text-center">
        <p class="text-8xl font-bold text-su-orange-dark">404</p>
        <p class="mt-2 text-sm uppercase tracking-wider text-su-orange-dark">
          Salvage Operation Failed
        </p>
      </div>

      <p class="text-center text-sm text-su-black">
        The page you're looking for has been lost to the wastes.
        It might have been scrapped, relocated, or never existed in the first place.
      </p>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <a
          href="/"
          class="btn btn-inactive text-center"
        >
          Return to Home
        </a>
        {schemas.map((schema) => (
          <a
            href={`/schema/${schema.id}`}
            class:list={['btn text-center', isHollowCatalog(schema.id) ? 'catalog-item-hollow' : 'catalog-item']}
            style={`--catalog-bg: ${getCatalogBg(schema.id)}`}
          >
            {schema.displayName}
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
