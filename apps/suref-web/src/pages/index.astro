---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getSchemaCatalog, SalvageUnionReference, getReferenceEntityData } from 'salvageunion-reference'
import type { SURefGuide } from 'salvageunion-reference'
import { getCatalogBg, getCatalogLabel } from '../lib/catalogColors'

const catalog = getSchemaCatalog()
const schemas = catalog.schemas.filter((s) => !s.meta)
const schemaMap = new Map(schemas.map((s) => [s.id, s]))
const catalogCategories = SalvageUnionReference.CatalogCategories.all()

const invariantNouns = new Set(['Chassis', 'Equipment', 'Meld'])

function pluralize(name: string, count: number) {
  if (count <= 1 || invariantNouns.has(name)) return name
  const spaceIdx = name.lastIndexOf(' ')
  if (spaceIdx >= 0) {
    return name.slice(0, spaceIdx + 1) + pluralizeWord(name.slice(spaceIdx + 1))
  }
  return pluralizeWord(name)
}

function pluralizeWord(word: string) {
  if (/[^aeiou]y$/i.test(word)) return word.slice(0, -1) + 'ies'
  if (/(?:s|sh|ch|x|z)$/i.test(word)) return word + 'es'
  return word + 's'
}

type CatalogCard = {
  id: string
  href: string
  label: string
  catalogBg: string
  catalogLabel?: string
}

type CatalogSection = {
  label: string
  cards: CatalogCard[]
}

const categories: CatalogSection[] = catalogCategories.map((cat) => {
  if (cat.flat) {
    const schemaName = cat.schemas[0]!
    const items = SalvageUnionReference.findAllIn(schemaName, () => true)
    return {
      label: cat.name.toUpperCase(),
      cards: items.map((item) => {
        const display = getReferenceEntityData(item)
        return {
          id: item.id,
          href: `/schema/${schemaName}/item/${display.slug}`,
          label: item.name,
          catalogBg: (item as SURefGuide).guideColor || getCatalogBg(schemaName),
        }
      }),
    }
  }
  return {
    label: cat.name.toUpperCase(),
    cards: cat.schemas.flatMap((id) => {
      const s = schemaMap.get(id)
      if (!s) return []
      return [{
        id: s.id,
        href: `/schema/${s.id}`,
        label: pluralize(s.displayName, s.itemCount),
        catalogBg: getCatalogBg(s.id),
        catalogLabel: getCatalogLabel(s.id),
      }]
    }),
  }
})
---

<BaseLayout
  title="Salvage Union System Reference Document"
  description="System Reference Document (SRD) for the Salvage Union TTRPG. Complete reference guide with chassis, systems, modules, abilities, and more."
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Salvage Union System Reference Document',
    url: 'https://salvageunion.io',
  }}
>
  <div class="flex w-full flex-1 flex-col justify-center py-6">
    <div class="mx-auto flex w-full max-w-4xl flex-col gap-6 px-4">
      <h1 class="sr-only">Salvage Union System Reference Document</h1>

      <!-- Schema list -->
      <div class="flex flex-col gap-6">
        {categories.map((cat) => (
          <div>
            <div class="catalog-header mb-2">
              <h2 class="bg-su-black px-1 font-mono font-bold uppercase tracking-tight text-su-white" style="line-height: 1; font-size: inherit;">
                {cat.label}
              </h2>
            </div>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {cat.cards.map((card) => (
                <a
                  href={card.href}
                  class:list={['btn text-center catalog-item']}
                  style={`--catalog-bg: ${card.catalogBg}${card.catalogLabel ? `; --catalog-label: ${card.catalogLabel}` : ''}`}
                >
                  {card.catalogLabel
                    ? <span class="catalog-item-label">{card.label}</span>
                    : card.label}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
