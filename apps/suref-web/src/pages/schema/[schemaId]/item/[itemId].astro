---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import { getItemStaticPaths } from '../../../../lib/staticPaths'
import { ReferenceEntityIsland } from '../../../../components/islands/ReferenceEntityIsland'
import { getReferenceEntityData, extractStaticEntitySummary } from 'salvageunion-reference'
import StaticEntityContent from '../../../../components/StaticEntityContent.astro'
import {
  buildItemPageStructuredData,
  buildBreadcrumbList,
} from '../../../../lib/structuredData'

export function getStaticPaths() {
  return getItemStaticPaths()
}

const { item, schema, itemName, itemDescription } = Astro.props
const { schemaId, itemId } = Astro.params

const schemaName = schema.displayName || 'Item'
const canonicalUrl = `https://salvageunion.io/schema/${schemaId}/item/${itemId}/`

const displayData = item ? getReferenceEntityData(item) : null
const staticSummary = item ? extractStaticEntitySummary(item) : null

// Build meta description from first content paragraph or fallback
const firstParagraph = staticSummary?.contentParagraphs[0]
const metaDescription = firstParagraph
  ? firstParagraph.length > 155
    ? firstParagraph.slice(0, 152) + '...'
    : firstParagraph
  : itemDescription ||
    `${itemName}: ${schemaName} reference for the Salvage Union tabletop RPG.`

const itemBreadcrumbs = [
  { name: 'SRD', url: 'https://salvageunion.io/' },
  { name: schemaName, url: `https://salvageunion.io/schema/${schemaId}/` },
  { name: itemName, url: canonicalUrl },
]

const structuredData = buildItemPageStructuredData({
  itemName,
  metaDescription,
  canonicalUrl,
  schemaName,
  schemaId,
  displayData: displayData
    ? {
        techLevel: displayData.techLevel,
        source: displayData.source,
        assetUrl: displayData.assetUrl,
      }
    : null,
})

const breadcrumbStructuredData = buildBreadcrumbList(itemBreadcrumbs)

const preloadImage = displayData?.assetUrl
const ogImage = displayData?.assetUrl || '/og-image.png'
---

<BaseLayout
  title={`${itemName} - ${schemaName} - Salvage Union System Reference Document`}
  description={metaDescription}
  canonical={canonicalUrl}
  ogType="article"
  ogImage={ogImage}
  structuredData={structuredData}
  additionalStructuredData={[breadcrumbStructuredData]}
  preloadImage={preloadImage}
  breadcrumbs={itemBreadcrumbs}
>
  <article class="flex min-h-full flex-1 flex-col items-center justify-center p-4">
    <ReferenceEntityIsland client:visible item={item} titleAs="h1" />
    {staticSummary && <StaticEntityContent summary={staticSummary} />}
  </article>
</BaseLayout>
