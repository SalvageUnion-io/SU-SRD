---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getSchemaStaticPaths } from '../../../lib/staticPaths'
import { SchemaViewerIsland } from '../../../components/islands/SchemaViewerIsland'
import { getUniqueTechLevels, getUniqueSources } from 'salvageunion-reference'
import {
  buildCollectionPageStructuredData,
  buildBreadcrumbList,
} from '../../../lib/structuredData'

export function getStaticPaths() {
  return getSchemaStaticPaths()
}

const { schema, data } = Astro.props
const { schemaId } = Astro.params

const schemaName = schema.displayName || 'Schema'
const capitalizedTitle =
  schema.displayNamePlural ||
  schema.title.charAt(0).toUpperCase() + schema.title.slice(1)
const canonicalUrl = `https://salvageunion.io/schema/${schemaId}/`

// Pre-compute filter facets at build time
const techLevels = getUniqueTechLevels(data)
const sources = schemaId === 'sources' ? [] : getUniqueSources(data)

const collectionBreadcrumbs = [
  { name: 'SRD', url: 'https://salvageunion.io/' },
  { name: schemaName, url: canonicalUrl },
]

const structuredData = buildCollectionPageStructuredData({
  schemaName,
  canonicalUrl,
  itemCount: data.length,
})

const breadcrumbStructuredData = buildBreadcrumbList(collectionBreadcrumbs)
---

<BaseLayout
  title={`${schemaName} - Salvage Union System Reference Document`}
  description={`Browse all ${schemaName} in the Salvage Union SRD (System Reference Document). Complete reference with stats, abilities, and details.`}
  canonical={canonicalUrl}
  structuredData={structuredData}
  additionalStructuredData={[breadcrumbStructuredData]}
  breadcrumbs={collectionBreadcrumbs}
>
  <div class="flex min-h-full flex-col">
    <!-- Static header -->
    <div class="flex flex-0 flex-col items-center bg-su-blue-pale p-8">
      <h1
        class="mb-2 box-decoration-clone bg-su-black px-2 py-1 text-center font-mono text-3xl font-bold uppercase leading-none tracking-tight text-su-white"
        style="line-height: 1;"
      >
        {capitalizedTitle}
      </h1>
      <p class="mb-3 max-w-[800px] text-center text-su-black">
        {schema.description}
      </p>

      <!-- Island handles search + filters + grid -->
      <SchemaViewerIsland
        client:visible
        initialData={data}
        schemaId={schemaId!}
        techLevels={techLevels}
        sources={sources}
      />
    </div>
  </div>
</BaseLayout>
