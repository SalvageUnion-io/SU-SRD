{
  "name": "suref-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sanity": "bun run lint -- --fix && bun run format && bun run typecheck",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist node_modules/.vite .astro",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
  "dependencies": {
    "@astrojs/check": "0.9.6",
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.3.0",
    "@base-ui/react": "1.2.0",
    "@fontsource/barlow": "5.2.8",
    "@fontsource/barlow-semi-condensed": "5.2.7",
    "astro": "^5.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "salvageunion-reference": "workspace:*",
    "suref-react": "workspace:*"
  },
  "devDependencies": {
    "sharp": "0.34.5"
  }
}
