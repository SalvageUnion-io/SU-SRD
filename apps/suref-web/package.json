    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.0",
    "tailwindcss": "^4.1.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.4"
