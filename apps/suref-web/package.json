    "@randsum/salvageunion": "^0.37.0",
    "astro": "^5.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "salvageunion-reference": "workspace:*",
    "suref-react": "workspace:*",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "netlify-cli": "^23.12.0",
    "@eslint/js": "^9.39.1",
    "@happy-dom/global-registrator": "^20.0.10",
