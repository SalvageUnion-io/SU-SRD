  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sanity": "bun run lint -- --fix && bun run format && bun run typecheck",
    "format:check": "prettier --check .",
    "test": "echo 'No tests configured'",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist node_modules/.vite .astro",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
  "dependencies": {
    "@astrojs/check": "0.9.6",
