{
  // salvageunion.io on Workers Static Assets (ADR-033): the one Worker for
  // the whole app. The script runs only for a miss and for everything under
  // `/build` and `/play`, the app's (src/worker/index.ts, src/worker/app.ts);
  // every header on a real file is public/_headers. Built in GitHub Actions, not Workers Builds
  // (ADR-033 §4).
  "name": "su-srd",
  "main": "src/worker/index.ts",
  // At or below the workerd the wrangler devDependency bundles (deploy-cloudflare.yml).
  "compatibility_date": "2026-07-13",

  // `www` is attached so the zone's Redirect Rule can act on it; the redirect
  // cannot live in `_redirects` (ADR-033, "Configuration outside the repo").
  // intheunionnow.com, the app's old host, is attached for the same reason:
  // its zone's Redirect Rule 301s every path to salvageunion.io/build.
  "routes": [
    { "pattern": "salvageunion.io", "custom_domain": true },
    { "pattern": "www.salvageunion.io", "custom_domain": true },
    { "pattern": "intheunionnow.com", "custom_domain": true },
    { "pattern": "www.intheunionnow.com", "custom_domain": true }
  ],
  // Explicit: `routes` turns workers.dev off otherwise, and the smoke list
  // probes su-srd there to tell a broken route from a broken deploy
  // (tools/smoke-production.sh).
  "workers_dev": true,

  // Secrets, set with
  // `wrangler secret put`, all OPTIONAL and so not listed in a
  // `secrets.required` block:
  //
  // - CF_ACCOUNT_ID and BROWSER_RENDERING_TOKEN (a token with Browser
  //   Rendering edit permission). With both, a shared thing's link preview
  //   carries its rendered card (apps/web/src/worker/linkPreview.ts);
  //   without them it unfurls as text.
  // - CONVEX_LOG_STREAM_SECRET, the production Convex log stream's webhook
  //   secret. Without it POST /__convex-logs answers 503.
  // - DISCORD_CLIENT_ID and DISCORD_CLIENT_SECRET, the Discord application's
  //   OAuth client (its redirect: <origin>/auth/callback), and
  //   AUTH_SIGNING_KEY, the private half of `bun scripts/authKeys.ts`, whose
  //   public half is the Convex deployment's AUTH_JWKS. Without them
  //   /auth/sign-in answers 503 and nobody signs in (src/worker/auth/).
  //   TEST_AUTH=true belongs only in a test build's `.dev.vars`.

  // CONVEX_URL: the Convex deployment a link preview reads what a stranger
  // may see from until SHARED is filled: the URL the app is built against,
  // `PRODUCTION_CONVEX_URL` in deploy-cloudflare.yml.
  "vars": {
    "CONVEX_URL": "https://exuberant-porpoise-183.convex.cloud"
  },

  // SHARED: the shared database (D1), what crosses rooms: public sheets,
  // Homebrew, Games, memberships and invites (src/worker/shared/). Its tables
  // are migrations/*.sql, applied by the deploy before the Worker ships;
  // sign-in's accounts and sessions make theirs on first use
  // (src/worker/auth/store.ts). No `database_id`: wrangler provisions it by
  // name on the first deploy.
  "d1_databases": [{ "binding": "SHARED", "database_name": "su-shared" }],

  // A Worker Preview (deploy-preview.yml) inherits none of the vars and
  // bindings above: the staging deployment the app is built against, and its
  // own shared database, so a Preview never reads or writes production's.
  // Its error endpoints run without the rate limits, which the Worker allows.
  "previews": {
    "vars": {
      "CONVEX_URL": "https://perfect-donkey-72.convex.cloud"
    },
    "d1_databases": [{ "binding": "SHARED", "database_name": "su-shared-preview" }]
  },

  // ERROR_REPORT_LIMIT caps browser error reports (POST /__errors) per
  // address. OG_RENDER_LIMIT caps fresh link-preview
  // renders (Browser Rendering time) per Cloudflare location.
  // `namespace_id` is any integer unique on the account.
  "ratelimits": [
    {
      "name": "ERROR_REPORT_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    { "name": "OG_RENDER_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A miss runs the Worker, which answers dist/404.html (or a bare 404 under
    // `/assets/`) with `no-store`. Not `404-page`: Static Assets applies
    // `_headers` to that response by path, so a missing chunk's 404 took the
    // `/assets/*` rule's year of `immutable`. Not SPA mode either: the reference site is
    // pre-rendered, so a miss is genuinely a miss.
    "not_found_handling": "none",
    // `/build`, `/play` and below: the app, whose Worker reads every answer
    // (src/worker/app.ts, `RUN_WORKER_FIRST`, which the routing test holds
    // equal). A positive list only: a negative pattern sends its matches
    // straight to the assets, and `true` would run the script for every SRD
    // page.
    "run_worker_first": ["/build", "/build/*", "/play", "/play/*"]
  },

  // Traces: a span per binding call and outbound fetch (Convex, R2, Images,
  // Browser Rendering), in the dashboard next to the logs. Issues is the error
  // tracker: it groups uncaught exceptions, 5xx answers and `console.error`
  // (`reportError`, `src/worker/errorReports.ts`) into issues, alerted on by the
  // dashboard's Issues automations. tools/check-observability.ts requires all three.
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
    "issues": { "enabled": true }
  },

  // Issues' stacks point at the source, not the bundle.
  "upload_source_maps": true,

  // `bun run preview` (`wrangler dev`) serves the built `dist/` exactly as
  // above on the dev server's port: the e2e suite's CI server, and the one
  // `scripts/og-screenshots.ts` renders through.
  "dev": { "port": 4321 }
}
