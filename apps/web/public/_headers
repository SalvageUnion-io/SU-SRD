# Response headers for salvageunion.io.
#
# Copied verbatim into `dist/` by Vite's publicDir, and read by Workers Static
# Assets (ADR-033) for every file it serves. The Worker answers only misses
# and `/build` (src/worker/index.ts), and every page it answers comes back
# through the asset binding, so this file is the ONLY source of security headers.
#
# `tools/check-observability.ts` requires the CSP here to allow 'self', where the
# browser posts its error reports (`/__errors`, src/worker/index.ts);
# tools/smoke-production.sh asserts the CSP and HSTS actually reach the browser.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-DNS-Prefetch-Control: on
  # connect-src MUST keep 'self', or the browser blocks every error report
  # before it leaves the page — silent, and it looks healthy (zero errors).
  # script-src carries NO 'unsafe-inline' and NO hashes. With 'unsafe-inline',
  # an injected <script> executes and CSP's primary XSS control is gone. The reference site
  # emits no executable inline script at all — the /about and /greembeem
  # scripts load by URL from public/ — so this list is literal and cannot
  # drift. An inline <script> added later is BLOCKED by this policy: load it
  # by URL.
  #
  # 'inline-speculation-rules' covers <script type="speculationrules">, which is
  # gated by script-src but cannot be hashed. Browsers that don't know the
  # keyword ignore it, and those are the ones with no speculation rules anyway.
  #
  # JSON-LD and the island props are type="application/ld+json" and
  # type="application/json" — DATA BLOCKS, which the browser never executes and
  # script-src does not gate. They need no hash.
  #
  # 'unsafe-inline' stays in style-src deliberately: React's inline `style=`
  # attributes need it, and style injection is not script execution.
  #
  # Cloudflare Web Analytics: the zone's automatic setup injects
  # its beacon into every HTML page at the edge (the page source carries none),
  # loaded from static.cloudflareinsights.com and posting page loads to
  # cloudflareinsights.com; drop either origin and the dashboard silently
  # records nothing.
  #
  # The Convex origins are the app's accounts client and live queries
  # (ADR-030), under `/build`: one policy for the one app.
  Content-Security-Policy: default-src 'self'; script-src 'inline-speculation-rules' 'self' https://storage.ko-fi.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://*.convex.cloud wss://*.convex.cloud https://*.convex.site;

# The production Worker's own workers.dev address serves the same pages as
# salvageunion.io (it stays on for the smoke check). Its canonicals already name
# salvageunion.io; noindex keeps the duplicate out of search outright. PR
# Previews on workers.dev get the same header from Cloudflare automatically.
https://su-srd.alxjrvs.workers.dev/*
  X-Robots-Tag: noindex

# Content-hashed bundle output (`vite.config.ts` uses Vite's default
# assetsDir). If it ever sets a different build.assetsDir, change this with it,
# and the Worker's `/assets/` prefix too. A MISS here never sees this rule: the
# Worker answers it with `no-store` (src/worker/index.ts).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# `/assets/*` is the ONLY content-hashed path the reference site emits — every image an
# import references (eldridge-coast-map) lands there with a hash in its name.
# Every other image is a FIXED name replaced in place when it changes: the
# og:image and manifest icons, the favicons, the header logos, and the
# per-entity `*.og.png` unfurls that `og:generate` rewrites whenever the card
# rendering changes. Marking them `immutable` would mean a changed icon never
# reaches a returning visitor; the app's `_headers` makes the same call.
#
# One hour, then a day of stale-while-revalidate: a change arrives within the
# hour, and nobody waits on a revalidation to see an icon.
#
# Listed by path, NOT as `/*.png`. Cloudflare applies EVERY matching rule and
# joins a repeated header with a comma, and a root splat also matches
# `/assets/` — measured on production while `/*.webp` was immutable:
#   cache-control: public, max-age=31536000, immutable, public, max-age=31536000, immutable
# Harmless while both halves agreed, contradictory once they don't. An image
# this list misses gets the platform default, `max-age=0, must-revalidate`:
# always fresh, never stuck. `ssg/__tests__/headers.test.ts` holds all of this.
/og-image.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/web-app-manifest-*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/Powered_by_Salvage_Black.webp
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/favicons/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/logos/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The unfurls sit beside their pages (`/chassis/mule.og.png`), one per schema
# directory, so this one rule is a root splat on the `.og.png` suffix. Nothing
# under `/assets/` carries that suffix: a hashed name ends in its hash.
/*.og.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# HTML is the one thing that must never be cached: a deploy rotates the hashed
# chunk names, and a stale document names chunks that no longer exist.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# The JSON endpoints are a public, CORS-readable API surface (899 of them).
#
# `Cache-Control` is NOT inherited from anywhere. Without a rule here Workers
# Static Assets serves the default `max-age=0, must-revalidate`, so every
# consumer of this API revalidated on every request for data that only changes
# on deploy. Measured against production before this:
#
#   $ curl -sSI https://salvageunion.io/schema/chassis.json
#   cache-control: public, max-age=0, must-revalidate
#
# One hour rather than a year, and NOT `immutable`: unlike `/assets/*` these
# URLs are stable across deploys, so the content behind them really does change
# when the dataset does. An immutable year would pin a stale copy of the game
# data into every consumer's cache until the URL changed, which it never does.
#
# `stale-while-revalidate` on top means a consumer past the hour is served
# immediately from cache while the refresh happens behind it — the freshness of
# a short max-age with the latency of a long one.
/schema/*.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET
  Content-Type: application/json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/schema/*/item/*.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET
  Content-Type: application/json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The remaining generated, deploy-stable files — every one of which matched NO
# rule above and therefore inherited the same `max-age=0, must-revalidate` the
# `/schema/*.json` block was added to fix.
#
# The costly one is the search index: 493 KB, fetched by the search island on
# first interaction, and revalidated on every single page view. It is generated
# per deploy from the same dataset as the JSON endpoints, so it gets the same
# reasoning and the same numbers — one hour, not immutable, because the URL is
# stable across deploys and the content behind it changes when the dataset does.
#
# The rest are small but equally uncovered: llms.txt, both sitemaps, robots.txt,
# the webmanifest and the favicon.
/search-index.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/llms.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/robots.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.webmanifest
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
