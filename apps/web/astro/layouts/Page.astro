---
/**
 * The one document shell: a page module's head and body, around the
 * stylesheets and the island runtime Astro bundles.
 */
import '../../src/styles/base.css'
import '../../src/styles/global.css'
import type { ReferenceDocument } from '../lib/reference'

type Props = { doc: ReferenceDocument }
const { doc } = Astro.props
---
<html lang="en">
  <head><Fragment set:html={doc.head} /></head>
  <body><Fragment set:html={doc.body} /><script>import '../../src/runtime/islands.client'</script></body>
</html>
