---
import { FRONT_DOOR_SCRIPT } from '../../../src/build/roster/frontDoorData'
/**
 * The app's shell, `build/index.html` (ADR-050): the one document the Worker
 * serves for every `/build/*` and `/play/*` navigation. Astro bundles the
 * app's entry into it, after React's Fast Refresh preamble (empty in a build).
 * Its root holds the front door's markup (`../../build/frontDoor`), which the
 * head script shows when the document opens on the front door.
 */
import { appShell } from '../../build/appShell'
import { frontDoorMarkup } from '../../build/frontDoor'
import Fonts from '../../components/Fonts.astro'

const { head, body } = appShell(import.meta.env.VITE_SITE_ORIGIN, await frontDoorMarkup())
---
<html lang="en">
  <head><Fragment set:html={head} /><script is:inline set:html={FRONT_DOOR_SCRIPT} /><Fonts /></head>
  <body><Fragment set:html={body} /><script>
    import '@vitejs/plugin-react/preamble'
    import '../../../src/main'
  </script></body>
</html>
