---
/**
 * The Discord Activity, built as `activity.html`: the page Discord frames
 * when a player starts SalvageUnion.io from the App Launcher. The portal's
 * root URL Mapping points at `/activity`; `su-activity` takes off the site's
 * desk so it fills the frame; `public/_headers` lets Discord frame it and
 * nothing else. Its script is `src/activity/main.tsx`.
 */

import Fonts from '../../components/Fonts.astro'
import { BASE_STYLESHEET } from '../../lib/assets'
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>SalvageUnion.io</title>
    <link rel="stylesheet" href={BASE_STYLESHEET.href} />
    <Fonts />
  </head>
  <body class="su-activity">
    <div id="activity"></div>
    <script>
      import '../../../src/activity/main'
    </script>
  </body>
</html>
