{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node", "bun-types", "@testing-library/jest-dom"]
  },
  // `e2e/**/*` and the Playwright configs: Playwright transpiles specs
  // without type-checking them, and biome.jsonc
  // disables the linter for both paths, so this include is their only check
  // beyond the formatter.
  "include": ["src/**/*", "astro/**/*", "scripts/**/*", "test/**/*", "e2e/**/*", "*.config.ts"],
  // `include` is explicit, but a stale build output must never be typechecked.
  "exclude": ["dist"]
}
