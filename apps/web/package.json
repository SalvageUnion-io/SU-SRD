{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "scripts": {
    "dev": "ref-generate && bun scripts/assert-local-convex.ts && VITE_TEST_AUTH=true convex dev --start 'bun ssg/dev.ts'",
    "typecheck": "tsc -b",
    "build": "bun ssg/build.ts",
    "og:generate": "bun ssg/build.ts && OG_SCREENSHOTS=1 bun scripts/og-screenshots.ts",
    "brand": "bun scripts/brand/build.ts",
    "brand:discord": "bun scripts/brand/build.ts --upload-discord",
    "og:install-browser": "playwright install chromium --only-shell",
    "preview": "wrangler dev",
    "test": "bun test --parallel=4 --no-isolate",
    "e2e": "playwright test",
    "check:examples": "bun ssg/checkPageExamples.ts",
    "deploy": "wrangler deploy",
    "worker:bundle": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@base-ui/react": "catalog:",
    "@convex-dev/auth": "0.0.95",
    "@fontsource/barlow": "catalog:",
    "@fontsource/barlow-semi-condensed": "catalog:",
    "@fontsource/caveat": "catalog:",
    "@randsum/roller": "catalog:",
    "@randsum/salvageunion": "catalog:",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/router-plugin": "1.168.34",
    "cantina-domain": "workspace:*",
    "clsx": "2.1.1",
    "convex": "catalog:",
    "convex-helpers": "0.1.124",
    "lucide-react": "catalog:",
    "qrcode": "1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "salvageunion-reference": "workspace:*",
    "sonner": "2.0.8",
    "workbox-window": "7.4.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.6",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-react-swc": "4.3.3",
    "convex-test": "0.0.56",
    "gates": "workspace:*",
    "sharp": "catalog:",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0"
  }
}
