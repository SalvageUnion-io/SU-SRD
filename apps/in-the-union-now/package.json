  "scripts": {
    "dev": "vite dev",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc --noEmit",
    "build:analyze": "vite build --mode analyze",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sanity": "bun run lint -- --fix && bun run format && bun run typecheck",
    "format:check": "prettier --check .",
    "gen:types": "bunx supabase gen types typescript --project-id dshtuchbleipwqacyokz --schema public > src/types/database-generated.types.ts",
    "gen:zod": "bunx supazod --input src/types/database-generated.types.ts --output src/types/database-generated.zod.ts",
    "gen:all": "bun run gen:types && bun run gen:zod",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "ladle": "ladle serve",
    "clean": "rm -rf dist .vite node_modules/.vite build-ladle",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
