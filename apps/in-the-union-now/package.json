{
  "name": "in-the-union-now",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "lint": "biome lint .",
    "format": "biome format --write . && prettier --write '**/*.md' --ignore-unknown --log-level=warn",
    "format:check": "biome format . && prettier --check '**/*.md' --ignore-unknown --log-level=warn",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist .vite node_modules/.vite"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource/barlow": "5.2.8",
    "@fontsource/barlow-semi-condensed": "5.2.7",
    "@netlify/blobs": "^10.7.9",
    "@randsum/roller": "^4.0.0",
    "@sentry/browser": "10.65.0",
    "@sentry/node": "10.65.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/router-plugin": "^1.168.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "8.0.3",
    "lucide-react": "^1.25.0",
    "qrcode": "1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "salvageunion-reference": "workspace:*",
    "suref-react": "workspace:*",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sentry/vite-plugin": "5.4.0",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "6.2.5",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "1.3.0"
  }
}
