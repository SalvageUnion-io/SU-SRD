{
  // ITUN at salvageunion.io/build (ADR-048) — the SPA on Workers Static Assets
  // (ADR-033). The script runs for every request outside `/build/` (the old
  // host's 301s) and, under it, only for a miss that is not a navigation
  // (src/worker/index.ts); every header is public/_headers, which the build
  // moves to `dist/_headers` (vite.config.ts).
  "name": "su-itun",

  // A Workers ROUTE, not a Custom Domain: a route runs before su-srd's Custom
  // Domain on the same hostname, so `/build*` never reaches srd. Publishing it
  // needs the deploy token's Zone → Workers Routes: Edit on salvageunion.io,
  // which deploy-cloudflare.yml checks before anything ships.
  //
  // intheunionnow.com and its `www` stay attached, where ITUN lived until
  // ADR-048: the Worker 301s them to the same page here (legacyHost.ts). `www`
  // also keeps the zone's Redirect Rule acting on it (ADR-033, "Configuration
  // outside the repo").
  "routes": [
    { "pattern": "salvageunion.io/build*", "zone_name": "salvageunion.io" },
    { "pattern": "intheunionnow.com", "custom_domain": true },
    { "pattern": "www.intheunionnow.com", "custom_domain": true }
  ],
  "workers_dev": false,
  // Version URLs (`<version|alias>-su-itun.alxjrvs.workers.dev`), for the
  // preview slot (.github/workflows/deploy-preview.yml). Separate from
  // `workers_dev`: su-itun.alxjrvs.workers.dev stays off. Unset, they follow
  // `workers_dev` and are off. Applied by `wrangler deploy`, not by
  // `versions upload`.
  "preview_urls": true,
  "main": "src/worker/index.ts",
  // At or below the workerd the wrangler devDependency bundles (deploy-cloudflare.yml).
  "compatibility_date": "2026-07-13",
  // AsyncLocalStorage for @sentry/cloudflare; tools/check-observability.ts requires it.
  "compatibility_flags": ["nodejs_als"],

  // A deploy fails while one is unset; set with `wrangler secret put`.
  //
  // Two more are OPTIONAL and so not listed: CF_ACCOUNT_ID and
  // BROWSER_RENDERING_TOKEN (a token with Browser Rendering edit permission).
  // With both, a shared thing's link preview carries its rendered card
  // (src/worker/linkPreview.ts, issue 1280); without them it unfurls as text.
  "secrets": {
    "required": ["SENTRY_DSN"]
  },

  // CONVEX_URL: the Convex deployment a link preview reads what a stranger
  // may see from (`publicSheet.preview`, issue 1280): the URL the SPA is built
  // against, `ITUN_CONVEX_URL` in deploy-cloudflare.yml. BASE_PATH: the base
  // the SPA is built under, `SITE.base` (src/lib/site.ts). The routing test
  // holds both equal.
  "vars": {
    "CONVEX_URL": "https://exuberant-porpoise-183.convex.cloud",
    "BASE_PATH": "/build"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A navigation miss gets index.html without running the Worker; any other
    // miss runs it, which keeps a rotated chunk a 404 (#759).
    "not_found_handling": "single-page-application",
    // Every path but the base's (RUN_WORKER_FIRST in src/worker/legacyHost.ts,
    // which the routing test holds this list equal to): the old host's 301s and
    // ITUN's root. Every navigation under `/build/` stays asset-first, so it
    // keeps `_headers` and the CSP.
    "run_worker_first": ["/*", "!/build/*"]
  },

  "observability": {
    "enabled": true
  },

  // `bun run preview` (`wrangler dev`) serves the built `dist/` through this
  // Worker on the dev server's port: the e2e suite's CI server.
  "dev": { "port": 5173 }
}
