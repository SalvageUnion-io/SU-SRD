{
  // intheunionnow.com — the ITUN SPA on Workers Static Assets (ADR-033). The
  // script runs only for a miss that is not a navigation (src/worker/index.ts);
  // every header is public/_headers.
  "name": "su-itun",

  // `www` is attached so the zone's Redirect Rule can act on it (ADR-033,
  // "Configuration outside the repo").
  "routes": [
    { "pattern": "intheunionnow.com", "custom_domain": true },
    { "pattern": "www.intheunionnow.com", "custom_domain": true }
  ],
  // The smoke list probes the custom domains only (tools/smoke-production.sh).
  "workers_dev": false,
  "main": "src/worker/index.ts",
  // At or below the workerd the wrangler devDependency bundles (deploy-cloudflare.yml).
  "compatibility_date": "2026-07-13",
  // AsyncLocalStorage for @sentry/cloudflare; tools/check-observability.ts requires it.
  "compatibility_flags": ["nodejs_als"],

  // A deploy fails while one is unset; set with `wrangler secret put`.
  //
  // Two more are OPTIONAL and so not listed: CF_ACCOUNT_ID and
  // BROWSER_RENDERING_TOKEN (a token with Browser Rendering edit permission).
  // With both, a shared thing's link preview carries its rendered card
  // (src/worker/linkPreview.ts, issue 1280); without them it unfurls as text.
  "secrets": {
    "required": ["SENTRY_DSN"]
  },

  // The Convex deployment a link preview reads what a stranger may see from
  // (`publicSheet.preview`, issue 1280): the URL the SPA is built against,
  // `ITUN_CONVEX_URL` in deploy-cloudflare.yml (the routing test holds them equal).
  "vars": {
    "CONVEX_URL": "https://exuberant-porpoise-183.convex.cloud"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A navigation miss gets index.html without running the Worker; any other
    // miss runs it, which keeps a rotated chunk a 404 (#759).
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  },

  // `bun run preview` (`wrangler dev`) serves the built `dist/` through this
  // Worker on the dev server's port: the e2e suite's CI server.
  "dev": { "port": 5173 }
}
