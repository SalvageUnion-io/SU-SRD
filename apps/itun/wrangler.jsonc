{
  // intheunionnow.com — the ITUN SPA on Workers Static Assets (ADR-033). The
  // script runs only for a miss that is not a navigation, and for the retired
  // addresses below (src/worker/index.ts); every header is public/_headers.
  "name": "su-itun",

  // `www` is attached so the zone's Redirect Rule can act on it (ADR-033,
  // "Configuration outside the repo").
  "routes": [
    { "pattern": "intheunionnow.com", "custom_domain": true },
    { "pattern": "www.intheunionnow.com", "custom_domain": true }
  ],
  // The smoke list probes the custom domains only (tools/smoke-production.sh).
  "workers_dev": false,
  // Version URLs (`<version|alias>-su-itun.alxjrvs.workers.dev`), for the
  // preview slot (.github/workflows/deploy-preview.yml). Separate from
  // `workers_dev`: su-itun.alxjrvs.workers.dev stays off. Unset, they follow
  // `workers_dev` and are off. Applied by `wrangler deploy`, not by
  // `versions upload`.
  "preview_urls": true,
  "main": "src/worker/index.ts",
  // At or below the workerd the wrangler devDependency bundles (deploy-cloudflare.yml).
  "compatibility_date": "2026-07-13",
  // AsyncLocalStorage for @sentry/cloudflare; tools/check-observability.ts requires it.
  "compatibility_flags": ["nodejs_als"],

  // A deploy fails while one is unset; set with `wrangler secret put`.
  //
  // Two more are OPTIONAL and so not listed: CF_ACCOUNT_ID and
  // BROWSER_RENDERING_TOKEN (a token with Browser Rendering edit permission).
  // With both, a shared thing's link preview carries its rendered card
  // (src/worker/linkPreview.ts, issue 1280); without them it unfurls as text.
  "secrets": {
    "required": ["SENTRY_DSN"]
  },

  // The Convex deployment a link preview reads what a stranger may see from
  // (`publicSheet.preview`, issue 1280): the URL the SPA is built against,
  // `ITUN_CONVEX_URL` in deploy-cloudflare.yml (the routing test holds them equal).
  "vars": {
    "CONVEX_URL": "https://exuberant-porpoise-183.convex.cloud"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A navigation miss gets index.html without running the Worker; any other
    // miss runs it, which keeps a rotated chunk a 404 (#759).
    "not_found_handling": "single-page-application",
    // The retired addresses old Discord links still use, and nothing else: the
    // Worker answers them with a 301 (src/worker/retiredRedirects.ts, which the
    // routing test holds this list equal to). Every other navigation stays
    // asset-first, so it keeps `_headers` and the CSP.
    "run_worker_first": ["/games", "/games/", "/games/*/view/*", "/join/*"]
  },

  "observability": {
    "enabled": true
  },

  // `bun run preview` (`wrangler dev`) serves the built `dist/` through this
  // Worker on the dev server's port: the e2e suite's CI server.
  "dev": { "port": 5173 },

  // Refit S2 spike (docs/spikes/s2-one-product.md): ITUN at
  // salvageunion.io/build. NOTHING DEPLOYS THIS until the owner flips S2: the
  // deploy runs plain `wrangler deploy`, which ignores `env`. Flipped, the
  // deploy builds with `ITUN_SITE=one-domain` (src/lib/site.ts) and runs
  // `wrangler deploy --env one-domain`. `name` is set so it updates su-itun
  // itself rather than creating `su-itun-one-domain`.
  "env": {
    "one-domain": {
      "name": "su-itun",
      // A Workers route, not a Custom Domain: a route runs before the su-srd
      // Custom Domain on the same hostname, so `/build*` never reaches srd.
      // The intheunionnow.com domains stay attached so their DNS records stay
      // proxied for the zone's Redirect Rule (salvageunion.io/build/*), which
      // answers before any Worker.
      "routes": [
        { "pattern": "salvageunion.io/build*", "zone_name": "salvageunion.io" },
        { "pattern": "intheunionnow.com", "custom_domain": true },
        { "pattern": "www.intheunionnow.com", "custom_domain": true }
      ],
      // `vars` is not inherited: CONVEX_URL restated (the routing test holds
      // the two equal), plus the base the Worker strips and puts back.
      "vars": {
        "CONVEX_URL": "https://exuberant-porpoise-183.convex.cloud",
        "BASE_PATH": "/build"
      },
      // `patternsUnder('/build')` (src/worker/retiredRedirects.ts).
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/build/games",
          "/build/games/",
          "/build/games/*/view/*",
          "/build/join/*"
        ]
      }
    }
  }
}
