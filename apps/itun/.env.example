# Convex — the server of record for accounts, Games, and entity ownership.
# These are written automatically by `bunx convex dev` into .env.local
# (gitignored). Listed here so a new contributor knows what the app expects.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Discord OAuth (the only sign-in provider).
# These are NOT read from this file — they live on the Convex deployment:
#   bunx convex env set AUTH_DISCORD_ID <client-id>
#   bunx convex env set AUTH_DISCORD_SECRET <client-secret>
# The Discord application's redirect URI must be:
#   <VITE_CONVEX_SITE_URL>/api/auth/callback/discord
