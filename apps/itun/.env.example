# Convex — the server of record for accounts, Games, and entity ownership.
# `bun run dev:itun` (`convex dev`) writes these into .env.local (gitignored)
# for the local deployment; see "Local backend" in .claude/skills/convex-ops/SKILL.md.
# Listed here so a new contributor knows what the app expects.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Local sign-in is the test seam: the `dev` script sets VITE_TEST_AUTH=true and
# the local deployment carries ITUN_TEST_AUTH=true. Never set either here.
#
# Discord OAuth is production's only sign-in provider. Its variables are NOT
# read from this file — they live on the production deployment
# (docs/ARCHITECTURE.md#accounts-and-games-operations).
