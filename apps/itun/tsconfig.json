{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node", "bun-types", "@testing-library/jest-dom"],

    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx"
  },
  // `convex/**/*` is the Convex backend — auth, ownership, games, invites,
  // proposals, schema and the bot HTTP seam, i.e. the server of record for
  // accounts (ADR-030). This include is the only thing that type-checks it
  // (`bun run typecheck`, CI, pre-push); knip and Biome claim the directory for
  // this workspace too, but neither checks types.
  //
  // `e2e/**/*` and `playwright.config.ts` are the same hole one layer out:
  // Playwright transpiles specs without type-checking them. They are included
  // here (not in a separate project) because they import from `src/`.
  "include": [
    "src/**/*",
    "test/**/*",
    "convex/**/*",
    "e2e/**/*",
    "scripts/**/*",
    "vite.config.ts",
    "routeTree.config.ts",
    "playwright.config.ts"
  ]
}
