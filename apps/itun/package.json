{
  "name": "itun",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist .vite node_modules/.vite"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@base-ui/react": "1.6.0",
    "@convex-dev/auth": "0.0.94",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@netlify/blobs": "^10.7.10",
    "@randsum/roller": "^4.0.0",
    "@sentry/browser": "10.68.0",
    "@sentry/node": "10.68.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/router-plugin": "^1.168.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "component-lib": "workspace:*",
    "convex": "1.43.0",
    "idb": "8.0.3",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "salvageunion-reference": "workspace:*",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@sentry/vite-plugin": "5.4.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "convex-test": "0.0.55",
    "fake-indexeddb": "6.2.5",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "1.3.0"
  }
}
