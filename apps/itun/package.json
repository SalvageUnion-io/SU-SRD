{
  "name": "itun",
  "private": true,
  "version": "1.17.8",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist .vite node_modules/.vite",
    "deploy": "wrangler deploy",
    "worker:bundle": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.95",
    "@fontsource/barlow": "catalog:",
    "@fontsource/barlow-semi-condensed": "catalog:",
    "@randsum/roller": "catalog:",
    "@resvg/resvg-wasm": "^2.6.0",
    "@sentry/browser": "catalog:",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/router-plugin": "^1.168.34",
    "component-lib": "workspace:*",
    "convex": "1.45.0",
    "convex-helpers": "0.1.124",
    "idb": "8.0.3",
    "lucide-react": "catalog:",
    "observability": "workspace:*",
    "qrcode": "1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "salvageunion-reference": "workspace:*",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-react-swc": "catalog:",
    "convex-test": "0.0.56",
    "fake-indexeddb": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "1.3.0",
    "wrangler": "catalog:"
  }
}
