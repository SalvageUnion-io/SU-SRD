{
  // assets.salvageunion.io — entity artwork from R2 (ADR-033). The Worker
  // answers every path, robots.txt included; see src/worker.ts.
  "name": "su-assets",
  "routes": [{ "pattern": "assets.salvageunion.io", "custom_domain": true }],
  // The smoke list probes the custom domain only (tools/smoke-production.sh).
  "workers_dev": false,
  "main": "src/worker.ts",

  // At or below the workerd the wrangler devDependency bundles (deploy-cloudflare.yml).
  "compatibility_date": "2026-07-13",
  // AsyncLocalStorage for @sentry/cloudflare; tools/check-observability.ts requires it.
  "compatibility_flags": ["nodejs_als"],

  // Workers Caching: a repeat request is answered from the edge without running
  // the Worker, keyed on the `Cache-Control` each response sets (src/worker.ts).
  "cache": {
    "enabled": true
  },

  // A deploy fails while one is unset; set with `wrangler secret put`.
  "secrets": {
    "required": ["SENTRY_DSN"]
  },

  // Renders the -440/-880 derivatives. Needs Images Transformations on the zone
  // (ADR-033, "Configuration outside the repo").
  "images": {
    "binding": "IMAGES"
  },

  "r2_buckets": [
    {
      "binding": "LP_ASSETS",
      "bucket_name": "su-lp-assets"
    }
  ],

  "observability": {
    "enabled": true
  }
}
