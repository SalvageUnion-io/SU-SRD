{
  // assets.salvageunion.io — entity artwork from R2 (ADR-033). The Worker
  // answers every path, robots.txt included; see src/worker/index.ts.
  "name": "su-assets",
  "routes": [{ "pattern": "assets.salvageunion.io", "custom_domain": true }],
  // The smoke list probes the custom domain only (tools/smoke-production.sh).
  "workers_dev": false,
  "main": "src/worker/index.ts",

  // At or below the workerd the wrangler devDependency bundles (deploy-cloudflare.yml).
  "compatibility_date": "2026-07-13",

  // Workers Caching: a repeat request is answered from the edge without running
  // the Worker, keyed on the `Cache-Control` each response sets (src/worker/index.ts).
  "cache": {
    "enabled": true
  },

  // Renders the -440/-880 derivatives. Needs Images Transformations on the zone
  // (ADR-033, "Configuration outside the repo").
  "images": {
    "binding": "IMAGES"
  },

  "r2_buckets": [
    {
      "binding": "LP_ASSETS",
      "bucket_name": "su-lp-assets"
    }
  ],

  // Traces: a span per binding call and outbound fetch (Convex, R2, Images,
  // Browser Rendering), in the dashboard next to the logs. Issues is the error
  // tracker: it groups uncaught exceptions, 5xx answers and `console.error`
  // (`reportError`, `src/worker/reportError.ts`) into issues, alerted on by the
  // dashboard's Issues automations. tools/check-observability.ts requires all three.
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
    "issues": { "enabled": true }
  },

  // Issues' stacks point at the source, not the bundle.
  "upload_source_maps": true
}
