{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "The only dependency updater. See docs/architecture/dependency-management.md.",
  "extends": ["config:recommended", ":semanticCommits", ":semanticCommitTypeAll(chore)"],
  "enabledManagers": ["bun", "github-actions", "bun-version", "custom.regex"],
  "schedule": ["* 0-3 * * 1"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "bump",
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "bunfig.toml refuses installs under 3 days old, so a younger fix cannot regenerate bun.lock. The default update-lockfile strategy would leave a caret range, and so bun.lock, unchanged.",
    "minimumReleaseAge": "3 days",
    "rangeStrategy": "bump",
    "labels": ["dependencies", "security"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": ".mcp.json pins the Convex CLI that apps/itun/package.json pins; tools/__tests__/mcp-config.test.ts fails if they differ.",
      "managerFilePatterns": ["/^\\.mcp\\.json$/"],
      "matchStrings": ["\"convex@(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "convex",
      "datasourceTemplate": "npm"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0-3 1 * *"]
  },
  "packageRules": [
    {
      "description": "One weekly PR for every non-major update, merged by GitHub once CI passes.",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "description": "Majors wait for approval on the Dependency Dashboard issue.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "A peer range states compatibility, not the version in use.",
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "The overrides block holds hand-curated security floors.",
      "matchDepTypes": ["overrides"],
      "enabled": false
    },
    {
      "description": ".bun-version, packageManager and bun-types must be equal (the workflows check), so they move together and by hand.",
      "matchPackageNames": ["bun", "bun-types"],
      "groupName": "Bun toolchain",
      "groupSlug": "bun",
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
