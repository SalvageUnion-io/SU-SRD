[
  {
    "id": "27bddcdb-edba-41b6-81ad-482026cae261",
    "name": "Create a Pilot",
    "source": "Salvage Union Workshop Manual",
    "page": 22,
    "flowType": "character-creation",
    "content": [
      {
        "type": "paragraph",
        "value": "Follow these steps to create your Pilot character for Salvage Union."
      }
    ],
    "steps": [
      {
        "id": "bce6df59-d455-47fb-9005-56e921587cd5",
        "name": "Choose a Callsign",
        "stepType": "freeform",
        "content": [
          {
            "type": "paragraph",
            "value": "Choose a callsign for your Pilot. This is the name they go by in the Union."
          }
        ]
      },
      {
        "id": "801d291b-c684-4560-9ead-e047786f207b",
        "name": "Choose a Class",
        "stepType": "select-one",
        "schema": ["classes"],
        "filters": [
          {
            "field": "hybrid",
            "value": false
          }
        ],
        "content": [
          {
            "type": "paragraph",
            "value": "Choose a starting class for your Pilot. Hybrid classes cannot be selected during character creation."
          }
        ]
      },
      {
        "id": "662d9643-c9bc-4246-9f9e-66fe5f9a9e15",
        "name": "Choose Starting Abilities",
        "stepType": "select-many",
        "schema": ["abilities"],
        "contextFrom": "801d291b-c684-4560-9ead-e047786f207b",
        "dependsOn": ["801d291b-c684-4560-9ead-e047786f207b"],
        "constraints": {
          "max": 4
        },
        "content": [
          {
            "type": "paragraph",
            "value": "Choose up to 4 starting abilities from your class's core ability trees."
          }
        ]
      },
      {
        "id": "ab942d95-0d84-44ad-9f5b-11d28ad9a9d3",
        "name": "Roll Background",
        "stepType": "roll-table",
        "rollTable": "Background",
        "content": [
          {
            "type": "paragraph",
            "value": "Roll or choose a background for your Pilot."
          }
        ]
      },
      {
        "id": "2150dfdd-9f64-4dca-a8a2-3820e74c7da3",
        "name": "Roll Keepsake",
        "stepType": "roll-table",
        "rollTable": "Keepsake",
        "content": [
          {
            "type": "paragraph",
            "value": "Roll or choose a keepsake — a treasured personal item your Pilot carries."
          }
        ]
      },
      {
        "id": "f68fe49f-2d10-4abe-91ca-64423457e0ab",
        "name": "Choose a Motto",
        "stepType": "freeform",
        "content": [
          {
            "type": "paragraph",
            "value": "Choose a motto or phrase that defines your Pilot."
          }
        ],
        "optional": true
      },
      {
        "id": "4f06a901-ed7e-4dc7-a1bb-b11d7582780d",
        "name": "Describe Appearance",
        "stepType": "freeform",
        "content": [
          {
            "type": "paragraph",
            "value": "Describe your Pilot's appearance and distinguishing features."
          }
        ],
        "optional": true
      }
    ]
  },
  {
    "id": "9eb49f05-da37-453c-9a2a-d8f2c25e6b74",
    "name": "Build a Starting Mech",
    "source": "Salvage Union Workshop Manual",
    "page": 58,
    "flowType": "mech-creation",
    "content": [
      {
        "type": "paragraph",
        "value": "Follow these steps to build a starting Mech for your Pilot."
      }
    ],
    "steps": [
      {
        "id": "5d0d53e1-d2a5-4929-893c-01413b059450",
        "name": "Choose a Chassis",
        "stepType": "select-one",
        "schema": ["chassis"],
        "filters": [
          {
            "field": "techLevel",
            "value": 1
          }
        ],
        "content": [
          {
            "type": "paragraph",
            "value": "Choose a Tech Level 1 chassis for your starting Mech."
          }
        ]
      },
      {
        "id": "29f8005d-4b89-4a80-b10e-e6b73be839b8",
        "name": "Choose a Pattern",
        "stepType": "select-one",
        "schemaField": "patterns",
        "contextFrom": "5d0d53e1-d2a5-4929-893c-01413b059450",
        "dependsOn": ["5d0d53e1-d2a5-4929-893c-01413b059450"],
        "filters": [
          {
            "field": "legalStarting",
            "value": true
          }
        ],
        "content": [
          {
            "type": "paragraph",
            "value": "Choose a starting pattern for your chassis. The pattern determines your Mech's initial systems and modules."
          }
        ]
      },
      {
        "id": "e6afa346-6102-41d6-b359-6b7a21bf7b9d",
        "name": "Name Your Mech",
        "stepType": "freeform",
        "content": [
          {
            "type": "paragraph",
            "value": "Give your Mech a name."
          }
        ]
      },
      {
        "id": "06844a83-139b-4db5-8c44-1c12cbc1bdc2",
        "name": "Describe Mech Appearance",
        "stepType": "freeform",
        "content": [
          {
            "type": "paragraph",
            "value": "Describe the appearance and distinguishing features of your Mech."
          }
        ],
        "optional": true
      },
      {
        "id": "09bd8668-7739-467d-ac6b-85fda9951d50",
        "name": "Roll Mech Quirk",
        "stepType": "roll-table",
        "rollTable": "Mech Quirk",
        "content": [
          {
            "type": "paragraph",
            "value": "Roll or choose a quirk that gives your Mech some personality."
          }
        ],
        "optional": true
      }
    ]
  },
  {
    "id": "1c4aa920-919e-454b-806c-bddd760b35c2",
    "name": "Build a Crawler",
    "source": "Salvage Union Workshop Manual",
    "page": 144,
    "flowType": "crawler-creation",
    "content": [
      {
        "type": "paragraph",
        "value": "Follow these steps to create your Union Crawler — the mobile base of operations for your salvage crew."
      }
    ],
    "steps": [
      {
        "id": "7719034d-b2af-4e4b-a782-a951f43e0576",
        "name": "Choose a Crawler Type",
        "stepType": "select-one",
        "schema": ["crawlers"],
        "content": [
          {
            "type": "paragraph",
            "value": "Choose the type of Crawler your Union operates."
          }
        ]
      },
      {
        "id": "4f91fd50-bf04-4aaf-8c63-702e32cbd987",
        "name": "Name Your Crawler",
        "stepType": "freeform",
        "content": [
          {
            "type": "paragraph",
            "value": "Give your Crawler a name."
          }
        ]
      },
      {
        "id": "8bb1f669-c0d9-4e77-a9ab-a6f0d5f1b3db",
        "name": "Roll Crawler Personality",
        "stepType": "roll-table",
        "rollTable": "Crawler Personality",
        "content": [
          {
            "type": "paragraph",
            "value": "Roll or choose a personality trait for your Crawler's onboard AI."
          }
        ]
      },
      {
        "id": "2df48b8b-7627-48d9-aca0-4e0c277a3de9",
        "name": "Choose a Keepsake",
        "stepType": "freeform",
        "content": [
          {
            "type": "paragraph",
            "value": "Choose a keepsake or trinket kept aboard the Crawler."
          }
        ],
        "optional": true
      },
      {
        "id": "6ac634ff-2d78-4607-82f8-3095c612de16",
        "name": "Choose a Motto",
        "stepType": "freeform",
        "content": [
          {
            "type": "paragraph",
            "value": "Choose a motto or phrase that the crew of the Crawler lives by."
          }
        ],
        "optional": true
      }
    ]
  },
  {
    "id": "9b5a71de-add0-4b59-a22d-d089b3adf476",
    "name": "Level Up",
    "source": "Salvage Union Workshop Manual",
    "page": 52,
    "flowType": "progression",
    "repeatable": true,
    "content": [
      {
        "type": "paragraph",
        "value": "When your Pilot levels up, choose a new ability from your class's available ability trees."
      }
    ],
    "steps": [
      {
        "id": "957065c3-0809-483e-81a9-baae42cfbd39",
        "name": "Choose a New Ability",
        "stepType": "select-one",
        "schema": ["abilities"],
        "contextFrom": "class",
        "content": [
          {
            "type": "paragraph",
            "value": "Choose a new ability from your class's core, advanced, or legendary ability trees (as available)."
          }
        ]
      }
    ]
  },
  {
    "id": "f729d630-3c03-4557-a167-16870fb8ddfa",
    "name": "Mech Customization",
    "source": "Salvage Union Workshop Manual",
    "page": 134,
    "flowType": "downtime",
    "content": [
      {
        "type": "paragraph",
        "value": "During downtime, Pilots can customize their Mech by swapping systems and modules."
      }
    ],
    "steps": [
      {
        "id": "dc762958-c4dc-4eab-a406-e5a0004d8ddd",
        "name": "Choose Systems",
        "stepType": "select-many",
        "schema": ["systems"],
        "content": [
          {
            "type": "paragraph",
            "value": "Choose systems to install on your Mech, within your chassis's system slot capacity."
          }
        ],
        "constraints": {
          "scalesWithField": "systemSlots"
        }
      },
      {
        "id": "8c087bb3-e0ac-433a-a45d-3af9d239d3d4",
        "name": "Choose Modules",
        "stepType": "select-many",
        "schema": ["modules"],
        "content": [
          {
            "type": "paragraph",
            "value": "Choose modules to install on your Mech, within your chassis's module slot capacity."
          }
        ],
        "constraints": {
          "scalesWithField": "moduleSlots"
        }
      }
    ]
  },
  {
    "id": "13c29610-f20e-4b69-921c-f806d274d713",
    "name": "Crawler Upgrade",
    "source": "Salvage Union Workshop Manual",
    "page": 148,
    "flowType": "progression",
    "repeatable": true,
    "content": [
      {
        "type": "paragraph",
        "value": "As your Union grows, the Crawler can be upgraded to higher tech levels, unlocking new bays and facilities."
      }
    ],
    "steps": [
      {
        "id": "5de3a137-4844-4bec-b894-8be617222b23",
        "name": "Upgrade Tech Level",
        "stepType": "info",
        "content": [
          {
            "type": "paragraph",
            "value": "Your Crawler advances to the next tech level, gaining increased structure points and population capacity."
          }
        ]
      },
      {
        "id": "36975eaf-5e0d-4e19-9eaa-17ecf070bea6",
        "name": "Add Bays",
        "stepType": "select-many",
        "schema": ["crawler-bays"],
        "dependsOn": ["5de3a137-4844-4bec-b894-8be617222b23"],
        "content": [
          {
            "type": "paragraph",
            "value": "Choose new bays and facilities to add to your Crawler."
          }
        ]
      }
    ]
  },
  {
    "id": "5b57c66c-ad03-4184-b081-366c98c44fbe",
    "name": "Downtime Activities",
    "source": "Salvage Union Workshop Manual",
    "page": 130,
    "flowType": "downtime",
    "content": [
      {
        "type": "paragraph",
        "value": "During downtime, each Pilot can choose an activity to pursue."
      }
    ],
    "steps": [
      {
        "id": "b8ef9784-3967-4f7d-8e8c-b8d487788a39",
        "name": "Choose an Activity",
        "stepType": "select-one",
        "schema": ["downtime-activities"],
        "content": [
          {
            "type": "paragraph",
            "value": "Choose a downtime activity for your Pilot."
          }
        ]
      }
    ]
  }
]
