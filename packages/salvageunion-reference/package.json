{
  "name": "salvageunion-reference",
  "version": "2.11.2",
  "private": true,
  "description": "Comprehensive, schema-validated JSON dataset and TypeScript ORM for the Salvage Union tabletop RPG",
  "type": "module",
  "main": "./lib/index.ts",
  "types": "./lib/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.ts",
      "default": "./lib/index.ts"
    },
    "./rules": {
      "types": "./lib/rules/index.ts",
      "default": "./lib/rules/index.ts"
    },
    "./zod": {
      "types": "./lib/zod.ts",
      "default": "./lib/zod.ts"
    },
    "./schema-definitions": {
      "types": "./lib/schemaDefinitions.ts",
      "default": "./lib/schemaDefinitions.ts"
    },
    "./data/*": {
      "import": "./data/*.json",
      "default": "./data/*.json"
    },
    "./schemas/*": {
      "import": "./schemas/*.json",
      "default": "./schemas/*.json"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./lib/zod.ts"
  ],
  "scripts": {
    "build": "bun run generate:registry && bun run generate:json-schemas && bun run docs && bun run docs:schemas && bun run generate:api-report",
    "build:full": "bun run build && bun run format && bun run lint",
    "validate:ids": "bun tools/checkUniqueIds.ts",
    "validate:slugs": "bun tools/validateSlugs.ts",
    "fix:ids": "bun tools/generateMissingIds.ts",
    "scaffold:entity": "bun tools/scaffold-entity.ts",
    "docs": "bun tools/generateDocs.ts",
    "docs:schemas": "bun tools/generateSchemaDocs.ts",
    "generate:registry": "bun tools/generateRegistry.ts",
    "generate:json-schemas": "bun tools/generateJsonSchemas.ts",
    "generate:api-report": "bun tools/generateApiReport.ts",
    "validate:references": "bun tools/validateReferences.ts",
    "validate:actions": "bun tools/validateActionReferences.ts",
    "validate:action-backrefs": "bun tools/validateActionBackrefs.ts",
    "validate:orphans": "bun tools/validateOrphans.ts",
    "validate:content-dupes": "bun tools/validateContentDupes.ts",
    "validate:traits": "bun tools/validateTraits.ts",
    "validate:schemas": "bun tools/validateSchemas.ts",
    "validate:all": "bun tools/validate.ts",
    "validate:parity": "bun tools/validateParity.ts",
    "validate:fix": "bun tools/validate.ts --fix",
    "edit-data": "bun tools/edit-data.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "license": "SEE LICENSE IN LICENCE",
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {}
}
