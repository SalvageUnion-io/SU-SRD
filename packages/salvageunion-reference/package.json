{
  "name": "salvageunion-reference",
  "version": "0.0.0",
  "private": true,
  "description": "Comprehensive, schema-validated JSON dataset and TypeScript ORM for the Salvage Union tabletop RPG",
  "type": "module",
  "bin": {
    "ref-generate": "./tools/ensureGenerated.ts"
  },
  "main": "./lib/index.ts",
  "types": "./lib/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.ts",
      "default": "./lib/index.ts"
    },
    "./rules": {
      "types": "./lib/rules/index.ts",
      "default": "./lib/rules/index.ts"
    },
    "./proseDeviations": {
      "types": "./lib/proseDeviations.ts",
      "default": "./lib/proseDeviations.ts"
    },
    "./assetDerivatives": {
      "types": "./lib/assetDerivatives.ts",
      "default": "./lib/assetDerivatives.ts"
    },
    "./zod": {
      "types": "./lib/zod.ts",
      "default": "./lib/zod.ts"
    },
    "./testing": {
      "types": "./lib/testing.ts",
      "default": "./lib/testing.ts"
    },
    "./data/*": "./data/*",
    "./schemas/*": "./schemas/*"
  },
  "sideEffects": [
    "./lib/zod.ts"
  ],
  "scripts": {
    "build": "bun tools/ensureGenerated.ts --force",
    "validate": "bun tools/validate.ts",
    "edit-data": "bun tools/edit-data.ts",
    "test": "bun test --parallel=4 --no-isolate"
  },
  "license": "SEE LICENSE IN LICENCE",
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "zod": "4.6.6"
  }
}
