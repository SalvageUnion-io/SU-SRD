{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salvageunion.com/schemas/crawler-tech-levels.schema.json",
  "title": "crawler-tech-levels",
  "description": "",
  "type": "array",
  "items": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "asset_url": { "type": "string", "format": "uri" },
      "content": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "default": "paragraph",
              "type": "string",
              "enum": ["paragraph", "heading", "list-item", "label", "datavalues", "hint", "flavor"]
            },
            "value": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                      "value": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                      "type": { "type": "string" }
                    },
                    "required": ["label"],
                    "additionalProperties": false
                  },
                  "description": "Array of data values when type is 'datavalues'"
                }
              ]
            },
            "label": { "type": "string" },
            "level": { "type": "integer", "minimum": 1, "maximum": 6 },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "default": "paragraph",
                    "type": "string",
                    "enum": [
                      "paragraph",
                      "heading",
                      "list-item",
                      "label",
                      "datavalues",
                      "hint",
                      "flavor"
                    ]
                  },
                  "value": {
                    "anyOf": [
                      { "type": "string" },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                            "value": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                            "type": { "type": "string" }
                          },
                          "required": ["label"],
                          "additionalProperties": false
                        },
                        "description": "Array of data values when type is 'datavalues'"
                      }
                    ]
                  },
                  "label": { "type": "string" },
                  "level": { "type": "integer", "minimum": 1, "maximum": 6 }
                },
                "required": ["type"],
                "additionalProperties": false
              }
            }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      },
      "id": { "type": "string" },
      "indexable": { "default": true, "type": "boolean" },
      "blackMarket": { "default": false, "type": "boolean" },
      "name": { "type": "string", "minLength": 1 },
      "source": {
        "type": "string",
        "enum": [
          "Salvage Union Workshop Manual",
          "Mech Monday",
          "We Were Here First!",
          "Rainmaker",
          "False Flag"
        ]
      },
      "page": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
      "techLevel": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "Tech level (1-6)"
      },
      "structurePoints": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "upkeepCost": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "Scrap multiplier for upkeep (e.g. 5 means 5× Tech N Scrap)"
      },
      "upgradeCost": {
        "anyOf": [
          { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
          { "type": "null" }
        ],
        "description": "Scrap multiplier for upgrade (e.g. 30 means 30× Tech N Scrap), null if max tech level"
      },
      "populationMin": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Minimum approximate population"
      },
      "populationMax": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "Maximum approximate population (0 means unlimited/25,000+)"
      }
    },
    "required": [
      "id",
      "indexable",
      "blackMarket",
      "name",
      "source",
      "page",
      "techLevel",
      "structurePoints",
      "upkeepCost",
      "upgradeCost",
      "populationMin",
      "populationMax"
    ],
    "additionalProperties": false
  }
}
