{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salvageunion.com/schemas/keywords.schema.json",
  "title": "keywords",
  "description": "Game keywords and terminology",
  "type": "array",
  "items": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "assetExtension": {
        "type": "string",
        "enum": ["png", "jpg", "jpeg", "webp", "gif", "avif", "svg"],
        "description": "Image file extension for this entity's artwork; the URL is derived from schema + slug"
      },
      "content": {
        "type": "array",
        "items": {
          "description": "Block of structured content for rendering (paragraph, heading, list item, etc.)",
          "type": "object",
          "properties": {
            "type": {
              "default": "paragraph",
              "type": "string",
              "enum": [
                "paragraph",
                "heading",
                "list-item",
                "label",
                "datavalues",
                "hint",
                "flavor"
              ],
              "description": "Type of content block for rendering structured text"
            },
            "value": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "anyOf": [{ "type": "string" }, { "type": "number" }],
                        "description": "Display label for this data value"
                      },
                      "value": {
                        "anyOf": [{ "type": "string" }, { "type": "number" }],
                        "description": "The data value"
                      },
                      "type": {
                        "type": "string",
                        "description": "Type classification for this data value"
                      },
                      "unit": {
                        "type": "string",
                        "description": "Optional unit shown after the value (e.g. damage type \"SP\")"
                      }
                    },
                    "required": ["label"],
                    "additionalProperties": false,
                    "description": "A data value with label, optional value, optional type, and optional unit"
                  },
                  "description": "Array of data values when type is 'datavalues'"
                }
              ]
            },
            "label": { "type": "string" },
            "level": { "type": "integer", "minimum": 1, "maximum": 6 },
            "lead": { "type": "boolean" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "default": "paragraph",
                    "type": "string",
                    "enum": [
                      "paragraph",
                      "heading",
                      "list-item",
                      "label",
                      "datavalues",
                      "hint",
                      "flavor"
                    ],
                    "description": "Type of content block for rendering structured text"
                  },
                  "value": {
                    "anyOf": [
                      { "type": "string" },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "anyOf": [{ "type": "string" }, { "type": "number" }],
                              "description": "Display label for this data value"
                            },
                            "value": {
                              "anyOf": [{ "type": "string" }, { "type": "number" }],
                              "description": "The data value"
                            },
                            "type": {
                              "type": "string",
                              "description": "Type classification for this data value"
                            },
                            "unit": {
                              "type": "string",
                              "description": "Optional unit shown after the value (e.g. damage type \"SP\")"
                            }
                          },
                          "required": ["label"],
                          "additionalProperties": false,
                          "description": "A data value with label, optional value, optional type, and optional unit"
                        },
                        "description": "Array of data values when type is 'datavalues'"
                      }
                    ]
                  },
                  "label": { "type": "string" },
                  "level": { "type": "integer", "minimum": 1, "maximum": 6 }
                },
                "required": ["type"],
                "additionalProperties": false
              }
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        "description": "Definition and explanation of this keyword"
      },
      "id": { "type": "string", "description": "Unique identifier for this entity" },
      "indexable": {
        "default": true,
        "description": "Whether this entity appears in search results",
        "type": "boolean"
      },
      "blackMarket": {
        "default": false,
        "description": "Whether this entity is only available on the black market",
        "type": "boolean"
      },
      "name": { "type": "string", "minLength": 1, "description": "Display name of this entity" },
      "source": {
        "type": "string",
        "enum": [
          "Salvage Union Workshop Manual",
          "Salvage Union Starter Set",
          "Reclamation of the Wastes",
          "The Hive",
          "Thatcher's Mech Base",
          "Relics of a Time Gone By",
          "Mech Monday",
          "We Were Here First!",
          "Rainmaker",
          "False Flag"
        ],
        "description": "Primary source book this entity appears in"
      },
      "page": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "Page number in the primary source book"
      },
      "booklet": {
        "type": "string",
        "minLength": 1,
        "description": "Booklet code within a multi-booklet primary source (e.g. \"CR\", \"PH\", \"PC\", \"RR\", \"AP\" for the Salvage Union Starter Set). Omit for single-volume sources."
      },
      "additionalSources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "Salvage Union Workshop Manual",
                "Salvage Union Starter Set",
                "Reclamation of the Wastes",
                "The Hive",
                "Thatcher's Mech Base",
                "Relics of a Time Gone By",
                "Mech Monday",
                "We Were Here First!",
                "Rainmaker",
                "False Flag"
              ],
              "description": "Secondary source book this entity also appears in"
            },
            "booklet": {
              "type": "string",
              "minLength": 1,
              "description": "Booklet code within a multi-booklet source (e.g. \"CR\", \"PH\", \"PC\", \"RR\", \"AP\" for the Salvage Union Starter Set — Core Rulebook / Pilots Handbook / Parts Catalogue / Rules Reference / Asset Pack). Omit for single-volume sources."
            },
            "page": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Page number in the secondary source book"
            }
          },
          "required": ["source", "page"],
          "additionalProperties": false,
          "description": "A secondary source where this entity is reprinted (e.g. condensed in a Starter Set)"
        },
        "description": "Other source books where this entity is reprinted"
      }
    },
    "required": ["id", "indexable", "blackMarket", "name", "source", "page"],
    "additionalProperties": false,
    "description": "Game keywords and terminology"
  }
}
