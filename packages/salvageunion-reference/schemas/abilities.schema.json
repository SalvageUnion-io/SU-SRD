{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salvageunion.com/schemas/abilities.schema.json",
  "title": "abilities",
  "description": "Pilot abilities and skills in Salvage Union",
  "type": "array",
  "items": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "asset_url": {
        "type": "string",
        "format": "uri",
        "description": "URL to an image asset for this entity"
      },
      "content": {
        "type": "array",
        "items": {
          "description": "Block of structured content for rendering (paragraph, heading, list item, etc.)",
          "type": "object",
          "properties": {
            "type": {
              "default": "paragraph",
              "type": "string",
              "enum": [
                "paragraph",
                "heading",
                "list-item",
                "label",
                "datavalues",
                "hint",
                "flavor"
              ],
              "description": "Type of content block for rendering structured text"
            },
            "value": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "anyOf": [{ "type": "string" }, { "type": "number" }],
                        "description": "Display label for this data value"
                      },
                      "value": {
                        "anyOf": [{ "type": "string" }, { "type": "number" }],
                        "description": "The data value"
                      },
                      "type": {
                        "type": "string",
                        "description": "Type classification for this data value"
                      }
                    },
                    "required": ["label"],
                    "additionalProperties": false,
                    "description": "A data value with label, optional value, and optional type"
                  },
                  "description": "Array of data values when type is 'datavalues'"
                }
              ]
            },
            "label": { "type": "string" },
            "level": { "type": "integer", "minimum": 1, "maximum": 6 },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "default": "paragraph",
                    "type": "string",
                    "enum": [
                      "paragraph",
                      "heading",
                      "list-item",
                      "label",
                      "datavalues",
                      "hint",
                      "flavor"
                    ],
                    "description": "Type of content block for rendering structured text"
                  },
                  "value": {
                    "anyOf": [
                      { "type": "string" },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "anyOf": [{ "type": "string" }, { "type": "number" }],
                              "description": "Display label for this data value"
                            },
                            "value": {
                              "anyOf": [{ "type": "string" }, { "type": "number" }],
                              "description": "The data value"
                            },
                            "type": {
                              "type": "string",
                              "description": "Type classification for this data value"
                            }
                          },
                          "required": ["label"],
                          "additionalProperties": false,
                          "description": "A data value with label, optional value, and optional type"
                        },
                        "description": "Array of data values when type is 'datavalues'"
                      }
                    ]
                  },
                  "label": { "type": "string" },
                  "level": { "type": "integer", "minimum": 1, "maximum": 6 }
                },
                "required": ["type"],
                "additionalProperties": false
              }
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        "description": "Descriptive content blocks for this entity"
      },
      "id": { "type": "string", "description": "Unique identifier for this entity" },
      "indexable": {
        "default": true,
        "description": "Whether this entity appears in search results",
        "type": "boolean"
      },
      "blackMarket": {
        "default": false,
        "description": "Whether this entity is only available on the black market",
        "type": "boolean"
      },
      "name": { "type": "string", "minLength": 1, "description": "Display name of this entity" },
      "source": {
        "type": "string",
        "enum": [
          "Salvage Union Workshop Manual",
          "Salvage Union Starter Set",
          "Reclamation of the Wastes",
          "The Hive",
          "Thatcher's Mech Base",
          "Relics of a Time Gone By",
          "Mech Monday",
          "We Were Here First!",
          "Rainmaker",
          "False Flag"
        ],
        "description": "Primary source book this entity appears in"
      },
      "page": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "Page number in the primary source book"
      },
      "booklet": {
        "type": "string",
        "minLength": 1,
        "description": "Booklet code within a multi-booklet primary source (e.g. \"CR\", \"PH\", \"PC\", \"RR\", \"AP\" for the Salvage Union Starter Set). Omit for single-volume sources."
      },
      "additionalSources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "Salvage Union Workshop Manual",
                "Salvage Union Starter Set",
                "Reclamation of the Wastes",
                "The Hive",
                "Thatcher's Mech Base",
                "Relics of a Time Gone By",
                "Mech Monday",
                "We Were Here First!",
                "Rainmaker",
                "False Flag"
              ],
              "description": "Secondary source book this entity also appears in"
            },
            "booklet": {
              "type": "string",
              "minLength": 1,
              "description": "Booklet code within a multi-booklet source (e.g. \"CR\", \"PH\", \"PC\", \"RR\", \"AP\" for the Salvage Union Starter Set — Core Rulebook / Pilots Handbook / Parts Catalogue / Rules Reference / Asset Pack). Omit for single-volume sources."
            },
            "page": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Page number in the secondary source book"
            }
          },
          "required": ["source", "page"],
          "additionalProperties": false,
          "description": "A secondary source where this entity is reprinted (e.g. condensed in a Starter Set)"
        },
        "description": "Other source books where this entity is reprinted"
      },
      "description": { "type": "string", "description": "Short description of the ability" },
      "tree": {
        "type": "string",
        "enum": [
          "Advanced Engineer",
          "Advanced Hacking",
          "Advanced Hauler",
          "Advanced Scout",
          "Advanced Soldier",
          "Augmentation",
          "Cyborg",
          "Electronics",
          "Fabricator",
          "Forging",
          "Generic",
          "Gladiatorial Combat",
          "Hacking",
          "Leadership",
          "Legendary Cyborg",
          "Legendary Engineer",
          "Legendary Fabricator",
          "Legendary Hacker",
          "Legendary Hauler",
          "Legendary Ranger",
          "Legendary Scout",
          "Legendary Smuggler",
          "Legendary Soldier",
          "Legendary Union Rep",
          "Mech-Tech",
          "Mechanical Knowledge",
          "Ranger",
          "Recon",
          "Salvaging",
          "Sleuth",
          "Smuggler",
          "Sniper",
          "Survivalist",
          "Tactical Warfare",
          "Trading",
          "Union Rep"
        ],
        "description": "Ability tree this ability belongs to"
      },
      "level": {
        "anyOf": [
          { "type": "integer", "minimum": 1, "maximum": 3 },
          { "type": "string", "const": "L" },
          { "type": "string", "const": "G" }
        ],
        "description": "Ability level (1-3, L for Legendary, G for Generic)"
      },
      "mechActionType": {
        "type": "string",
        "enum": ["Passive", "Free", "Reaction", "Turn", "Short", "Long", "DownTime"],
        "description": "Action type when used as a mech action"
      },
      "grants": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "abilities",
                    "ability-tree-requirements",
                    "bio-titans",
                    "chassis",
                    "classes",
                    "crawler-bays",
                    "crawler-tech-levels",
                    "crawlers",
                    "creatures",
                    "distances",
                    "drones",
                    "equipment",
                    "guides",
                    "keywords",
                    "factions",
                    "meld",
                    "modules",
                    "npcs",
                    "roll-tables",
                    "sources",
                    "squads",
                    "tech-levels",
                    "systems",
                    "traits",
                    "vehicles"
                  ],
                  "description": "Name of the entity schema collection"
                },
                { "type": "string", "const": "choice" }
              ],
              "description": "Schema collection the granted entity belongs to, or 'choice' for a choice grant"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Name of the granted entity or choice"
            }
          },
          "required": ["schema", "name"],
          "additionalProperties": false,
          "description": "An entity or choice granted by an ability"
        },
        "description": "Entities or choices granted by this ability"
      },
      "activationCurrency": {
        "type": "string",
        "enum": ["Variable", "EP or AP", "SP or HP"],
        "description": "Currency type used for activation"
      },
      "actions": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Action names this ability provides"
      }
    },
    "required": [
      "id",
      "indexable",
      "blackMarket",
      "name",
      "source",
      "page",
      "tree",
      "level",
      "actions"
    ],
    "additionalProperties": false,
    "description": "Pilot abilities and skills in Salvage Union"
  }
}
