              "type": "string",
              "enum": [
                "abilities",
                "ability-tree-requirements",
                "bio-titans",
                "chassis",
                "classes",
                "crawler-bays",
                "crawler-tech-levels",
                "crawlers",
                "creatures",
                "distances",
                "drones",
                "equipment",
                "guides",
                "keywords",
                "factions",
                "meld",
                "modules",
                "npcs",
                "roll-tables",
                "squads",
                "systems",
                "traits",
                "vehicles"
              ]
            }
          },
          "flat": { "type": "boolean", "default": false }
        },
        "required": ["id", "name", "schemas"],
        "additionalProperties": false
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}
