{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salvageunion.com/schemas/catalog-categories.schema.json",
  "title": "catalog-categories",
  "description": "",
  "type": "array",
  "items": {
    "$ref": "#/definitions/catalog-categories",
    "definitions": {
      "catalog-categories": {
        "type": "object",
