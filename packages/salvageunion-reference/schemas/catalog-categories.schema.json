{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salvageunion.com/schemas/catalog-categories.schema.json",
  "title": "catalog-categories",
  "description": "",
  "type": "array",
  "items": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string", "minLength": 1 },
      "schemas": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "abilities",
            "ability-tree-requirements",
            "bio-titans",
            "chassis",
            "classes",
            "crawler-bays",
            "crawler-tech-levels",
            "crawlers",
            "creatures",
            "distances",
            "drones",
            "equipment",
            "guides",
            "keywords",
            "factions",
            "meld",
            "modules",
            "npcs",
            "roll-tables",
            "sources",
            "squads",
            "tech-levels",
            "systems",
            "traits",
            "vehicles"
          ]
        }
      },
      "flat": { "default": false, "type": "boolean" }
    },
    "required": ["id", "name", "schemas", "flat"],
    "additionalProperties": false
  }
}
