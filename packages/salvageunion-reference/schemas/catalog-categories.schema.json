{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salvageunion.com/schemas/catalog-categories.schema.json",
  "title": "catalog-categories",
  "description": "Catalog categories for organizing schemas in the UI",
  "type": "array",
  "items": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "id": { "type": "string", "description": "Unique identifier for this catalog category" },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Display name of this catalog category"
      },
      "schemas": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "abilities",
            "ability-tree-requirements",
            "chassis",
            "classes",
            "crawler-bays",
            "crawler-tech-levels",
            "crawlers",
            "creatures",
            "distances",
            "drones",
            "equipment",
            "guides",
            "keywords",
            "factions",
            "meld",
            "modules",
            "npcs",
            "roll-tables",
            "sources",
            "squads",
            "tech-levels",
            "systems",
            "titans",
            "traits",
            "vehicles"
          ],
          "description": "Name of the entity schema collection"
        },
        "description": "Schema collections included in this category"
      },
      "flat": {
        "default": false,
        "description": "Whether to display schemas in a flat list",
        "type": "boolean"
      }
    },
    "required": ["id", "name", "schemas", "flat"],
    "additionalProperties": false,
    "description": "Catalog categories for organizing schemas in the UI"
  }
}
