{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salvageunion.com/schemas/guides.schema.json",
  "title": "guides",
  "description": "Player-facing guides and processes",
  "type": "array",
  "items": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "hasArtwork": {
        "type": "boolean",
        "description": "Whether this entity has artwork; the .webp URL is derived from schema + slug"
      },
      "content": {
        "type": "array",
        "items": {
          "description": "Block of structured content for rendering (paragraph, heading, list item, etc.)",
          "type": "object",
          "properties": {
            "type": {
              "default": "paragraph",
              "type": "string",
              "enum": [
                "paragraph",
                "heading",
                "list-item",
                "label",
                "datavalues",
                "hint",
                "flavor"
              ],
              "description": "Type of content block for rendering structured text"
            },
            "value": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "anyOf": [{ "type": "string" }, { "type": "number" }],
                        "description": "Display label for this data value"
                      },
                      "value": {
                        "anyOf": [{ "type": "string" }, { "type": "number" }],
                        "description": "The data value"
                      },
                      "type": {
                        "type": "string",
                        "description": "Type classification for this data value"
                      },
                      "unit": {
                        "type": "string",
                        "description": "Optional unit shown after the value (e.g. damage type \"SP\")"
                      }
                    },
                    "required": ["label"],
                    "additionalProperties": false,
                    "description": "A data value with label, optional value, optional type, and optional unit"
                  },
                  "description": "Array of data values when type is 'datavalues'"
                }
              ]
            },
            "label": { "type": "string" },
            "level": { "type": "integer", "minimum": 1, "maximum": 6 },
            "lead": { "type": "boolean" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "default": "paragraph",
                    "type": "string",
                    "enum": [
                      "paragraph",
                      "heading",
                      "list-item",
                      "label",
                      "datavalues",
                      "hint",
                      "flavor"
                    ],
                    "description": "Type of content block for rendering structured text"
                  },
                  "value": {
                    "anyOf": [
                      { "type": "string" },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "anyOf": [{ "type": "string" }, { "type": "number" }],
                              "description": "Display label for this data value"
                            },
                            "value": {
                              "anyOf": [{ "type": "string" }, { "type": "number" }],
                              "description": "The data value"
                            },
                            "type": {
                              "type": "string",
                              "description": "Type classification for this data value"
                            },
                            "unit": {
                              "type": "string",
                              "description": "Optional unit shown after the value (e.g. damage type \"SP\")"
                            }
                          },
                          "required": ["label"],
                          "additionalProperties": false,
                          "description": "A data value with label, optional value, optional type, and optional unit"
                        },
                        "description": "Array of data values when type is 'datavalues'"
                      }
                    ]
                  },
                  "label": { "type": "string" },
                  "level": { "type": "integer", "minimum": 1, "maximum": 6 }
                },
                "required": ["type"],
                "additionalProperties": false
              }
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        "description": "Descriptive content blocks for this entity"
      },
      "id": { "type": "string", "description": "Unique identifier for this entity" },
      "indexable": {
        "default": true,
        "description": "Whether this entity appears in search results",
        "type": "boolean"
      },
      "blackMarket": {
        "default": false,
        "description": "Whether this entity is only available on the black market",
        "type": "boolean"
      },
      "name": { "type": "string", "minLength": 1, "description": "Display name of this entity" },
      "source": {
        "type": "string",
        "enum": [
          "Salvage Union Workshop Manual",
          "Salvage Union Starter Set",
          "Reclamation of the Wastes",
          "The Hive",
          "Thatcher's Mech Base",
          "Relics of a Time Gone By",
          "Mech Monday",
          "We Were Here First!",
          "Rainmaker",
          "False Flag"
        ],
        "description": "Primary source book this entity appears in"
      },
      "page": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "Page number in the primary source book"
      },
      "booklet": {
        "type": "string",
        "minLength": 1,
        "description": "Booklet code within a multi-booklet primary source (e.g. \"CR\", \"PH\", \"PC\", \"RR\", \"AP\" for the Salvage Union Starter Set). Omit for single-volume sources."
      },
      "additionalSources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "Salvage Union Workshop Manual",
                "Salvage Union Starter Set",
                "Reclamation of the Wastes",
                "The Hive",
                "Thatcher's Mech Base",
                "Relics of a Time Gone By",
                "Mech Monday",
                "We Were Here First!",
                "Rainmaker",
                "False Flag"
              ],
              "description": "Secondary source book this entity also appears in"
            },
            "booklet": {
              "type": "string",
              "minLength": 1,
              "description": "Booklet code within a multi-booklet source (e.g. \"CR\", \"PH\", \"PC\", \"RR\", \"AP\" for the Salvage Union Starter Set — Core Rulebook / Pilots Handbook / Parts Catalogue / Rules Reference / Asset Pack). Omit for single-volume sources."
            },
            "page": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Page number in the secondary source book"
            }
          },
          "required": ["source", "page"],
          "additionalProperties": false,
          "description": "A secondary source where this entity is reprinted (e.g. condensed in a Starter Set)"
        },
        "description": "Other source books where this entity is reprinted"
      },
      "guideType": {
        "type": "string",
        "enum": [
          "character-creation",
          "mech-creation",
          "crawler-creation",
          "progression",
          "downtime",
          "gameplay"
        ],
        "description": "Category of this guide"
      },
      "guideColor": {
        "default": "#000000",
        "description": "Hex color for entity display header/footer",
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "steps": {
        "type": "array",
        "items": {
          "description": "A single step in a guide process",
          "type": "object",
          "properties": {
            "id": { "type": "string", "description": "Unique identifier for this guide step" },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Display name of this guide step"
            },
            "stepType": {
              "type": "string",
              "enum": ["select-one", "select-many", "freeform", "roll-table", "info", "sub-guide"],
              "description": "Type of decision this step represents (select-one, select-many, freeform, etc.)"
            },
            "section": {
              "type": "string",
              "description": "Section label; starts a new numbered group when present"
            },
            "content": {
              "type": "array",
              "items": {
                "description": "Block of structured content for rendering (paragraph, heading, list item, etc.)",
                "type": "object",
                "properties": {
                  "type": {
                    "default": "paragraph",
                    "type": "string",
                    "enum": [
                      "paragraph",
                      "heading",
                      "list-item",
                      "label",
                      "datavalues",
                      "hint",
                      "flavor"
                    ],
                    "description": "Type of content block for rendering structured text"
                  },
                  "value": {
                    "anyOf": [
                      { "type": "string" },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "anyOf": [{ "type": "string" }, { "type": "number" }],
                              "description": "Display label for this data value"
                            },
                            "value": {
                              "anyOf": [{ "type": "string" }, { "type": "number" }],
                              "description": "The data value"
                            },
                            "type": {
                              "type": "string",
                              "description": "Type classification for this data value"
                            },
                            "unit": {
                              "type": "string",
                              "description": "Optional unit shown after the value (e.g. damage type \"SP\")"
                            }
                          },
                          "required": ["label"],
                          "additionalProperties": false,
                          "description": "A data value with label, optional value, optional type, and optional unit"
                        },
                        "description": "Array of data values when type is 'datavalues'"
                      }
                    ]
                  },
                  "label": { "type": "string" },
                  "level": { "type": "integer", "minimum": 1, "maximum": 6 },
                  "lead": { "type": "boolean" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "default": "paragraph",
                          "type": "string",
                          "enum": [
                            "paragraph",
                            "heading",
                            "list-item",
                            "label",
                            "datavalues",
                            "hint",
                            "flavor"
                          ],
                          "description": "Type of content block for rendering structured text"
                        },
                        "value": {
                          "anyOf": [
                            { "type": "string" },
                            {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "label": {
                                    "anyOf": [{ "type": "string" }, { "type": "number" }],
                                    "description": "Display label for this data value"
                                  },
                                  "value": {
                                    "anyOf": [{ "type": "string" }, { "type": "number" }],
                                    "description": "The data value"
                                  },
                                  "type": {
                                    "type": "string",
                                    "description": "Type classification for this data value"
                                  },
                                  "unit": {
                                    "type": "string",
                                    "description": "Optional unit shown after the value (e.g. damage type \"SP\")"
                                  }
                                },
                                "required": ["label"],
                                "additionalProperties": false,
                                "description": "A data value with label, optional value, optional type, and optional unit"
                              },
                              "description": "Array of data values when type is 'datavalues'"
                            }
                          ]
                        },
                        "label": { "type": "string" },
                        "level": { "type": "integer", "minimum": 1, "maximum": 6 }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["type"],
                "additionalProperties": false
              },
              "description": "Descriptive content for this step"
            },
            "schema": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "abilities",
                      "ability-tree-requirements",
                      "chassis",
                      "classes",
                      "crawler-bays",
                      "crawler-tech-levels",
                      "crawlers",
                      "creatures",
                      "distances",
                      "drones",
                      "equipment",
                      "guides",
                      "keywords",
                      "factions",
                      "meld",
                      "modules",
                      "npcs",
                      "roll-tables",
                      "sources",
                      "squads",
                      "tech-levels",
                      "systems",
                      "bio-titans",
                      "traits",
                      "vehicles"
                    ],
                    "description": "Name of the entity schema collection"
                  },
                  { "type": "string", "const": "actions" }
                ]
              },
              "description": "Schema(s) to select from"
            },
            "schemaEntities": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Specific entity names within the schema"
            },
            "schemaField": {
              "type": "string",
              "description": "Field on the parent entity whose values are the options (e.g., \"patterns\" on chassis)"
            },
            "rollTable": { "type": "string", "description": "Roll table name to use" },
            "choiceOptions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "value": { "type": "string" },
                  "description": { "type": "string" },
                  "effects": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "op": { "type": "string", "const": "addTrait" },
                            "value": { "type": "string" },
                            "amount": { "anyOf": [{ "type": "string" }, { "type": "number" }] }
                          },
                          "required": ["op", "value"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "op": { "type": "string", "const": "removeTrait" },
                            "value": { "type": "string" }
                          },
                          "required": ["op", "value"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "op": { "type": "string", "const": "setRange" },
                            "value": { "anyOf": [{ "type": "string" }, { "type": "number" }] }
                          },
                          "required": ["op", "value"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "op": { "type": "string", "const": "addDamage" },
                            "value": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                            "unit": { "type": "string" }
                          },
                          "required": ["op", "value"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": ["label", "value"],
                "additionalProperties": false
              },
              "description": "Static options for this step"
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "Field name on the target entity to filter by"
                  },
                  "operator": {
                    "description": "Comparison operator: eq (default) or ne (not equal)",
                    "type": "string",
                    "enum": ["eq", "ne"]
                  },
                  "value": {
                    "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }],
                    "description": "Value to compare the field against"
                  },
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Non-negative integer (0 or greater)"
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Non-negative integer (0 or greater)"
                  }
                },
                "required": ["field"],
                "additionalProperties": false
              }
            },
            "constraints": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "min": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Non-negative integer (0 or greater)"
                },
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Non-negative integer (0 or greater)"
                },
                "scalesWithField": {
                  "type": "string",
                  "description": "Dynamic max: resolve this field name from the parent entity to use as max"
                }
              },
              "additionalProperties": false
            },
            "dependsOn": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Step IDs that must be completed before this step"
            },
            "contextFrom": {
              "type": "string",
              "description": "Step ID whose result provides context (e.g., chassis selection provides patterns)"
            },
            "guideRef": {
              "type": "string",
              "description": "ID of another guide to execute as a sub-guide"
            },
            "optional": { "type": "boolean" },
            "paperOnly": {
              "type": "boolean",
              "description": "Step only applies to paper play (e.g. writing down stats on a character sheet)"
            },
            "entityLayout": {
              "type": "string",
              "enum": ["sidebar"],
              "description": "Layout for entity displays: sidebar places entities in a left column"
            }
          },
          "required": ["id", "name", "stepType"],
          "additionalProperties": false
        },
        "description": "Ordered sequence of steps"
      },
      "repeatable": {
        "description": "Whether this guide can be executed multiple times",
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "indexable",
      "blackMarket",
      "name",
      "source",
      "page",
      "guideType",
      "guideColor",
      "steps"
    ],
    "additionalProperties": false,
    "description": "Player-facing guides and processes"
  }
}
