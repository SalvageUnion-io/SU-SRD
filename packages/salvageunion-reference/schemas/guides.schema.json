{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salvageunion.com/schemas/guides.schema.json",
  "title": "guides",
  "description": "",
  "type": "array",
  "items": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "asset_url": { "type": "string", "format": "uri" },
      "content": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "default": "paragraph",
              "type": "string",
              "enum": ["paragraph", "heading", "list-item", "label", "datavalues", "hint", "flavor"]
            },
            "value": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                      "value": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                      "type": { "type": "string" }
                    },
                    "required": ["label"],
                    "additionalProperties": false
                  },
                  "description": "Array of data values when type is 'datavalues'"
                }
              ]
            },
            "label": { "type": "string" },
            "level": { "type": "integer", "minimum": 1, "maximum": 6 },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "default": "paragraph",
                    "type": "string",
                    "enum": [
                      "paragraph",
                      "heading",
                      "list-item",
                      "label",
                      "datavalues",
                      "hint",
                      "flavor"
                    ]
                  },
                  "value": {
                    "anyOf": [
                      { "type": "string" },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                            "value": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                            "type": { "type": "string" }
                          },
                          "required": ["label"],
                          "additionalProperties": false
                        },
                        "description": "Array of data values when type is 'datavalues'"
                      }
                    ]
                  },
                  "label": { "type": "string" },
                  "level": { "type": "integer", "minimum": 1, "maximum": 6 }
                },
                "required": ["type"],
                "additionalProperties": false
              }
            }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      },
      "id": { "type": "string" },
      "indexable": { "default": true, "type": "boolean" },
      "blackMarket": { "default": false, "type": "boolean" },
      "name": { "type": "string", "minLength": 1 },
      "source": {
        "type": "string",
        "enum": [
          "Salvage Union Workshop Manual",
          "Mech Monday",
          "We Were Here First!",
          "Rainmaker",
          "False Flag"
        ]
      },
      "page": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
      "guideType": {
        "type": "string",
        "enum": [
          "character-creation",
          "mech-creation",
          "crawler-creation",
          "progression",
          "downtime",
          "gameplay"
        ],
        "description": "Category of this guide"
      },
      "guideColor": {
        "default": "#000000",
        "description": "Hex color for entity display header/footer",
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string", "minLength": 1 },
            "stepType": {
              "type": "string",
              "enum": ["select-one", "select-many", "freeform", "roll-table", "info", "sub-guide"]
            },
            "section": {
              "type": "string",
              "description": "Section label; starts a new numbered group when present"
            },
            "content": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "default": "paragraph",
                    "type": "string",
                    "enum": [
                      "paragraph",
                      "heading",
                      "list-item",
                      "label",
                      "datavalues",
                      "hint",
                      "flavor"
                    ]
                  },
                  "value": {
                    "anyOf": [
                      { "type": "string" },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                            "value": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                            "type": { "type": "string" }
                          },
                          "required": ["label"],
                          "additionalProperties": false
                        },
                        "description": "Array of data values when type is 'datavalues'"
                      }
                    ]
                  },
                  "label": { "type": "string" },
                  "level": { "type": "integer", "minimum": 1, "maximum": 6 },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "default": "paragraph",
                          "type": "string",
                          "enum": [
                            "paragraph",
                            "heading",
                            "list-item",
                            "label",
                            "datavalues",
                            "hint",
                            "flavor"
                          ]
                        },
                        "value": {
                          "anyOf": [
                            { "type": "string" },
                            {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "label": {
                                    "anyOf": [{ "type": "string" }, { "type": "number" }]
                                  },
                                  "value": {
                                    "anyOf": [{ "type": "string" }, { "type": "number" }]
                                  },
                                  "type": { "type": "string" }
                                },
                                "required": ["label"],
                                "additionalProperties": false
                              },
                              "description": "Array of data values when type is 'datavalues'"
                            }
                          ]
                        },
                        "label": { "type": "string" },
                        "level": { "type": "integer", "minimum": 1, "maximum": 6 }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["type"],
                "additionalProperties": false
              }
            },
            "schema": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "abilities",
                      "ability-tree-requirements",
                      "bio-titans",
                      "chassis",
                      "classes",
                      "crawler-bays",
                      "crawler-tech-levels",
                      "crawlers",
                      "creatures",
                      "distances",
                      "drones",
                      "equipment",
                      "guides",
                      "keywords",
                      "factions",
                      "meld",
                      "modules",
                      "npcs",
                      "roll-tables",
                      "squads",
                      "systems",
                      "traits",
                      "vehicles"
                    ]
                  },
                  { "type": "string", "const": "actions" }
                ]
              },
              "description": "Schema(s) to select from"
            },
            "schemaEntities": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Specific entity names within the schema"
            },
            "schemaField": {
              "type": "string",
              "description": "Field on the parent entity whose values are the options (e.g., \"patterns\" on chassis)"
            },
            "rollTable": { "type": "string", "description": "Roll table name to use" },
            "choiceOptions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "value": { "type": "string" },
                  "description": { "type": "string" }
                },
                "required": ["label", "value"],
                "additionalProperties": false
              },
              "description": "Static options for this step"
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "Field name on the target entity to filter by"
                  },
                  "operator": {
                    "description": "Comparison operator: eq (default) or ne (not equal)",
                    "type": "string",
                    "enum": ["eq", "ne"]
                  },
                  "value": {
                    "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }],
                    "description": "Value to compare the field against"
                  },
                  "min": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "max": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                },
                "required": ["field"],
                "additionalProperties": false
              }
            },
            "constraints": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "min": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "max": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "scalesWithField": {
                  "type": "string",
                  "description": "Dynamic max: resolve this field name from the parent entity to use as max"
                }
              },
              "additionalProperties": false
            },
            "dependsOn": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Step IDs that must be completed before this step"
            },
            "contextFrom": {
              "type": "string",
              "description": "Step ID whose result provides context (e.g., chassis selection provides patterns)"
            },
            "guideRef": {
              "type": "string",
              "description": "ID of another guide to execute as a sub-guide"
            },
            "optional": { "type": "boolean" },
            "paperOnly": {
              "type": "boolean",
              "description": "Step only applies to paper play (e.g. writing down stats on a character sheet)"
            },
            "entityLayout": {
              "type": "string",
              "enum": ["sidebar"],
              "description": "Layout for entity displays: sidebar places entities in a left column"
            }
          },
          "required": ["id", "name", "stepType"],
          "additionalProperties": false
        },
        "description": "Ordered sequence of steps"
      },
      "repeatable": {
        "description": "Whether this guide can be executed multiple times",
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "indexable",
      "blackMarket",
      "name",
      "source",
      "page",
      "guideType",
      "guideColor",
      "steps"
    ],
    "additionalProperties": false
  }
}
