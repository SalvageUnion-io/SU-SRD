{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salvageunion.com/schemas/equipment.schema.json",
  "title": "equipment",
  "description": "",
  "type": "array",
  "items": {
    "$ref": "#/definitions/equipment",
    "definitions": {
      "equipment": {
        "type": "object",
        "properties": {
          "asset_url": { "type": "string", "format": "uri" },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["paragraph", "heading", "list-item", "label", "datavalues", "hint"],
                  "default": "paragraph"
                },
                "value": {
                  "anyOf": [
                    { "type": "string" },
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": { "type": ["string", "number"] },
                          "value": { "type": ["string", "number"] },
                          "type": { "type": "string" }
                        },
                        "required": ["label"],
                        "additionalProperties": false
                      },
                      "description": "Array of data values when type is 'datavalues'"
                    }
                  ]
                },
                "label": { "type": "string" },
                "level": { "type": "integer", "minimum": 1, "maximum": 6 },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/definitions/equipment/properties/content/items/properties/type",
                        "default": "paragraph"
                      },
                      "value": {
                        "anyOf": [
                          { "type": "string" },
                          {
                            "type": "array",
                            "items": {
                              "$ref": "#/definitions/equipment/properties/content/items/properties/value/anyOf/1/items"
                            },
                            "description": "Array of data values when type is 'datavalues'"
                          }
                        ]
                      },
                      "label": { "type": "string" },
                      "level": { "type": "integer", "minimum": 1, "maximum": 6 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "id": { "type": "string" },
          "indexable": { "type": "boolean", "default": true },
          "blackMarket": { "type": "boolean", "default": false },
          "name": { "type": "string", "minLength": 1 },
          "source": {
            "type": "string",
            "enum": [
              "Salvage Union Workshop Manual",
              "Mech Monday",
              "We Were Here First!",
              "Rainmaker",
              "False Flag"
            ]
          },
          "page": { "type": "integer", "exclusiveMinimum": 0 },
          "structurePoints": { "type": "integer", "minimum": 0 },
          "energyPoints": { "$ref": "#/definitions/equipment/properties/structurePoints" },
          "heatCapacity": { "$ref": "#/definitions/equipment/properties/structurePoints" },
          "systemSlots": { "$ref": "#/definitions/equipment/properties/structurePoints" },
          "moduleSlots": { "$ref": "#/definitions/equipment/properties/structurePoints" },
          "cargoCapacity": { "$ref": "#/definitions/equipment/properties/structurePoints" },
          "techLevel": {
            "anyOf": [
              { "type": "integer", "minimum": 0 },
              { "type": "string", "const": "B" },
              { "type": "string", "const": "N" }
            ]
          },
          "salvageValue": { "$ref": "#/definitions/equipment/properties/structurePoints" },
          "actions": { "type": "array", "items": { "type": "string" } },
          "bonusPerTechLevel": {
            "type": "object",
            "properties": {
              "structurePoints": { "$ref": "#/definitions/equipment/properties/structurePoints" },
              "energyPoints": { "$ref": "#/definitions/equipment/properties/energyPoints" },
              "heatCapacity": { "$ref": "#/definitions/equipment/properties/heatCapacity" },
              "systemSlots": { "$ref": "#/definitions/equipment/properties/systemSlots" },
              "moduleSlots": { "$ref": "#/definitions/equipment/properties/moduleSlots" },
              "cargoCapacity": { "$ref": "#/definitions/equipment/properties/cargoCapacity" },
              "techLevel": { "$ref": "#/definitions/equipment/properties/techLevel" },
              "salvageValue": { "$ref": "#/definitions/equipment/properties/salvageValue" }
            },
            "additionalProperties": false
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "$ref": "#/definitions/equipment/properties/id" },
                "name": { "$ref": "#/definitions/equipment/properties/name" },
                "content": { "$ref": "#/definitions/equipment/properties/content" },
                "rollTable": { "type": "string" },
                "schemaEntities": { "type": "array", "items": { "type": "string" } },
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "abilities",
                      "ability-tree-requirements",
                      "bio-titans",
                      "chassis",
                      "classes",
                      "crawler-bays",
                      "crawler-tech-levels",
                      "crawlers",
                      "creatures",
                      "distances",
                      "drones",
                      "equipment",
                      "keywords",
                      "factions",
                      "meld",
                      "modules",
                      "npcs",
                      "roll-tables",
                      "squads",
                      "systems",
                      "traits",
                      "vehicles"
                    ]
                  }
                },
                "customSystemOptions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "structurePoints": {
                        "$ref": "#/definitions/equipment/properties/structurePoints"
                      },
                      "energyPoints": { "$ref": "#/definitions/equipment/properties/energyPoints" },
                      "heatCapacity": { "$ref": "#/definitions/equipment/properties/heatCapacity" },
                      "systemSlots": { "$ref": "#/definitions/equipment/properties/systemSlots" },
                      "moduleSlots": { "$ref": "#/definitions/equipment/properties/moduleSlots" },
                      "cargoCapacity": {
                        "$ref": "#/definitions/equipment/properties/cargoCapacity"
                      },
                      "techLevel": { "$ref": "#/definitions/equipment/properties/techLevel" },
                      "salvageValue": {
                        "$ref": "#/definitions/equipment/properties/structurePoints"
                      },
                      "slotsRequired": {
                        "$ref": "#/definitions/equipment/properties/structurePoints"
                      },
                      "recommended": { "type": "boolean" },
                      "count": { "$ref": "#/definitions/equipment/properties/structurePoints" },
                      "actions": { "type": "array", "items": { "type": "string" } }
                    },
                    "required": ["techLevel", "salvageValue", "slotsRequired", "actions"],
                    "additionalProperties": false
                  }
                },
                "setIndexable": { "type": "boolean" },
                "multiSelect": {
                  "type": "boolean",
                  "description": "If true, this choice can be selected multiple times"
                },
                "choiceOptions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": { "type": "string" },
                      "value": { "type": "string" },
                      "description": { "type": "string" }
                    },
                    "required": ["label", "value"],
                    "additionalProperties": false
                  },
                  "description": "Structured options for this choice (similar to actionOptions)"
                },
                "constraints": {
                  "type": "object",
                  "properties": {
                    "field": { "type": "string" },
                    "min": { "$ref": "#/definitions/equipment/properties/structurePoints" },
                    "max": { "$ref": "#/definitions/equipment/properties/structurePoints" }
                  },
                  "additionalProperties": false
                }
              },
              "required": ["id", "name"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "name", "source", "page", "techLevel", "actions"],
        "additionalProperties": false
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}
