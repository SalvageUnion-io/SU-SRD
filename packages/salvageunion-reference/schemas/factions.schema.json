{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salvageunion.com/schemas/factions.schema.json",
  "title": "factions",
  "description": "",
  "type": "array",
  "items": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "asset_url": { "type": "string", "format": "uri" },
      "content": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "default": "paragraph",
              "type": "string",
              "enum": ["paragraph", "heading", "list-item", "label", "datavalues", "hint", "flavor"]
            },
            "value": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                      "value": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                      "type": { "type": "string" }
                    },
                    "required": ["label"],
                    "additionalProperties": false
                  },
                  "description": "Array of data values when type is 'datavalues'"
                }
              ]
            },
            "label": { "type": "string" },
            "level": { "type": "integer", "minimum": 1, "maximum": 6 },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "default": "paragraph",
                    "type": "string",
                    "enum": [
                      "paragraph",
                      "heading",
                      "list-item",
                      "label",
                      "datavalues",
                      "hint",
                      "flavor"
                    ]
                  },
                  "value": {
                    "anyOf": [
                      { "type": "string" },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                            "value": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                            "type": { "type": "string" }
                          },
                          "required": ["label"],
                          "additionalProperties": false
                        },
                        "description": "Array of data values when type is 'datavalues'"
                      }
                    ]
                  },
                  "label": { "type": "string" },
                  "level": { "type": "integer", "minimum": 1, "maximum": 6 }
                },
                "required": ["type"],
                "additionalProperties": false
              }
            }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      },
      "id": { "type": "string" },
      "indexable": { "default": true, "type": "boolean" },
      "blackMarket": { "default": false, "type": "boolean" },
      "name": { "type": "string", "minLength": 1 },
      "source": {
        "type": "string",
        "enum": [
          "Salvage Union Workshop Manual",
          "Mech Monday",
          "We Were Here First!",
          "Rainmaker",
          "False Flag"
        ]
      },
      "page": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
      "goals": { "type": "string", "description": "The goals and motivations of this faction" },
      "assets": {
        "type": "string",
        "description": "The assets and resources controlled by this faction"
      },
      "weaknesses": {
        "type": "string",
        "description": "The weaknesses and vulnerabilities of this faction"
      },
      "formation": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "chassis": { "type": "string" },
            "pattern": { "type": "string" },
            "schema": {
              "type": "string",
              "enum": [
                "abilities",
                "ability-tree-requirements",
                "bio-titans",
                "chassis",
                "classes",
                "crawler-bays",
                "crawler-tech-levels",
                "crawlers",
                "creatures",
                "distances",
                "drones",
                "equipment",
                "guides",
                "keywords",
                "factions",
                "meld",
                "modules",
                "npcs",
                "roll-tables",
                "squads",
                "systems",
                "traits",
                "vehicles"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "Salvage Union Workshop Manual",
                "Mech Monday",
                "We Were Here First!",
                "Rainmaker",
                "False Flag"
              ]
            },
            "page": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
            "quantity": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
          },
          "required": ["chassis", "source", "page"],
          "additionalProperties": false
        },
        "description": "The mechs that make up this faction formation"
      }
    },
    "required": [
      "id",
      "indexable",
      "blackMarket",
      "name",
      "source",
      "page",
      "goals",
      "assets",
      "weaknesses"
    ],
    "additionalProperties": false
  }
}
