    "lucide-react": "^1.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "salvageunion-reference": "workspace:*",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@ladle/react": "^5.1.1",
    "@randsum/roller": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
