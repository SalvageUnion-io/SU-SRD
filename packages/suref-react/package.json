  "exports": {
    ".": "./src/index.ts",
    "./styles/theme.css": "./src/styles/theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write . && prettier --write '**/*.md' --ignore-unknown --log-level=warn",
    "format:check": "biome format . && prettier --check '**/*.md' --ignore-unknown --log-level=warn",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:watch": "bun test --watch",
    "ladle": "ladle serve",
    "ladle:build": "ladle build"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.2.0",
    "@randsum/roller": "^2.0.0",
    "class-variance-authority": "^0.7.1",
