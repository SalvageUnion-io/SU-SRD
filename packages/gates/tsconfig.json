{
  // The gates' library: what `tools/`' entry points and the apps' e2e suites
  // import. A referenced library: declarations only, into the gitignored
  // .tsbuild/ (see the root tsconfig.json).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "../../.tsbuild/gates",
    "tsBuildInfoFile": "../../.tsbuild/gates/tsconfig.tsbuildinfo"
  },
  "include": ["lib/**/*.ts", "rules/**/*.ts", "__tests__/**/*.ts"],
  "references": [{ "path": "../salvageunion-reference" }]
}
