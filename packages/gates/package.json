{
  "name": "gates",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "exports": {
    "./a11y": {
      "types": "./lib/a11yScan.ts",
      "default": "./lib/a11yScan.ts"
    },
    "./ports": {
      "types": "./lib/ports.ts",
      "default": "./lib/ports.ts"
    },
    "./lib/*": {
