      "default": "./rules/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "bun test --parallel=4 --no-isolate"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "oxc-parser": "0.143.0",
    "salvageunion-reference": "workspace:*"
  }
