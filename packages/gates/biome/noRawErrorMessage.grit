// `err instanceof Error ? err.message : fallback` puts whatever was thrown on
// screen. For a Convex write that is the redacted `[CONVEX M(fn)] … Server
// Error`, and for a client bug a developer's string; and catching it is what
// kept the defect from being reported. A refusal the server meant for the
// player is a `ConvexError`, which this does not even read.
//
// Run the write through `useServerAction`, or say its failure with
// `failureMessage(err, fallback)` (both `apps/web/src/lib/connection/
// useServerAction.ts`): the server's words for a refusal, the store's for a
// blocked write, the caller's line and a report for anything else.
language js(typescript, jsx)

`$err instanceof Error ? $err.message : $_` as $expr where {
  register_diagnostic(span=$expr, message="Do not show a caught error's own message. Use useServerAction, or failureMessage(err, fallback), from lib/connection/useServerAction.ts: a refusal says the server's words, a defect says your fallback and is reported.", severity="error")
}
