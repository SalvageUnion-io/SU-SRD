// The Change Log is append-only and every write appends a row, so a read that
// `.collect()`s it grows all campaign until it meets Convex's per-query read
// limits. `changeLog.forEntity` did exactly that, then kept the newest 100.
// Read the newest N instead: `.order('desc').take(N)` off an index whose last
// column is `ts` (`by_entity_state_ts`, `by_game_field`, `by_game_source_ts`).
//
// Matches `.collect()` on any chain rooted at `.query('changeLog')`; a query
// bound to a local first evades it.
language js(typescript, jsx)

`$chain.collect()` as $call where {
  $chain <: contains or {
    `$db.query('changeLog')`,
    `$db.query("changeLog")`
  },
  register_diagnostic(span=$call, message="Do not collect the Change Log: it grows without limit. Read the newest rows with .order('desc').take(N) off an index ending in ts.", severity="error")
}
