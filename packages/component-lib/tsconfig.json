{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "bun-types"],

    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "customConditions": ["development"],
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx"
  },
  // `vite.config.ts` and `.ladle/components.tsx` sat outside this include, so
  // neither was type-checked. `.ladle/components.tsx` is not incidental: it is
  // the Suspense/preload gate every story renders behind, and a break there
  // blanks the whole catalog.
  "include": ["src", "test", "vite.config.ts", ".ladle/**/*"]
}
