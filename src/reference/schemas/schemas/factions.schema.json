{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salvageunion.com/schemas/factions.schema.json",
  "title": "factions",
  "description": "",
  "type": "array",
  "items": {
    "$ref": "#/definitions/factions",
    "definitions": {
      "factions": {
        "type": "object",
        "properties": {
          "asset_url": {
            "type": "string",
            "format": "uri"
          },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["paragraph", "heading", "list-item", "label", "datavalues", "hint"],
                  "default": "paragraph"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": ["string", "number"]
                          },
                          "value": {
                            "type": ["string", "number"]
                          },
                          "type": {
                            "type": "string"
                          }
                        },
                        "required": ["label"],
                        "additionalProperties": false
                      },
                      "description": "Array of data values when type is 'datavalues'"
                    }
                  ]
                },
                "label": {
                  "type": "string"
                },
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "$ref": "#/definitions/factions/properties/content/items/properties/type",
                        "default": "paragraph"
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {
                              "$ref": "#/definitions/factions/properties/content/items/properties/value/anyOf/1/items"
                            },
                            "description": "Array of data values when type is 'datavalues'"
                          }
                        ]
                      },
                      "label": {
                        "type": "string"
                      },
                      "level": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 6
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "id": {
            "type": "string"
          },
          "indexable": {
            "type": "boolean",
            "default": true
          },
          "blackMarket": {
            "type": "boolean",
            "default": false
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "Salvage Union Workshop Manual",
              "Mech Monday",
              "We Were Here First!",
              "Rainmaker",
              "False Flag"
            ]
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "goals": {
            "type": "string",
            "description": "The goals and motivations of this faction"
          },
          "assets": {
            "type": "string",
            "description": "The assets and resources controlled by this faction"
          },
          "weaknesses": {
            "type": "string",
            "description": "The weaknesses and vulnerabilities of this faction"
          },
          "formation": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "chassis": {
                  "type": "string"
                },
                "pattern": {
                  "type": "string"
                },
                "source": {
                  "$ref": "#/definitions/factions/properties/source"
                },
                "page": {
                  "$ref": "#/definitions/factions/properties/page"
                },
                "quantity": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "required": ["chassis", "pattern", "source", "page"],
              "additionalProperties": false
            },
            "description": "The mechs that make up this faction formation"
          }
        },
        "required": ["id", "name", "source", "page", "goals", "assets", "weaknesses"],
        "additionalProperties": false
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}
