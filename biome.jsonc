// Biome is the repo's single formatter and linter. It does not parse Markdown
// or YAML (https://biomejs.dev/internals/language-support/), so **/*.md and
// **/*.{yml,yaml} are formatted by nothing — the accepted trade for a
// single-formatter toolchain; add a step in lefthook.yml if Biome ships those
// formatters. The salvageunion-reference generators shell out to this same
// pinned Biome binary (packages/salvageunion-reference/tools/formatWithBiome.ts),
// so generated output cannot drift from `bun run check biome`.
{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "root": true,
  // Rules Biome has no built-in for, written in GritQL. Each file states what
  // it matches and why.
  "plugins": [
    "./packages/gates/biome/noModelFindByKey.grit",
    // Shipped source in every workspace: `apps/*/src` and `packages/*/src`
    // match a new workspace without anyone listing it. Tests and
    // test bootstraps run after a preload, so module-scope access is safe there.
    // A plugin's `includes` is matched against the file's absolute path (unlike
    // `files.includes`), so every positive glob needs its leading `**/`: a bare
    // `apps/*/src/**` matches nothing and the rule silently checks no file.
    {
      "path": "./packages/gates/biome/noModuleScopeReferenceCall.grit",
      "includes": [
        "**/apps/*/src/**",
        "**/packages/*/src/**",
        "**/packages/salvageunion-reference/lib/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**",
        "!**/test/**",
        "!**/e2e/**",
        "!**/generated/**"
      ]
    },
    {
      "path": "./packages/gates/biome/noInlinePoolDefault.grit",
      "includes": [
        "**/apps/*/src/**",
        "**/packages/*/src/**",
        "**/packages/salvageunion-reference/lib/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**",
        "!**/test/**",
        "!**/e2e/**",
        "!**/generated/**"
      ]
    },
    {
      "path": "./packages/gates/biome/noBareCleanupHook.grit",
      "includes": ["**/*.test.ts", "**/*.test.tsx"]
    },
    {
      "path": "./packages/gates/biome/noTestReferencePreload.grit",
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        // Each of these asserts on load behaviour itself: it resets the ORM
        // and re-preloads on purpose, so the shared preload is the thing under
        // test rather than the thing being duplicated.
        // Convex functions run on only the schemas the deployment installs.
        "!**/apps/web/test/convex/__tests__/referenceSubset.test.ts",
        // The preload API is the unit under test.
        "!**/packages/salvageunion-reference/lib/__tests__/preload.test.ts",
        // preload() invalidates the search index and result cache.
        "!**/packages/salvageunion-reference/lib/__tests__/search.test.ts"
      ]
    },
    {
      "path": "./packages/gates/biome/noLiveClockFixture.grit",
      "includes": [
        "**/apps/web/src/**/*.test.ts",
        "**/apps/web/src/**/*.test.tsx",
        "**/apps/web/test/**/*.test.ts"
      ]
    },
    {
      "path": "./packages/gates/biome/noPartialModelPatch.grit",
      "includes": ["**/*.test.ts", "**/*.test.tsx"]
    },
    {
      // Convex functions only: a test reads its own handful of fixture rows.
      "path": "./packages/gates/biome/noChangeLogCollect.grit",
      "includes": ["**/apps/web/convex/**", "!**/_generated/**"]
    },
    {
      // The app's client, where a caught error's text reaches a player. A test
      // asserts on messages; the route error screen's dump is development-only
      // and is for the developer.
      "path": "./packages/gates/biome/noRawErrorMessage.grit",
      "includes": [
        "**/apps/web/src/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**",
        "!**/apps/web/src/components/shared/RouteErrors.tsx"
      ]
    }
  ],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**",
      "packages/**",
      "tools/**",
      // Agent worktrees are full checkouts, each carrying its own copy of THIS
      // file with `"root": true`. Biome 2.5+ hard-errors on a nested root
      // config, and that discovery walk is independent of the includes above —
      // so without this line `bun run lint` (and therefore `check`) exits 1
      // from the repo root of any checkout that holds an agent worktree. CI
      // (fresh checkout) and pre-commit (explicit staged paths don't trigger
      // discovery) never see it. Bare `!.claude` is the form Biome itself
      // prescribes for ignoring a folder; `!.claude/**` also works but emits a
      // warning.
      "!.claude",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      // `wrangler dev` writes its bundled Worker — plus the miniflare error
      // middleware it injects — into `.wrangler/tmp/`: generated JS nobody
      // wrote. Biome does NOT read `.gitignore` (there is no `vcs` block in
      // this file), so it has to be said here too, or `bun run lint` passes or
      // fails depending on whether someone happens to have a server up.
      "!**/.wrangler",
      "!**/.vite",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.tsbuildinfo",
      "!**/routeTree.gen.ts",
      // `wrangler types` output, diffed by `bun run check generated`.
      "!**/worker-configuration.d.ts",
      // Generated by apps/web/ssg/genNavCatalog.ts and committed (so tests and
      // the dev server work without a build). Formatting it would make the
      // committed copy differ from what the generator emits, which is exactly
      // what ssg/__tests__/navCatalog.drift.test.ts asserts against.
      "!apps/web/src/generated",
      // srd's `/greembeem` easter egg, a Wikipedia pastiche. It is a
      // byte-for-byte build artefact — its dead `href="#"` anchors and
      // `role="button"` edit links ARE the page — and formatting it would
      // change what ships.
      "!apps/web/public/greembeem",
      "!**/convex/_generated",
      "!packages/salvageunion-reference/lib/generated",
      // Game-data JSON is crawler-sourced; AGENTS.md's "Data Conventions"
      // section forbids automated formatters reformatting these arrays.
      // Biome's JSON formatter collapses crawler-authored multi-line arrays
      // (packages/salvageunion-reference/data/actions.json, for one), so keep
      // this directory out of scope entirely.
      "!packages/salvageunion-reference/data",
      "!apps/web/package.json",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        // Import order, fixed mechanically. Blank lines between groups are
        // preserved by the formatter.
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":BUN:",
              ":NODE:",
              [":PACKAGE_WITH_PROTOCOL:", ":URL:"],
              ":PACKAGE:",
              ":ALIAS:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "formatter": {
      // Single quotes, as in JS (Biome's CSS default is double quotes).
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "warn",
        "useIterableCallbackReturn": "warn",
        "noAssignInExpressions": "warn",
        // An empty block is either a mistake or a decision with no reason
        // written down, and in a `catch` it is an error nobody will ever hear
        // about. A block holding only a comment passes, so the
        // fix for a deliberate one is to say why. Off for tests via
        // an override below, where `() => {}` is the idiom for a no-op prop.
        "noEmptyBlockStatements": "error"
      },
      "style": {
        // House rule: "Prefer `type` over `interface` for object types (unless
        // extending)". The explicit `style: "type"` option is load-bearing —
        // Biome's DEFAULT for this rule is the opposite direction ("interface").
        //
        // Genuine, permanent exemptions (module augmentation and declaration
        // merging REQUIRE `interface`; `type` cannot express either) are listed
        // as overrides at the bottom of this file, not suppressed per-line.
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        },
        // House rule: "Import types with `import type` syntax", in one shape:
        // a separate `import type { … }` statement, never an inline `{ type X }`.
        "useImportType": {
          "level": "error",
          "options": { "style": "separatedType" }
        },
        // "Named exports everywhere except route components" (root AGENTS.md's
        // code conventions) is enforced here, not by prose.
        //
        // The exemptions are real framework contracts, not preferences:
        // TanStack Router route modules are read as a default export.
        // Cloudflare Workers and the Convex http router are the same shape. All are listed as
        // overrides at the bottom rather than suppressed per-file.
        "noDefaultExport": "error",
        // Prefer `const` over `let` where never reassigned, and template
        // literals over string concatenation — both auto-fixable, both
        // currently drifting quietly.
        "useConst": "error",
        "useTemplate": "error",
        // A warning is invisible to every gate (`bun run lint` exits 0 on
        // one), so a recommended rule that defaults to "warn" and holds at zero
        // is an error here. useComponentExportOnlyModules, the other, is set
        // in apps/web's override below.
        "noDescendingSpecificity": "error",
        "noParameterAssign": "error",
        "useSelfClosingElements": "error",
        "useShorthandFunctionType": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              // ADR-013 (CSP-compliant Zod / jitless parsing): all Zod usage
              // must flow through packages/salvageunion-reference/lib/zod.ts,
              // which calls z.config({ jitless: true }) before any schema is
              // constructed. A direct `import { z } from 'zod'` bypasses that
              // config and can reintroduce a `new Function`-based CSP
              // violation in the browser. Re-stated (not inherited) in the
              // per-package overrides below wherever those need additional
              // paths — Biome overrides replace a rule's options for matched
              // files rather than merging into the root config.
              "zod": "Import `z` from 'salvageunion-reference/zod' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses).",
              "react": {
                "importNames": ["forwardRef"],
                "message": "React 19 passes `ref` as an ordinary prop: type it with ComponentPropsWithRef<…> (or `ref?: Ref<T>`) and take it from props. forwardRef is slated for deprecation."
              }
            },
            "patterns": [
              {
                "group": ["@/*"],
                "message": "Use relative imports instead of @/ path aliases."
              },
              // A workspace package's PUBLIC SURFACE is its entry point, and
              // nothing enforced that. knip's `includeEntryExports` gate only
              // sees the barrel, so a deep import both bypasses the one gate
              // that would notice an export rotting and couples the importer to
              // the package's internal file layout. There are ZERO deep imports
              // in the tree today — this keeps it that way rather than cleaning
              // it up later.
              //
              // The package's declared subpath exports are `/rules`, `/zod` and
              // `/testing` (test code only), plus the committed `/data/*` and
              // `/schemas/*` files, which srd's JSON API serves verbatim.
              {
                "group": ["salvageunion-reference/lib/**"],
                "message": "Import from 'salvageunion-reference' or a declared subpath export ('/rules', '/zod', or '/testing' from test code) — never a path inside the package."
              }
            ]
          }
        }
      },
      // Errors, not warnings: a warning is invisible to every gate (`bun run
      // lint` exits 0 while printing one). A genuinely-correct idiom that trips
      // one of these gets a per-site `biome-ignore` WITH a reason (see
      // StatProvenance / parseTraitReferences), not a downgrade back to "warn".
      "a11y": {
        "useButtonType": "error",
        "useSemanticElements": "error",
        "useAriaPropsSupportedByRole": "error",
        "noStaticElementInteractions": "error",
        "noSvgWithoutTitle": "error",
        "noAriaHiddenOnFocusable": "error",
        "noAutofocus": "error",
        "useFocusableInteractive": "error",
        "useAriaPropsForRole": "error",
        "useKeyWithClickEvents": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useJsxKeyInIterable": "error",
        "noUnsafeOptionalChaining": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      }
    },
    "domains": {
      "react": "recommended"
    }
  },
  "overrides": [
    {
      // Function-size ratchet for the app and its Convex backend. The cap is
      // the current largest body, so one more line there, or any longer
      // function anywhere, fails. Biome counts the whole function without
      // comment lines. Lower it when a split lands; never raise it.
      "includes": ["apps/web/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 460 } }
          }
        }
      }
    },
    {
      // A no-op callback (`onChange={() => {}}`, `mock(() => {})`) is the whole
      // point in a test, so `noEmptyBlockStatements` — which exists
      // to catch swallowed errors in shipped code — is off here.
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**", "**/test/**", "**/e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlockStatements": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "warn",
              "options": {
                "allow": ["warn", "error"]
              }
            }
          }
        }
      }
    },
    {
      // Fast Refresh hot-swaps a module only when it exports nothing but
      // components. The static page's own trees are framework contracts (a
      // page module, an island's prepare hook, the SSG), rendered once per
      // build, and stay out.
      "includes": [
        "apps/web/**",
        "!apps/web/ssg/**",
        "!apps/web/src/reference/pages/**",
        "!apps/web/src/reference/endpoints/**",
        "!apps/web/src/runtime/**",
        "!apps/web/src/components/islands/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "error"
          }
        }
      }
    },
    {
      // The other legitimate default-export contracts, each read by a framework
      // rather than imported by us: TanStack Router route modules, Cloudflare
      // Worker entrypoints, the Convex http router, schema and cron table, and
      // build/test config files. Listed here so the rule stays `error`
      // everywhere else.
      "includes": [
        "apps/web/src/routes/**",
        // workerd reads `export default { fetch }` — the module IS the contract.
        // Each entry location is named
        // explicitly rather than globbing `src/**`, so an ordinary module in the
        // same app cannot quietly acquire a default export under this exemption.
        // This glob is the `main` of every wrangler config (the `workers`
        // check holds them to it).
        "apps/*/src/worker/index.ts",
        "apps/web/convex/http.ts",
        "apps/web/convex/crons.ts",
        "apps/web/convex/schema.ts",
        "**/*.config.ts",
        // Ambient module declarations for asset imports (`declare module
        // '*.md?raw'`) must re-declare the bundler's own default export — the
        // shape is dictated by Vite, not chosen.
        "**/*.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // A static page: what the SSG renders and the islands it hydrates. It
      // ships at most 20 KB of JS, so it never imports the Cantina's router,
      // stores or shell, or Convex. A relative import does not say what it
      // reaches, so the rule names those folders; `reference-bundle-budget.e2e.ts` and
      // the Vite pass's chunk groups (`ssg/appGraph.ts`) catch what a shared
      // component pulls in further down.
      //
      // The root rule's paths/patterns are RESTATED here because Biome
      // overrides REPLACE a rule's options for matched files rather than
      // merging — see the note at the root declaration.
      "includes": [
        "apps/web/ssg/**",
        "apps/web/src/reference/**",
        "apps/web/src/runtime/**",
        "apps/web/src/components/islands/**",
        "!apps/web/ssg/cantinaPlugins.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import `z` from 'salvageunion-reference/zod' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses).",
                  "react": {
                    "importNames": ["forwardRef"],
                    "message": "React 19 passes `ref` as an ordinary prop: type it with ComponentPropsWithRef<…> (or `ref?: Ref<T>`) and take it from props. forwardRef is slated for deprecation."
                  },
                  "@tanstack/react-router": "A static page never routes: it links with a plain href.",
                  "convex/react": "A static page never talks to Convex: it reads the reference data it was built from.",
                  "convex/browser": "A static page never talks to Convex: it reads the reference data it was built from.",
                  "zustand": "A static page holds no store; an island keeps its state in React."
                },
                "patterns": [
                  {
                    "group": ["@/*"],
                    "message": "Use relative imports instead of @/ path aliases."
                  },
                  {
                    "group": ["salvageunion-reference/lib/**"],
                    "message": "Import from 'salvageunion-reference' or a declared subpath export — never a path inside the package."
                  },
                  {
                    "group": [
                      "**/convex/**",
                      "**/routes/**",
                      "**/stores/**",
                      "**/shell/**",
                      "**/main"
                    ],
                    "message": "A static page never imports Convex or the Cantina's routes, stores, shell or entry: they would ship on every page, past its 20 KB budget."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The display layer draws whatever data it is handed: only the product
      // folders (sheet/, games/, …) wire the stores or Convex
      // (apps/web/src/components/CLAUDE.md). Restates the root rule's options
      // in full: Biome overrides REPLACE a rule's options.
      "includes": [
        "apps/web/src/components/{atoms,containers,compositions,entity,referenceEntity,catalog,markdownSection}/**",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import `z` from 'salvageunion-reference/zod' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses).",
                  "react": {
                    "importNames": ["forwardRef"],
                    "message": "React 19 passes `ref` as an ordinary prop: type it with ComponentPropsWithRef<…> (or `ref?: Ref<T>`) and take it from props. forwardRef is slated for deprecation."
                  },
                  "convex/react": "The display layer takes its data as props; a product folder wires Convex.",
                  "convex/browser": "The display layer takes its data as props; a product folder wires Convex.",
                  "zustand": "The display layer takes its data as props; a product folder wires the stores."
                },
                "patterns": [
                  {
                    "group": ["@/*"],
                    "message": "Use relative imports instead of @/ path aliases."
                  },
                  {
                    "group": ["salvageunion-reference/lib/**"],
                    "message": "Import from 'salvageunion-reference' or a declared subpath export — never a path inside the package."
                  },
                  {
                    "group": ["**/convex/**", "**/stores/**"],
                    "message": "The display layer takes its data as props; a product folder wires the stores and Convex."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Every Convex mutation is built through `convex/model/entities.ts`, whose
      // `mutation` / `internalMutation` run the database triggers that keep
      // `games.summary` current. A mutation built from the generated builders
      // writes without them, and the Games list badge for whatever it touched
      // is then wrong until the next backfill — silently. That file is the one
      // place allowed to import the raw builders, because it wraps them.
      //
      // Restates the root rule's options in full: Biome overrides
      // REPLACE a rule's options for matched files rather than merging.
      "includes": ["apps/web/convex/**", "!apps/web/convex/model/entities.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import `z` from 'salvageunion-reference/zod' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses).",
                  "react": {
                    "importNames": ["forwardRef"],
                    "message": "React 19 passes `ref` as an ordinary prop: type it with ComponentPropsWithRef<…> (or `ref?: Ref<T>`) and take it from props. forwardRef is slated for deprecation."
                  },
                  "./_generated/server": {
                    "importNames": ["mutation", "internalMutation"],
                    "message": "Build mutations with `mutation` / `internalMutation` from './model/entities', which run the triggers that keep games.summary current."
                  },
                  "../_generated/server": {
                    "importNames": ["mutation", "internalMutation"],
                    "message": "Build mutations with `mutation` / `internalMutation` from './entities', which run the triggers that keep games.summary current."
                  }
                },
                "patterns": [
                  {
                    "group": ["@/*"],
                    "message": "Use relative imports instead of @/ path aliases."
                  },
                  {
                    "group": ["salvageunion-reference/lib/**"],
                    "message": "Import from 'salvageunion-reference' or a declared subpath export — never a path inside the package."
                  },
                  {
                    "group": ["**/src/**"],
                    "message": "Convex never imports the client (apps/web/src): shared logic lives in cantina-domain or salvageunion-reference (`check rules-home`)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    // -------------------------------------------------------------------
    // Architecture invariants that map onto Biome's
    // configurable rules. The ones it has no rule for (no module-scope
    // SalvageUnionReference call, no inlined pool default) are the GritQL
    // plugins declared at the top of this file.
    // -------------------------------------------------------------------
    {
      // ADR-013: no app/package outside the canonical module may import zod
      // directly. salvageunion-reference gets an extra restriction on top:
      // it must never import from apps/* (one-way dependency rule, see
      // docs/ARCHITECTURE.md#packages). Restates the root `zod` path + `@/*`
      // pattern because overrides replace (not merge into) a rule's options
      // for matched files.
      "includes": ["packages/salvageunion-reference/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import `z` from './zod.js' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses)."
                },
                "patterns": [
                  {
                    "group": ["@/*"],
                    "message": "Use relative imports instead of @/ path aliases."
                  },
                  {
                    "group": ["**/apps/**"],
                    "message": "salvageunion-reference must never import from apps/* — the dependency flows one way (docs/ARCHITECTURE.md#packages)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The one file allowed to import zod directly — it's the canonical
      // module ADR-013 requires everything else to route through. Listed
      // after the package-wide override above so this narrower, later match
      // wins for this one file (Biome overrides apply in order; a later
      // override replaces an earlier one's config for the same rule on
      // files both match).
      "includes": ["packages/salvageunion-reference/lib/zod.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      // PERMANENT exemption from useConsistentTypeDefinitions. Every file here
      // declares a `declare global { interface … }` module augmentation, which
      // is the ONE thing `type` cannot express: declaration merging into an
      // existing interface (`Window`, TanStack Router's
      // `Register`) requires the `interface` keyword by language rule, not by
      // preference. Rewriting any of these as `type` is a compile error, so
      // this list is a statement of fact, not a burn-down.
      //
      // `**/*.d.ts` is exempted by the separate last override.
      "includes": [
        "apps/web/src/main.tsx",
        "apps/web/src/components/islands/OgCardIsland.tsx",
        "apps/web/src/components/atoms/KofiButton.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    },
    {
      // Test modules: two relaxations.
      //
      // `noExplicitAny` stays "error" for real source; tests may use `any` for
      // mocking (`as any` casts), so it is "warn" here.
      //
      // `useComponentExportOnlyModules` is a React Fast Refresh heuristic: it
      // wants a module to export only components so the dev server can hot-swap
      // it. Test modules are never Fast Refresh boundaries — they run under the
      // test runner, not the dev server — so a test declaring a local harness
      // component alongside its cases is not the problem the rule exists to
      // catch.
      //
      // This sits AFTER the `apps/web/**` block
      // that sets that rule to "error", because Biome applies overrides in array
      // order and the later one wins: placed earlier, it would be overridden.
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "warn"
          },
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      // Ambient declarations extend globals by interface merging (`ImportMetaEnv`,
      // `ImportMeta` in the Vite env files), which a `type` alias cannot do.
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    }
  ]
}
