// Biome replaces ESLint + Prettier for JS/TS/TSX/JSON/CSS (see PR description
// for full migration notes). Two carve-outs stay on Prettier, both because
// Biome (as of 2.5.3) genuinely doesn't parse the language yet, not by
// preference — see https://biomejs.dev/internals/language-support/:
//   - Markdown & YAML: parsing/formatting "in development", not shipped.
//     Prettier still runs on **/*.md and **/*.{yml,yaml} (root scripts +
//     lefthook's format-prose command).
//   - Astro (apps/srd/src/**/*.astro): support landed in v2.3.0 but
//     is still explicitly "experimental" upstream. The OLD toolchain never
//     covered .astro either (no prettier-plugin-astro was installed, and
//     ESLint's srd config ignored *.astro outright) — so excluding it
//     here preserves the status quo (zero coverage) rather than opting into
//     an experimental linter/formatter for the first time in this PR.
{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "root": true,
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**",
      "packages/**",
      "tools/**",
      // Agent worktrees are full checkouts, each carrying its own copy of THIS
      // file with `"root": true`. Biome 2.5+ hard-errors on a nested root
      // config, and that discovery walk is independent of the includes above —
      // so without this line `bun run lint` / `format:check` (and therefore
      // `check:all`) exit 1 from the repo root for anyone who has ever used the
      // documented agent-worktree workflow. CI never saw it (fresh checkout,
      // no worktrees), pre-commit never saw it (explicit staged paths don't
      // trigger discovery), and pre-push doesn't run lint at all. Bare
      // `!.claude` is the form Biome itself prescribes for ignoring a folder;
      // `!.claude/**` also works but emits a warning.
      "!.claude",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/build-ladle",
      "!**/.netlify",
      "!**/.vite",
      "!**/.astro",
      "!**/.ladle",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.tsbuildinfo",
      "!**/routeTree.gen.ts",
      "!**/convex/_generated",
      "!packages/salvageunion-reference/lib/generated",
      // Generated API-surface snapshot (tools/generateApiReport.ts, drift-checked
      // in CI) — a raw declaration rollup, not hand-authored source.
      "!packages/salvageunion-reference/etc",
      // Game-data JSON is crawler-sourced; CLAUDE.md's "Data Conventions"
      // section forbids automated formatters reformatting these arrays
      // (`json.dump`-style tools reflow crawler-authored line breaks). Biome's
      // JSON formatter collapses some multi-line arrays that Prettier left
      // alone (verified: packages/salvageunion-reference/data/actions.json),
      // so keep this directory out of scope entirely, same as before.
      "!packages/salvageunion-reference/data",
      "!apps/srd/package.json",
      "!**/*.astro",
      "!**/*.md",
      "!**/*.mdx",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        // Import ORDER was the last big convention asserted by nobody and held
        // by nobody: 73 of 977 source files re-opened a bare-package import
        // after their first relative one, and two sibling `ActionsDeck.tsx`
        // files in the same feature disagreed with each other. No doc declared
        // an order, so there was nothing to violate — and this assist, which
        // fixes it mechanically, was switched off.
        //
        // Groups below are the order the ~93% majority already used. Blank
        // lines between groups are preserved by the formatter, so the result
        // reads the way the best files already do.
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":BUN:",
              ":NODE:",
              [":PACKAGE_WITH_PROTOCOL:", ":URL:"],
              ":PACKAGE:",
              ":ALIAS:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "css": {
    // Tailwind v4 CSS (@theme, @utility, @source, @plugin, @custom-variant)
    // used in apps/itun, apps/srd, packages/component-lib.
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      // Prettier's global singleQuote:true applied to CSS too; match it
      // (Biome's CSS default is double quotes).
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "warn",
        "useIterableCallbackReturn": "warn",
        "noAssignInExpressions": "warn"
      },
      "style": {
        // `.claude/rules/typescript-style.md`: "Prefer `type` over `interface`
        // for object types (unless extending)". That convention was asserted in
        // prose and enforced by nothing, so it held only where a reviewer
        // happened to look. Note the explicit `style: "type"` option — Biome's
        // DEFAULT for this rule is the opposite direction ("interface"), which
        // would flag ~613 correct `type X = { … }` declarations instead.
        //
        // Genuine, permanent exemptions (module augmentation and declaration
        // merging REQUIRE `interface`; `type` cannot express either) are listed
        // as overrides at the bottom of this file, not suppressed per-line.
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        },
        // `.claude/rules/typescript-style.md`: "Import types with `import type`
        // syntax". Same story as the rule above — asserted in prose, enforced
        // by nothing, so BOTH shapes survived: 225 files use a separate
        // `import type { … }` statement alongside a value import from the same
        // specifier, while ~100 sites inline `{ type X, Y }`. Neither is wrong;
        // having both for the same job is. `separatedType` is the majority
        // form and the one the rules doc's wording implies.
        "useImportType": {
          "level": "error",
          "options": { "style": "separatedType" }
        },
        // "Named exports everywhere except route components" (CLAUDE.md:165,
        // react-components.md:14) — stated three times at three strengths and
        // enforced by nothing. It turned out to be genuinely obeyed (0
        // violations outside the two legitimate exemptions below), which is
        // exactly why it is cheap to lock in now rather than after it drifts.
        //
        // The two exemptions are real framework contracts, not preferences:
        // TanStack Router route modules, and Ladle story `meta` — both are
        // read by their framework as a default export. Netlify Functions and
        // the Convex http router are the same shape. All are listed as
        // overrides at the bottom rather than suppressed per-file.
        "noDefaultExport": "error",
        // Prefer `const` over `let` where never reassigned, and template
        // literals over string concatenation — both auto-fixable, both
        // currently drifting quietly.
        "useConst": "error",
        "useTemplate": "error",
        "noParameterAssign": "error",
        "useSelfClosingElements": "error",
        "useShorthandFunctionType": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              // ADR-013 (CSP-compliant Zod / jitless parsing): all Zod usage
              // must flow through packages/salvageunion-reference/lib/zod.ts,
              // which calls z.config({ jitless: true }) before any schema is
              // constructed. A direct `import { z } from 'zod'` bypasses that
              // config and can reintroduce a `new Function`-based CSP
              // violation in the browser. Re-stated (not inherited) in the
              // per-package overrides below wherever those need additional
              // paths — Biome overrides replace a rule's options for matched
              // files rather than merging into the root config.
              "zod": "Import `z` from 'salvageunion-reference/zod' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses)."
            },
            "patterns": [
              {
                "group": ["@/*"],
                "message": "Use relative imports instead of @/ path aliases."
              }
            ]
          }
        }
      },
      //
      // --- Rules recommended-by-default in Biome that ESLint's ruleset never
      // covered (no eslint-plugin-react or matching jsx-a11y rule existed for
      // them) — downgraded from Biome's default "error" to "warn" so this
      // migration stays a tooling swap, not a lint-cleanup pass (see PR
      // description for the full rationale + per-rule finding counts). Each
      // stays visible (not "off") as a deliberate follow-up list, not silenced.
      //
      "a11y": {
        "useButtonType": "warn",
        "useSemanticElements": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn",
        "noAriaHiddenOnFocusable": "warn",
        "noAutofocus": "warn",
        "useFocusableInteractive": "warn",
        "useAriaPropsForRole": "warn",
        "useKeyWithClickEvents": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useJsxKeyInIterable": "warn",
        "noUnsafeOptionalChaining": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      }
    },
    "domains": {
      "react": "recommended"
    }
  },
  "overrides": [
    {
      // `noExplicitAny` stays "error" for real source, but ESLint's per-line
      // `// eslint-disable-next-line @typescript-eslint/no-explicit-any`
      // comments (~120, almost all in test-mock casts like `as any`) don't
      // translate to Biome's ignore syntax automatically. Rather than hand-
      // converting every comment, this consolidates the same intent (tests
      // may use `any` for mocking) into one pattern-level override.
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "warn"
          }
        }
      }
    },
    {
      // ESLint never covered these (see packages/salvageunion-reference/eslint.config.js
      // ignores: lib/*.template.ts, tools/**, examples/**), but Prettier did — that
      // package's .prettierignore only excludes dist/node_modules/.git/*.tsbuildinfo/
      // lib/generated. Keep formatting on, linting off, to match.
      "includes": [
        "packages/salvageunion-reference/lib/*.template.ts",
        "packages/salvageunion-reference/tools/**",
        "packages/salvageunion-reference/examples/**"
      ],
      "linter": {
        "enabled": false
      }
    },
    {
      // *.d.ts was ESLint-ignored repo-wide (root + salvageunion-reference configs
      // both list '**/*.d.ts') but never Prettier-ignored.
      "includes": ["**/*.d.ts"],
      "linter": {
        "enabled": false
      }
    },
    {
      // These live outside the app tsconfig project (own TS pipeline at
      // `playwright test` time), so ESLint skipped them; Prettier still
      // formatted them (only lib/generated + build-output dirs are
      // Prettier-ignored). Keep formatting on, linting off, to match.
      "includes": [
        "apps/itun/playwright.config.ts",
        "apps/itun/e2e/**",
        "apps/srd/playwright.config.ts",
        "apps/srd/e2e/**",
        "packages/component-lib/playwright.visual.config.ts",
        "packages/component-lib/vite.config.ts"
      ],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["apps/itun/**", "packages/component-lib/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "warn"
          },
          "suspicious": {
            "noConsole": {
              "level": "warn",
              "options": {
                "allow": ["warn", "error"]
              }
            }
          }
        }
      }
    },
    {
      // Ladle story files MUST export a `default` meta object alongside their
      // named story components — it is the required shape, not a smell. The
      // useComponentExportOnlyModules rule (a React Fast-Refresh guard) does
      // not apply to a static Ladle catalog, so it is disabled for stories
      // here rather than suppressed with a per-file `biome-ignore` on every
      // one of ~100 story files. This override sorts AFTER the block above
      // that enables the rule, so it wins for the matched paths.
      "includes": ["**/*.stories.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off",
            // Ladle reads a story file's `meta` as its DEFAULT export — this is
            // the framework's contract, not a style choice. All 107 of the
            // repo's `export default`s outside `src/routes/` are this.
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // The other legitimate default-export contracts, each read by a framework
      // rather than imported by us: TanStack Router route modules, Netlify
      // Functions handlers, the Convex http router and schema, and build/test
      // config files. Listed here so the rule stays `error` everywhere else.
      "includes": [
        "apps/itun/src/routes/**",
        "apps/*/netlify/functions/**",
        "apps/itun/convex/http.ts",
        "apps/itun/convex/schema.ts",
        "**/*.config.ts",
        "**/*.config.mts",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/playwright.config.ts",
        // Ambient module declarations for asset imports (`declare module
        // '*.md?raw'`) must re-declare the bundler's own default export — the
        // shape is dictated by Vite, not chosen.
        "**/*.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/srd/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "warn",
              "options": {
                "allow": ["warn", "error"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/itun/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    // -------------------------------------------------------------------
    // Architecture invariants (previously prose-only): the 3 of the 4 rules
    // that map onto Biome's existing configurable rules. See the PR
    // description for the full writeup, including why the 4th rule (no
    // module-scope SalvageUnionReference accessor calls,
    // docs/architecture/package-contracts.md's "Module-Scope ORM Call Risk")
    // is enforced by tools/check-architecture.ts instead — Biome's GritQL
    // plugin system couldn't be made to match the required two-level member
    // chain or reliably scope-exclude function-nested matches in this
    // version (2.5.3).
    // -------------------------------------------------------------------
    {
      // ADR-013: no app/package outside the canonical module may import zod
      // directly. salvageunion-reference gets an extra restriction on top:
      // it must never import from apps/* (one-way dependency rule, see
      // docs/architecture/package-contracts.md, "One-Way Dependency:
      // Reference Package → Apps"). Restates the root `zod` path + `@/*`
      // pattern because overrides replace (not merge into) a rule's options
      // for matched files.
      "includes": ["packages/salvageunion-reference/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import `z` from './zod.js' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses)."
                },
                "patterns": [
                  {
                    "group": ["@/*"],
                    "message": "Use relative imports instead of @/ path aliases."
                  },
                  {
                    "group": ["**/apps/**"],
                    "message": "salvageunion-reference must never import from apps/* — the dependency flows one way (docs/architecture/package-contracts.md, \"One-Way Dependency: Reference Package → Apps\")."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The one file allowed to import zod directly — it's the canonical
      // module ADR-013 requires everything else to route through. Listed
      // after the package-wide override above so this narrower, later match
      // wins for this one file (Biome overrides apply in order; a later
      // override replaces an earlier one's config for the same rule on
      // files both match).
      "includes": ["packages/salvageunion-reference/lib/zod.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      // ADR-010 ("the shared library never persists"): component-lib must stay
      // free of storage-layer imports. `idb` is ITUN's IndexedDB wrapper (see
      // docs/architecture/package-contracts.md's itun "Consumes"
      // list) — it doesn't belong in the shared component library. Zustand is
      // deliberately NOT blocked here: it's a state-management library, not
      // itself a storage layer (ADR-010's literal contract is "never
      // persists"), and component-lib doesn't use it today — blocking it would
      // be scope creep past what ADR-010 actually requires.
      // Restates the root `zod` path + `@/*` pattern (see note above).
      "includes": ["packages/component-lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import `z` from 'salvageunion-reference/zod' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses).",
                  "idb": "packages/component-lib must stay persistence-agnostic (ADR-010: \"the shared library never persists\") — persistence belongs in the consuming app (ITUN), passed down via props."
                },
                "patterns": [
                  {
                    "group": ["@/*"],
                    "message": "Use relative imports instead of @/ path aliases."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Same ADR-010 contract, for direct global storage API usage rather
      // than an import (e.g. `localStorage.setItem(...)` with no import
      // statement to catch).
      "includes": ["packages/component-lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "localStorage": "packages/component-lib must stay persistence-agnostic (ADR-010: \"the shared library never persists\") — persistence belongs in the consuming app.",
                  "sessionStorage": "packages/component-lib must stay persistence-agnostic (ADR-010: \"the shared library never persists\") — persistence belongs in the consuming app.",
                  "indexedDB": "packages/component-lib must stay persistence-agnostic (ADR-010: \"the shared library never persists\") — persistence belongs in the consuming app."
                }
              }
            }
          }
        }
      }
    },
    {
      // PERMANENT exemption from useConsistentTypeDefinitions. Every file here
      // declares a `declare global { interface … }` module augmentation, which
      // is the ONE thing `type` cannot express: declaration merging into an
      // existing interface (`Window`, discord.js's `Client`, TanStack Router's
      // `Register`) requires the `interface` keyword by language rule, not by
      // preference. Rewriting any of these as `type` is a compile error, so
      // this list is a statement of fact, not a burn-down.
      //
      // `**/*.d.ts` is listed even though an override far above already sets
      // `linter.enabled: false` for it. That override does NOT reach
      // apps/itun/src/vite-env.d.ts or apps/srd/src/env.d.ts: Biome applies
      // overrides in array order, and a LATER override that supplies a
      // `linter` object (the `apps/itun/**` and `apps/srd/**` blocks above)
      // resets `enabled` back to true for files it also matches. Verified with
      // `biome lint apps/itun/src/vite-env.d.ts` — 2 errors, not 0. The same
      // hazard silently re-enables linting for the reference package's
      // tools/**, e2e/** and playwright configs; enabling a new rule is not
      // the place to restructure that, so the affected paths are named
      // explicitly here and the ordering bug is left as its own fix.
      //
      // The three d.ts interfaces are ImportMetaEnv/ImportMeta, declaration-
      // merged with `vite/client` — augmentation again, so permanent.
      "includes": [
        "**/*.d.ts",
        "apps/discord-bot/src/events/interactionCreate.ts",
        "apps/itun/src/main.tsx",
        "apps/srd/src/components/islands/OgCardIsland.tsx",
        "packages/component-lib/src/components/shared/KofiButton.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    },
    {
      // Not an exemption from the convention — a restatement of one that
      // already exists. `packages/salvageunion-reference/tools/**` is
      // linter-disabled wholesale by an override above (it was never covered
      // by the old ESLint config either), but that override is reset for these
      // files by the later `packages/salvageunion-reference/**` block — the
      // same array-ordering hazard described in the override above. Without
      // this entry a brand-new rule would start reporting in a directory the
      // repo has decided not to lint at all.
      "includes": ["packages/salvageunion-reference/tools/**"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    },
    {
      // TEMPORARY burn-down — delete this whole override once the list is
      // empty. These are the last 9 non-augmentation `interface` declarations
      // in the repo; unlike the block above they CAN and SHOULD become `type`,
      // they just were not converted in the change that turned the rule on.
      // The rule is enabled repo-wide regardless, so no NEW `interface` can be
      // introduced anywhere while these are cleared:
      //
      //   lib/search.ts:37  SearchOptions           — public (re-exported from lib/index.ts)
      //   lib/search.ts:199 SearchResult            — public (re-exported from lib/index.ts)
      //   lib/ModelFactory.ts:202 EnhancedSchemaMetadata — public (re-exported from lib/index.ts)
      //   lib/preselectedChoices.test.ts — 6 test-local shapes
      //
      // None of the nine extends or is merged into anything, so each is a
      // mechanical `export interface X {` -> `export type X = {` swap. Converting
      // the three public ones changes the DECLARATION FORM in the generated
      // API report, so regenerate it: `bun run build:package` (CI fails on drift).
      "includes": [
        "packages/salvageunion-reference/lib/search.ts",
        "packages/salvageunion-reference/lib/ModelFactory.ts",
        "packages/salvageunion-reference/lib/preselectedChoices.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    }
  ]
}
