// Biome is the repo's SINGLE formatter and linter — ESLint and Prettier are
// both gone. Prettier's last two jobs were removed in the post-Astro
// streamline:
//   - As a CLI over **/*.md and **/*.{yml,yaml}. Biome still does not parse
//     either language (verified against 2.5.7: it returns .md/.yaml stdin
//     untouched — https://biomejs.dev/internals/language-support/), so those
//     files are now formatted by NOTHING. That is the accepted trade for a
//     single-formatter toolchain; restore a step in lefthook.yml if Biome
//     ships the formatters.
//   - As a LIBRARY inside the salvageunion-reference generators, which format
//     committed artifacts in-process. Those now shell out to this same pinned
//     Biome binary (packages/salvageunion-reference/tools/formatWithBiome.ts),
//     so generated output cannot drift from `format:check`. The swap was
//     byte-for-byte identical across all 66 declaration files and every
//     schema — the formatter settings below were already Prettier-equivalent.
// The second carve-out used to be Astro (apps/srd/src/**/*.astro), excluded
// because Biome's .astro support is experimental. apps/srd no longer contains
// any .astro files — it builds through the in-house SSG in apps/srd/ssg — so
// Biome now lints and formats every file in that app. That was one of the four
// stated goals of the Astro migration: 2,034 lines across 17 files had zero
// lint/format coverage under the old toolchain and are now covered.
{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "root": true,
  // Rules Biome has no built-in for, written in GritQL. Each file states what
  // it matches and why.
  "plugins": [
    "./tools/biome/noModelFindByKey.grit",
    // Shipped source in every workspace: `apps/*/src` and `packages/*/src`
    // match a new workspace without anyone listing it. Tests, stories and
    // test bootstraps run after a preload, so module-scope access is safe there.
    // A plugin's `includes` is matched against the file's absolute path (unlike
    // `files.includes`), so every positive glob needs its leading `**/`: a bare
    // `apps/*/src/**` matches nothing and the rule silently checks no file.
    {
      "path": "./tools/biome/noModuleScopeReferenceCall.grit",
      "includes": [
        "**/apps/*/src/**",
        "**/packages/*/src/**",
        "**/packages/salvageunion-reference/lib/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.stories.tsx",
        "!**/__tests__/**",
        "!**/test/**",
        "!**/e2e/**",
        "!**/generated/**"
      ]
    },
    {
      "path": "./tools/biome/noInlinePoolDefault.grit",
      "includes": [
        "**/apps/*/src/**",
        "**/packages/*/src/**",
        "**/packages/salvageunion-reference/lib/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.stories.tsx",
        "!**/__tests__/**",
        "!**/test/**",
        "!**/e2e/**",
        "!**/generated/**"
      ]
    },
    {
      "path": "./tools/biome/noBareCleanupHook.grit",
      "includes": ["**/*.test.ts", "**/*.test.tsx"]
    },
    {
      "path": "./tools/biome/noTestReferencePreload.grit",
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        // Each of these asserts on load behaviour itself: it resets the ORM
        // and re-preloads on purpose, so the shared preload is the thing under
        // test rather than the thing being duplicated.
        // Narrow schema lists render identically.
        "!**/apps/srd/src/lib/__tests__/schemaPreloadDeps.test.tsx",
        // Convex functions run on only the schemas the deployment installs.
        "!**/apps/itun/test/convex/referenceSubset.test.ts",
        // The preload API is the unit under test.
        "!**/packages/salvageunion-reference/lib/preload.test.ts",
        // preload() invalidates the search index and result cache.
        "!**/packages/salvageunion-reference/lib/search.test.ts"
      ]
    },
    {
      "path": "./tools/biome/noLiveClockFixture.grit",
      "includes": ["**/apps/itun/**/*.test.ts", "**/apps/itun/**/*.test.tsx"]
    },
    {
      "path": "./tools/biome/noPartialModelPatch.grit",
      "includes": ["**/*.test.ts", "**/*.test.tsx"]
    }
  ],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**",
      "packages/**",
      "tools/**",
      // Agent worktrees are full checkouts, each carrying its own copy of THIS
      // file with `"root": true`. Biome 2.5+ hard-errors on a nested root
      // config, and that discovery walk is independent of the includes above —
      // so without this line `bun run lint` / `format:check` (and therefore
      // `check`) exit 1 from the repo root for anyone who has ever used the
      // documented agent-worktree workflow. CI never saw it (fresh checkout,
      // no worktrees), pre-commit never saw it (explicit staged paths don't
      // trigger discovery), and pre-push doesn't run lint at all. Bare
      // `!.claude` is the form Biome itself prescribes for ignoring a folder;
      // `!.claude/**` also works but emits a warning.
      "!.claude",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/build-ladle",
      // `wrangler dev` writes its bundled Worker — plus the miniflare error
      // middleware it injects — into `.wrangler/tmp/`. That is generated JS
      // nobody wrote, and linting it produced 69 errors from a running dev
      // server. Biome does NOT read `.gitignore` (there is no `vcs` block in
      // this file), so ignoring it there is not enough; it has to be said here
      // too, or `bun run lint` passes or fails depending on whether someone
      // happens to have a server up.
      "!**/.wrangler",
      "!**/.vite",
      "!**/.ladle",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.tsbuildinfo",
      "!**/routeTree.gen.ts",
      // `wrangler types` output, diffed by `bun run check generated`.
      "!**/worker-configuration.d.ts",
      // Generated by apps/srd/ssg/genNavCatalog.ts and committed (so tests and
      // the dev server work without a build). Formatting it would make the
      // committed copy differ from what the generator emits, which is exactly
      // what ssg/__tests__/navCatalog.drift.test.ts asserts against.
      "!apps/srd/src/generated",
      // srd's `/greembeem` easter egg: a Wikipedia pastiche that used to be a
      // TSX page rendering this exact markup, and is now the rendered document
      // itself (audit AP-18). It is a byte-for-byte build artefact — its dead
      // `href="#"` anchors and `role="button"` edit links ARE the page, which the
      // TSX carried as `biome-ignore-all` — and formatting it would change what
      // ships.
      "!apps/srd/public/greembeem",
      "!**/convex/_generated",
      "!packages/salvageunion-reference/lib/generated",
      // Astro's old codegen cache. apps/srd has not built through Astro since
      // ADR-031, but `.astro/` survives on any working copy that predates the
      // migration — it is gitignored, so it is invisible to `git status` while
      // Biome formats `types.d.ts` and `content.d.ts` and `format:check` exits
      // 1 on an otherwise-clean tree. CI never sees it (fresh checkout), so it
      // only ever hits developers, which is how people learn `--no-verify`.
      // Biome reads no `.gitignore` without a `vcs` block, so gitignored-ness
      // alone excludes nothing — this list is the only mechanism.
      "!**/.astro",
      // Game-data JSON is crawler-sourced; CLAUDE.md's "Data Conventions"
      // section forbids automated formatters reformatting these arrays
      // (`json.dump`-style tools reflow crawler-authored line breaks). Biome's
      // JSON formatter collapses some multi-line arrays that Prettier left
      // alone (verified: packages/salvageunion-reference/data/actions.json),
      // so keep this directory out of scope entirely, same as before.
      "!packages/salvageunion-reference/data",
      "!apps/srd/package.json",
      "!**/*.md",
      "!**/*.mdx",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        // Import ORDER was the last big convention asserted by nobody and held
        // by nobody: 73 of 977 source files re-opened a bare-package import
        // after their first relative one, and two sibling `ActionsDeck.tsx`
        // files in the same feature disagreed with each other. No doc declared
        // an order, so there was nothing to violate — and this assist, which
        // fixes it mechanically, was switched off.
        //
        // Groups below are the order the ~93% majority already used. Blank
        // lines between groups are preserved by the formatter, so the result
        // reads the way the best files already do.
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":BUN:",
              ":NODE:",
              [":PACKAGE_WITH_PROTOCOL:", ":URL:"],
              ":PACKAGE:",
              ":ALIAS:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "css": {
    // Tailwind v4 CSS (@theme, @utility, @source, @plugin, @custom-variant)
    // used in apps/itun, apps/srd, packages/component-lib.
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      // Prettier's global singleQuote:true applied to CSS too; match it
      // (Biome's CSS default is double quotes).
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "warn",
        "useIterableCallbackReturn": "warn",
        "noAssignInExpressions": "warn",
        // An empty block is either a mistake or a decision with no reason
        // written down, and in a `catch` it is an error nobody will ever hear
        // about (audit AP-15). A block holding only a comment passes, so the
        // fix for a deliberate one is to say why. Off for tests and stories via
        // an override below, where `() => {}` is the idiom for a no-op prop.
        "noEmptyBlockStatements": "error"
      },
      "style": {
        // House rule: "Prefer `type` over `interface` for object types (unless
        // extending)". That convention was once asserted in a rules doc and
        // enforced by nothing, so it held only where a reviewer
        // happened to look. Note the explicit `style: "type"` option — Biome's
        // DEFAULT for this rule is the opposite direction ("interface"), which
        // would flag ~613 correct `type X = { … }` declarations instead.
        //
        // Genuine, permanent exemptions (module augmentation and declaration
        // merging REQUIRE `interface`; `type` cannot express either) are listed
        // as overrides at the bottom of this file, not suppressed per-line.
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        },
        // House rule: "Import types with `import type` syntax". Same story as
        // the rule above — asserted in prose, enforced by nothing, so BOTH
        // shapes survived: 225 files use a separate
        // `import type { … }` statement alongside a value import from the same
        // specifier, while ~100 sites inline `{ type X, Y }`. Neither is wrong;
        // having both for the same job is. `separatedType` is the majority
        // form and the one the old rules doc's wording implied.
        "useImportType": {
          "level": "error",
          "options": { "style": "separatedType" }
        },
        // "Named exports everywhere except route components" (CLAUDE.md:165,
        // react-components.md:14) — stated three times at three strengths and
        // enforced by nothing. It turned out to be genuinely obeyed (0
        // violations outside the two legitimate exemptions below), which is
        // exactly why it is cheap to lock in now rather than after it drifts.
        //
        // The two exemptions are real framework contracts, not preferences:
        // TanStack Router route modules, and Ladle story `meta` — both are
        // read by their framework as a default export. Cloudflare Workers and
        // the Convex http router are the same shape. All are listed as
        // overrides at the bottom rather than suppressed per-file.
        "noDefaultExport": "error",
        // Prefer `const` over `let` where never reassigned, and template
        // literals over string concatenation — both auto-fixable, both
        // currently drifting quietly.
        "useConst": "error",
        "useTemplate": "error",
        "noParameterAssign": "error",
        "useSelfClosingElements": "error",
        "useShorthandFunctionType": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              // ADR-013 (CSP-compliant Zod / jitless parsing): all Zod usage
              // must flow through packages/salvageunion-reference/lib/zod.ts,
              // which calls z.config({ jitless: true }) before any schema is
              // constructed. A direct `import { z } from 'zod'` bypasses that
              // config and can reintroduce a `new Function`-based CSP
              // violation in the browser. Re-stated (not inherited) in the
              // per-package overrides below wherever those need additional
              // paths — Biome overrides replace a rule's options for matched
              // files rather than merging into the root config.
              "zod": "Import `z` from 'salvageunion-reference/zod' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses).",
              "react": {
                "importNames": ["forwardRef"],
                "message": "React 19 passes `ref` as an ordinary prop: type it with ComponentPropsWithRef<…> (or `ref?: Ref<T>`) and take it from props. forwardRef is slated for deprecation."
              }
            },
            "patterns": [
              {
                "group": ["@/*"],
                "message": "Use relative imports instead of @/ path aliases."
              },
              // A workspace package's PUBLIC SURFACE is its entry point, and
              // nothing enforced that. knip's `includeEntryExports` gate only
              // sees the barrel, so a deep import both bypasses the one gate
              // that would notice an export rotting and couples the importer to
              // the package's internal file layout. There are ZERO deep imports
              // in the tree today — this keeps it that way rather than cleaning
              // it up later.
              //
              // The package's declared subpath exports are `/rules`, `/zod` and
              // `/testing` (test code only), plus the committed `/data/*` and
              // `/schemas/*` files, which srd's JSON API serves verbatim.
              {
                "group": ["salvageunion-reference/lib/**"],
                "message": "Import from 'salvageunion-reference' or a declared subpath export ('/rules', '/zod', or '/testing' from test code) — never a path inside the package."
              },
              {
                "group": ["component-lib/src/**"],
                "message": "Import from 'component-lib'. Its barrel (src/index.ts) is the public API and the only surface knip's includeEntryExports gate covers."
              }
            ]
          }
        }
      },
      //
      // --- These were downgraded from Biome's default "error" to "warn" during
      // the ESLint→Biome swap, so that migration stayed a tooling change rather
      // than a lint-cleanup pass. They were explicitly "a deliberate follow-up
      // list, not silenced" — but nothing ratcheted them, and a warning is
      // invisible to every gate: `bun run lint` exits 0 while printing them, so
      // CI and pre-push both pass with violations present.
      //
      // The burn-down is now done. The list stood at 7 warnings + 2 infos; all
      // are fixed, so `bun run lint` reports zero. Promoting the whole set to
      // "error" is what makes that stick — at zero violations the promotion
      // costs nothing today and prevents the list silently regrowing.
      //
      // A genuinely-correct idiom that trips one of these gets a per-site
      // `biome-ignore` WITH a reason (see StatProvenance / parseTraitReferences
      // for the two that earned one), not a downgrade back to "warn".
      //
      "a11y": {
        "useButtonType": "error",
        "useSemanticElements": "error",
        "useAriaPropsSupportedByRole": "error",
        "noStaticElementInteractions": "error",
        "noSvgWithoutTitle": "error",
        "noAriaHiddenOnFocusable": "error",
        "noAutofocus": "error",
        "useFocusableInteractive": "error",
        "useAriaPropsForRole": "error",
        "useKeyWithClickEvents": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useJsxKeyInIterable": "error",
        "noUnsafeOptionalChaining": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      }
    },
    "domains": {
      "react": "recommended"
    }
  },
  "overrides": [
    {
      // Function-size ratchet for component-lib. `ReferenceEntityCardInner` was
      // once a ~1,870-line body that six workstreams edited at once; audit PK-08
      // decomposed it, and the cap sits at what is left, so one more line in the
      // largest body fails. Biome counts the whole function without comment
      // lines, which is why this reads lower than the 856-line body the old
      // AST check measured. Lower it when a seam lands; never raise it.
      "includes": [
        "packages/component-lib/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.stories.tsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 742 } }
          }
        }
      }
    },
    {
      // A no-op callback (`onChange={() => {}}`, `mock(() => {})`) is the whole
      // point in a test or a story, so `noEmptyBlockStatements` — which exists
      // to catch swallowed errors in shipped code — is off here.
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/__tests__/**",
        "**/*.stories.tsx",
        "**/test/**",
        "**/e2e/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlockStatements": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/itun/**", "packages/component-lib/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "warn"
          },
          "suspicious": {
            "noConsole": {
              "level": "warn",
              "options": {
                "allow": ["warn", "error"]
              }
            }
          }
        }
      }
    },
    {
      // Ladle story files MUST export a `default` meta object alongside their
      // named story components — it is the required shape, not a smell. The
      // useComponentExportOnlyModules rule (a React Fast-Refresh guard) does
      // not apply to a static Ladle catalog, so it is disabled for stories
      // here rather than suppressed with a per-file `biome-ignore` on every
      // one of ~100 story files. This override sorts AFTER the block above
      // that enables the rule, so it wins for the matched paths.
      "includes": ["**/*.stories.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off",
            // Ladle reads a story file's `meta` as its DEFAULT export — this is
            // the framework's contract, not a style choice. All 107 of the
            // repo's `export default`s outside `src/routes/` are this.
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // The other legitimate default-export contracts, each read by a framework
      // rather than imported by us: TanStack Router route modules, Cloudflare
      // Worker entrypoints, the Convex http router and schema, and build/test
      // config files. Listed here so the rule stays `error` everywhere else.
      "includes": [
        "apps/itun/src/routes/**",
        // workerd reads `export default { fetch }` — the module IS the contract.
        // Each entry location is named
        // explicitly rather than globbing `src/**`, so an ordinary module in the
        // same app cannot quietly acquire a default export under this exemption.
        // These three are the `main` of the three wrangler configs; a fourth
        // Worker adds a fourth line here, deliberately.
        "apps/*/src/worker.ts",
        "apps/*/src/worker/index.ts",
        "apps/*/src/http/worker.ts",
        "apps/itun/convex/http.ts",
        "apps/itun/convex/schema.ts",
        "**/*.config.ts",
        "**/*.config.mts",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/playwright.config.ts",
        // Ambient module declarations for asset imports (`declare module
        // '*.md?raw'`) must re-declare the bundler's own default export — the
        // shape is dictated by Vite, not chosen.
        "**/*.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/srd/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "warn",
              "options": {
                "allow": ["warn", "error"]
              }
            }
          },
          "style": {
            // The two apps must never import each other. They share through
            // `component-lib` and `salvageunion-reference`; a direct edge would
            // make one app's build depend on the other's internals and give the
            // shared layer a way to be bypassed.
            //
            // There is no such edge today (verified: zero srd↔itun imports in
            // either direction). This is the guard, not a cleanup.
            //
            // The root rule's paths/patterns are RESTATED here because Biome
            // overrides REPLACE a rule's options for matched files rather than
            // merging — see the note at the root declaration.
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import `z` from 'salvageunion-reference/zod' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses).",
                  "react": {
                    "importNames": ["forwardRef"],
                    "message": "React 19 passes `ref` as an ordinary prop: type it with ComponentPropsWithRef<…> (or `ref?: Ref<T>`) and take it from props. forwardRef is slated for deprecation."
                  }
                },
                "patterns": [
                  {
                    "group": ["@/*"],
                    "message": "Use relative imports instead of @/ path aliases."
                  },
                  {
                    "group": ["salvageunion-reference/lib/**"],
                    "message": "Import from 'salvageunion-reference' or a declared subpath export — never a path inside the package."
                  },
                  {
                    "group": ["component-lib/src/**"],
                    "message": "Import from 'component-lib'. Its barrel is the public API."
                  },
                  {
                    "group": ["**/apps/itun/**", "**/itun/**", "itun/**"],
                    "message": "apps/srd must never import from apps/itun. The two apps share only through component-lib and salvageunion-reference."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/itun/**"],
      "linter": {
        "rules": {
          "style": {
            // The mirror of the rule on apps/srd — see that block for why.
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import `z` from 'salvageunion-reference/zod' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses).",
                  "react": {
                    "importNames": ["forwardRef"],
                    "message": "React 19 passes `ref` as an ordinary prop: type it with ComponentPropsWithRef<…> (or `ref?: Ref<T>`) and take it from props. forwardRef is slated for deprecation."
                  }
                },
                "patterns": [
                  {
                    "group": ["@/*"],
                    "message": "Use relative imports instead of @/ path aliases."
                  },
                  {
                    "group": ["salvageunion-reference/lib/**"],
                    "message": "Import from 'salvageunion-reference' or a declared subpath export — never a path inside the package."
                  },
                  {
                    "group": ["component-lib/src/**"],
                    "message": "Import from 'component-lib'. Its barrel is the public API."
                  },
                  {
                    "group": ["**/apps/srd/**", "**/srd/**", "srd/**"],
                    "message": "apps/itun must never import from apps/srd. The two apps share only through component-lib and salvageunion-reference."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Every Convex mutation is built through `convex/model/entities.ts`, whose
      // `mutation` / `internalMutation` run the database triggers that keep
      // `games.summary` current. A mutation built from the generated builders
      // writes without them, and the Games list badge for whatever it touched
      // is then wrong until the next backfill — silently. That file is the one
      // place allowed to import the raw builders, because it wraps them.
      //
      // Restates the apps/itun block's options in full: Biome overrides
      // REPLACE a rule's options for matched files rather than merging.
      "includes": ["apps/itun/convex/**", "!apps/itun/convex/model/entities.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import `z` from 'salvageunion-reference/zod' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses).",
                  "react": {
                    "importNames": ["forwardRef"],
                    "message": "React 19 passes `ref` as an ordinary prop: type it with ComponentPropsWithRef<…> (or `ref?: Ref<T>`) and take it from props. forwardRef is slated for deprecation."
                  },
                  "./_generated/server": {
                    "importNames": ["mutation", "internalMutation"],
                    "message": "Build mutations with `mutation` / `internalMutation` from './model/entities', which run the triggers that keep games.summary current."
                  },
                  "../_generated/server": {
                    "importNames": ["mutation", "internalMutation"],
                    "message": "Build mutations with `mutation` / `internalMutation` from './entities', which run the triggers that keep games.summary current."
                  }
                },
                "patterns": [
                  {
                    "group": ["@/*"],
                    "message": "Use relative imports instead of @/ path aliases."
                  },
                  {
                    "group": ["salvageunion-reference/lib/**"],
                    "message": "Import from 'salvageunion-reference' or a declared subpath export — never a path inside the package."
                  },
                  {
                    "group": ["component-lib/src/**"],
                    "message": "Import from 'component-lib'. Its barrel is the public API."
                  },
                  {
                    "group": ["**/apps/srd/**", "**/srd/**", "srd/**"],
                    "message": "apps/itun must never import from apps/srd. The two apps share only through component-lib and salvageunion-reference."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/itun/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    // -------------------------------------------------------------------
    // Architecture invariants (previously prose-only) that map onto Biome's
    // configurable rules. The ones it has no rule for (no module-scope
    // SalvageUnionReference call, no inlined pool default) are the GritQL
    // plugins declared at the top of this file.
    // -------------------------------------------------------------------
    {
      // ADR-013: no app/package outside the canonical module may import zod
      // directly. salvageunion-reference gets an extra restriction on top:
      // it must never import from apps/* (one-way dependency rule, see
      // docs/ARCHITECTURE.md#one-way-dependencies). Restates the root `zod` path + `@/*`
      // pattern because overrides replace (not merge into) a rule's options
      // for matched files.
      "includes": ["packages/salvageunion-reference/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import `z` from './zod.js' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses)."
                },
                "patterns": [
                  {
                    "group": ["@/*"],
                    "message": "Use relative imports instead of @/ path aliases."
                  },
                  {
                    "group": ["**/apps/**"],
                    "message": "salvageunion-reference must never import from apps/* — the dependency flows one way (docs/ARCHITECTURE.md#one-way-dependencies)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The one file allowed to import zod directly — it's the canonical
      // module ADR-013 requires everything else to route through. Listed
      // after the package-wide override above so this narrower, later match
      // wins for this one file (Biome overrides apply in order; a later
      // override replaces an earlier one's config for the same rule on
      // files both match).
      "includes": ["packages/salvageunion-reference/lib/zod.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      // ADR-010 ("the shared library never persists"): component-lib must stay
      // free of storage-layer imports. `idb` is ITUN's IndexedDB wrapper (see
      // docs/ARCHITECTURE.md#itun-consumes) — it doesn't belong in the shared component library. Zustand is
      // deliberately NOT blocked here: it's a state-management library, not
      // itself a storage layer (ADR-010's literal contract is "never
      // persists"), and component-lib doesn't use it today — blocking it would
      // be scope creep past what ADR-010 actually requires.
      // Restates the root `zod` path + `@/*` pattern (see note above).
      "includes": ["packages/component-lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import `z` from 'salvageunion-reference/zod' instead of importing 'zod' directly (ADR-013: the shared module runs z.config({ jitless: true }) before any schema is constructed, which a direct zod import bypasses).",
                  "react": {
                    "importNames": ["forwardRef"],
                    "message": "React 19 passes `ref` as an ordinary prop: type it with ComponentPropsWithRef<…> (or `ref?: Ref<T>`) and take it from props. forwardRef is slated for deprecation."
                  },
                  "idb": "packages/component-lib must stay persistence-agnostic (ADR-010: \"the shared library never persists\") — persistence belongs in the consuming app (ITUN), passed down via props.",
                  "@ladle/react": "Take `Story` from src/stories/_harness.tsx. Any import from '@ladle/react', even `import type`, puts Ladle's own UI source (typings-for-build/app/src/ui.tsx) under tsc, and it fails TypeScript 7's JSX checks."
                },
                "patterns": [
                  {
                    "group": ["@/*"],
                    "message": "Use relative imports instead of @/ path aliases."
                  },
                  // The fourth boundary edge. `salvageunion-reference` already
                  // banned this for itself; component-lib sits at the same
                  // level in the graph and had no equivalent guard, so the
                  // shared library could have taken a dependency on one of its
                  // own consumers. Zero such imports today.
                  {
                    "group": ["**/apps/**", "itun/**", "srd/**"],
                    "message": "component-lib must never import from an app — the dependency flows one way (apps depend on the library). Inject app-specific behaviour through slot props instead (docs/ARCHITECTURE.md#one-way-dependencies)."
                  },
                  {
                    "group": ["salvageunion-reference/lib/**"],
                    "message": "Import from 'salvageunion-reference' or a declared subpath export — never a path inside the package."
                  }
                ]
              }
            },
            // Same ADR-010 contract, for direct global storage API usage rather
            // than an import (e.g. `localStorage.setItem(...)` with no import
            // statement to catch).
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "localStorage": "packages/component-lib must stay persistence-agnostic (ADR-010: \"the shared library never persists\") — persistence belongs in the consuming app.",
                  "sessionStorage": "packages/component-lib must stay persistence-agnostic (ADR-010: \"the shared library never persists\") — persistence belongs in the consuming app.",
                  "indexedDB": "packages/component-lib must stay persistence-agnostic (ADR-010: \"the shared library never persists\") — persistence belongs in the consuming app."
                }
              }
            }
          }
        }
      }
    },
    {
      // PERMANENT exemption from useConsistentTypeDefinitions. Every file here
      // declares a `declare global { interface … }` module augmentation, which
      // is the ONE thing `type` cannot express: declaration merging into an
      // existing interface (`Window`, TanStack Router's
      // `Register`) requires the `interface` keyword by language rule, not by
      // preference. Rewriting any of these as `type` is a compile error, so
      // this list is a statement of fact, not a burn-down.
      //
      // `**/*.d.ts` no longer needs listing here: the three `linter.enabled:
      // false` overrides now sort LAST in this array (see the block at the very
      // bottom), so nothing can re-enable them. This list is now only the real
      // source files that need the exemption.
      "includes": [
        "apps/itun/src/main.tsx",
        "apps/srd/src/components/islands/OgCardIsland.tsx",
        "packages/component-lib/src/components/shared/KofiButton.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    },
    {
      // Test modules: two relaxations.
      //
      // `noExplicitAny` stays "error" for real source; tests may use `any` for
      // mocking (`as any` casts), so it is "warn" here.
      //
      // `useComponentExportOnlyModules` is a React Fast Refresh heuristic: it
      // wants a module to export only components so the dev server can hot-swap
      // it. Test modules are never Fast Refresh boundaries — they run under the
      // test runner, not the dev server — so a test declaring a local harness
      // component alongside its cases is not the problem the rule exists to
      // catch.
      //
      // This sits AFTER the `apps/itun/**` / `packages/component-lib/**` block
      // that sets that rule to "warn", because Biome applies overrides in array
      // order and the later one wins. Placed near the top of this array, it was
      // silently overridden back to "warn".
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "warn"
          },
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      // Ambient declarations extend globals by interface merging (`ImportMetaEnv`,
      // `ImportMeta` in the Vite env files), which a `type` alias cannot do.
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    }
  ]
}
