{
  "mcpServers": {
    "cloudflare-bindings": {
      "type": "http",
      "url": "https://bindings.mcp.cloudflare.com/mcp"
    },
    "cloudflare-observability": {
      "type": "http",
      "url": "https://observability.mcp.cloudflare.com/mcp"
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "convex": {
      "command": "bunx",
      "args": [
        "convex@1.45.0",
        "mcp",
        "start",
        "--project-dir",
        "apps/itun",
        "--disable-tools",
        "envSet,envRemove,run"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
