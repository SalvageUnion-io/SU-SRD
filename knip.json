{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreBinaries": ["lefthook"],
  "ignoreDependencies": ["tailwindcss"],
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.ts", "eslint.base.js"],
      "project": ["tools/**/*.ts"]
    },
    "packages/salvageunion-reference": {
      "project": ["lib/**/*.ts", "tools/**/*.ts"]
    },
    "packages/suref-react": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/suref-web": {
      "entry": ["src/pages/**/*.{astro,ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,astro}"],
      "ignoreDependencies": ["sharp"]
    },
    "apps/in-the-union-now": {
      "entry": [
        "src/routes/**/*.tsx",
        "test/**/*.test.ts",
        "src/lib/schemas/index.ts",
        "src/lib/db/index.ts",
        "src/lib/db/stores.ts",
        "src/lib/db/crud.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"],
      "ignore": ["src/lib/sw/__mocks__/**"],
      "ignoreDependencies": ["suref-react", "lucide-react"]
    },
    "apps/itun-legacy": {
      "entry": [],
      "project": [],
      "ignore": ["**/*"]
    },
    "apps/discord-bot": {
      "project": ["src/**/*.ts"]
    }
  }
}
