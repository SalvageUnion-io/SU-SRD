{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreBinaries": ["netlify"],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "tags": ["-public", "-knipignore"],
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.ts"],
      "project": ["tools/**/*.ts"]
    },
    "packages/salvageunion-reference": {
      "entry": ["tools/**/*.ts"],
      "project": ["lib/**/*.ts", "tools/**/*.ts"],
      "ignore": ["etc/**"]
    },
    "packages/component-lib": {
      "project": ["src/**/*.{ts,tsx}"],
      "includeEntryExports": false
    },
    "apps/srd": {
      "entry": ["src/pages/**/*.{astro,ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,astro}"],
      "includeEntryExports": false
    },
    "apps/itun": {
      "entry": [
        "src/routes/**/*.tsx",
        "netlify/functions/**/*.ts",
        "src/lib/db/index.ts",
        "src/lib/db/stores.ts",
        "src/lib/db/crud.ts",
        "src/lib/snapshot/storage.ts",
        "src/lib/snapshot/id.ts",
        "src/lib/snapshot/rateLimit.ts",
        "src/stores/entityStore.ts",
        "src/stores/workspaceStore.ts",
        "src/stores/types.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "netlify/**/*.ts", "convex/*.ts"]
    },
    "apps/su-assets": {
      "entry": ["netlify/functions/**/*.ts"],
      "project": ["netlify/**/*.ts"],
      "includeEntryExports": false
    },
    "apps/discord-bot": {
      "project": ["src/**/*.ts"]
    }
  }
}
