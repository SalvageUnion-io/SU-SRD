{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreBinaries": ["netlify"],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.ts"],
      "project": ["tools/**/*.ts"]
    },
    "packages/salvageunion-reference": {
      "entry": ["tools/**/*.ts"],
      "project": ["lib/**/*.ts", "tools/**/*.ts"]
    },
    "packages/suref-react": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/suref-web": {
      "entry": ["src/pages/**/*.{astro,ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,astro}"]
    },
    "apps/in-the-union-now": {
      "entry": [
        "src/routes/**/*.tsx",
        "netlify/functions/**/*.ts",
        "src/lib/schemas/index.ts",
        "src/lib/db/index.ts",
        "src/lib/db/stores.ts",
        "src/lib/db/crud.ts",
        "src/lib/snapshot/storage.ts",
        "src/lib/snapshot/id.ts",
        "src/lib/snapshot/rateLimit.ts",
        "src/stores/index.ts",
        "src/stores/entityStore.ts",
        "src/stores/workspaceStore.ts",
        "src/stores/types.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "netlify/**/*.ts"]
    },
    "apps/su-assets": {
      "entry": ["netlify/functions/**/*.ts"],
      "project": ["netlify/**/*.ts"]
    },
    "apps/discord-bot": {
      "project": ["src/**/*.ts"]
    }
  }
}
