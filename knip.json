{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreBinaries": ["netlify"],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  // Exports tagged `@public` or `@knipignore` are excluded from analysis. The
  // decision procedure for reaching for either is in `.claude/skills/knip-triage`
  // — delete by default; these two are the only exemptions.
  //
  // `--treat-tag-hints-as-errors` does NOT catch a tag that has outlived its
  // reason, despite reading like it would. Measured against knip 6.32 with this
  // config: it exits 0 even with a deliberately redundant `@public` on an
  // already-imported export. It was going to be added to the `knip` script
  // until that probe ran — recorded here so the next reader does not add it
  // believing it guards something.
  //
  // So a stale tag is found by a human, and its cost is misleading PROSE rather
  // than a hidden finding: five `@public` tags were pruned in 2026-08, every one
  // justified by a fork that had already been deleted, each telling a reader to
  // go de-duplicate files that no longer existed.
  "tags": ["-public", "-knipignore"],
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.ts"],
      "project": ["tools/**/*.ts"]
    },
    "packages/salvageunion-reference": {
      "entry": ["tools/**/*.ts"],
      "project": ["lib/**/*.ts", "tools/**/*.ts"],
      "ignore": ["etc/**"]
    },
    "packages/observability": {
      // No `entry` here on purpose: knip derives both subpaths from the
      // manifest's `exports` map, and listing them again is reported as a
      // redundant pattern.
      "project": ["src/**/*.ts"]
    },
    "packages/component-lib": {
      "project": ["src/**/*.{ts,tsx}"],
      "includeEntryExports": false
    },
    "apps/srd": {
      // `ssg/build.ts` is the in-house static-site generator's entry (it reaches
      // routes -> pages -> layouts). `src/runtime/*.entry`-style files are
      // *client bundle* entries, named in ssg/vite.config.ts rather than
      // imported by anything, so knip cannot infer them.
      "entry": [
        // build/dev/preview are matched by knip's own bin/script detection from
        // package.json, so they are deliberately not listed here.
        "src/runtime/islands.client.ts",
        "src/runtime/styles.entry.ts",
        "src/runtime/assets.entry.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "ssg/**/*.{ts,tsx}"],
      "includeEntryExports": false
    },
    "apps/itun": {
      "entry": [
        "src/routes/**/*.tsx",
        "netlify/functions/**/*.ts",
        // The Cloudflare Worker entry (ADR-033). workerd loads the module and
        // calls its default export, so nothing in this repo imports it. Listed
        // for the same reason the Netlify handlers are: without it, the file
        // stays alive only because a test imports it, and deleting that test
        // would make the deployed Worker look like dead code.
        "src/worker/index.ts",
        "src/lib/db/index.ts",
        "src/lib/db/stores.ts",
        "src/lib/db/crud.ts",
        "src/lib/snapshot/storage.ts",
        "src/lib/snapshot/id.ts",
        "src/lib/snapshot/rateLimit.ts",
        "src/stores/entityStore.ts",
        "src/stores/activeContainerStore.ts",
        "src/stores/cockpitPrefsStore.ts",
        "src/stores/types.ts"
      ],
      // `test/**` covers the Convex test suite, which lives OUTSIDE `convex/`
      // so that codegen does not register the harness as a deployable module.
      // Without it knip cannot see the harness and reports `convex-test` — its
      // only importer — as an unused devDependency.
      // `convex/**` (not `convex/*`) so `convex/model/*` is covered too.
      "project": [
        "src/**/*.{ts,tsx}",
        "netlify/**/*.ts",
        "convex/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "apps/su-assets": {
      "entry": ["netlify/functions/**/*.ts"],
      "project": ["netlify/**/*.ts"],
      "includeEntryExports": false
    },
    "apps/discord-bot": {
      // `src/http/worker.ts` is a framework entry in the same sense the Netlify
      // handlers are: workerd loads the module and calls its default export, so
      // nothing in this repo imports it. Without it listed, knip reports the
      // whole HTTP-interactions transport — and `@discordjs/rest`, which only
      // that transport uses — as dead code.
      //
      // `src/index.ts` and `src/deploy-commands.ts` are matched by knip's own
      // bin/script detection from package.json and are deliberately not listed.
      "entry": ["src/http/worker.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
