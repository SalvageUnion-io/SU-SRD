{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "includeEntryExports": true,
  // A redundant entry, stale ignore or needless workspace setting fails too.
  "treatConfigHintsAsErrors": true,
  // @public/@knipignore are the only exemptions: docs/ARCHITECTURE.md#dead-code.
  // --treat-tag-hints-as-errors does not catch a stale tag; don't add it as a guard.
  "tags": ["-public", "-knipignore"],
  "workspaces": {
    // The root holds no code of its own now that `tools/` is a workspace.
    ".": {
      "project": []
    },
    "tools": {
      // Every top-level script is run directly (`bun tools/<name>.ts`), by a
      // root script, the check registry or a workflow.
      "entry": ["*.ts"]
    },
    "packages/gates": {
      // `rules/*.ts` is listed because knip reads `.gitignore`'s `rules/*`
      // (the local rules extract) as matching `packages/gates/rules/` too, and
      // would not otherwise follow it.
      "entry": ["rules/*.ts"]
    },
    "packages/salvageunion-reference": {
      "entry": ["tools/**/*.ts"],
      "project": ["lib/**/*.ts", "tools/**/*.ts"]
    },
    "packages/observability": {
      // No `entry` here on purpose: knip derives both subpaths from the
      // manifest's `exports` map, and listing them again is reported as a
      // redundant pattern.
      "project": ["src/**/*.ts"]
    },
    "packages/cantina-domain": {
      // No `entry`: knip derives the subpaths from the manifest's `exports`
      // wildcard, as for `packages/observability`.
      "project": ["src/**/*.ts"]
    },
    "packages/component-lib": {
      // Pinned on (the root default) because src/index.ts is the package's
      // whole public API; see biome.jsonc's component-lib/src/** rule.
      "project": ["src/**/*.{ts,tsx}"],
      "includeEntryExports": true
    },
    "apps/srd": {
      // `ssg/build.ts` is the in-house static-site generator's entry (it reaches
      // routes -> pages -> layouts). `src/runtime/*.entry`-style files are
      // *client bundle* entries, named in ssg/vite.config.ts rather than
      // imported by anything, so knip cannot infer them.
      "entry": [
        // build/dev/preview are matched by knip's own bin/script detection from
        // package.json, so they are deliberately not listed here.
        "src/runtime/islands.client.ts",
        "src/runtime/styles.entry.ts",
        "src/runtime/assets.entry.ts",
        // The one spec that imports `gates` (`packages/gates/lib/a11yScan.ts`).
        "e2e/a11y.e2e.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "ssg/**/*.{ts,tsx}"]
    },
    "apps/cantina": {
      "entry": [
        "src/routes/**/*.tsx",
        // The Worker entry (`src/worker/index.ts`) is NOT listed: it is the
        // package's `./worker` export, which srd's Worker imports.
        // The one spec that imports `gates` (`packages/gates/lib/a11yScan.ts`).
        "e2e/a11y.e2e.ts"
      ],
      // `test/**` covers the Convex test suite, which lives OUTSIDE `convex/`
      // so that codegen does not register the harness as a deployable module.
      // Without it knip cannot see the harness and reports `convex-test` — its
      // only importer — as an unused devDependency.
      // `convex/**` (not `convex/*`) so `convex/model/*` is covered too.
      "project": [
        "src/**/*.{ts,tsx}",
        "convex/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "apps/su-assets": {
      // The Worker entry (`src/worker/index.ts`) comes from wrangler.jsonc's `main`
      // via knip's wrangler plugin. `project` must still cover `src/**`, or the
      // Worker and its test sit outside knip's scope.
      "project": ["src/**/*.ts"]
    },
    "apps/discord-bot": {
      // `src/worker/index.ts` (the Worker) comes from wrangler.jsonc's `main`
      // via knip's wrangler plugin, and `src/deploy-commands.ts` from the
      // package.json scripts, so neither is listed. If the wrangler plugin
      // ever stops applying (wrangler removed from the root manifest), knip will
      // report the whole HTTP-interactions transport as dead code; restore the
      // entry then.
      "project": ["src/**/*.ts"]
    }
  }
}
