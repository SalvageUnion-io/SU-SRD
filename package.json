{
  "name": "SURef",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "https://leyline.press/pages/salvage-union-open-game-licence-1-0b",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@base-ui/react": "1.6.0",
      "@fontsource/barlow": "5.3.0",
      "@fontsource/barlow-semi-condensed": "5.3.0",
      "@netlify/blobs": "^10.7.11",
      "@playwright/test": "1.62.1",
      "@randsum/roller": "^4.0.0",
      "@sentry/browser": "10.69.0",
      "@sentry/node": "10.69.0",
      "@tailwindcss/vite": "4.3.3",
      "@testing-library/jest-dom": "7.0.0",
      "@testing-library/react": "16.3.2",
      "@vitejs/plugin-react-swc": "^4.3.3",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "fake-indexeddb": "6.2.5",
      "lucide-react": "^1.28.0",
      "playwright": "1.62.1",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sharp": "0.35.3",
      "tailwind-merge": "^3.6.0",
      "vite": "^8.2.0"
    }
  },
  "overrides": {
    "@discordjs/rest": "^2.6.3",
    "@opentelemetry/core": "^2.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@happy-dom/global-registrator": "20.11.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "axe-core": "4.13.0",
    "bun-types": "1.4.0",
    "concurrently": "10.0.4",
    "fake-indexeddb": "catalog:",
    "knip": "6.32.0",
    "lefthook": "2.1.10",
    "playwright": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-classic": "npm:typescript@6.0.3"
  },
  "scripts": {
    "prepare": "[ -z \"$CI\" ] && [ -d .git ] && bunx lefthook install || true",
    "dev": "bun run build:package && bun --filter srd dev",
    "dev:watch": "bun run dev",
    "dev:bot": "bun run build:package && bun --filter discord-bot dev",
    "dev:itun": "bun run build:package && bun --filter itun dev",
    "build": "bun run build:package && bun run build:web && bun run build:itun && bun run build:bot",
    "build:web": "bun --filter srd build",
    "build:itun": "bun --filter itun build",
    "build:bot": "bun --filter discord-bot build",
    "build:package": "bun --filter salvageunion-reference build",
    "deploy-commands": "bun --filter discord-bot deploy-commands",
    "deploy-commands:global": "bun --filter discord-bot deploy-commands:global",
    "rules:extract": "bun tools/extract-rules.ts",
    "assets:webp": "bun tools/convert-lp-assets-to-webp.ts",
    "typecheck": "bun --filter salvageunion-reference typecheck && concurrently -g 'bun run typecheck:tools' 'bun --filter component-lib typecheck' 'bun --filter observability typecheck' 'bun --filter srd typecheck' 'bun --filter itun typecheck' 'bun --filter discord-bot typecheck' 'bun --filter su-assets typecheck'",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "typecheck:itun": "bun --filter itun typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun --filter \"*\" test && bun run test:tools",
    "test:coverage": "bun tools/run-coverage.ts",
    "test:tools": "bun test ./tools",
    "e2e:itun": "cd apps/itun && bunx playwright test",
    "e2e:itun:install": "cd apps/itun && bunx playwright install --with-deps chromium",
    "validate:ids": "bun --filter salvageunion-reference validate:ids",
    "validate:architecture": "bun tools/check-architecture.ts",
    "validate:doc-drift": "bun tools/check-doc-drift.ts",
    "validate:convex-codegen": "bun tools/check-convex-codegen.ts",
    "validate:observability": "bun tools/check-observability.ts",
    "validate:observability:live": "bun tools/check-observability.ts --live",
    "validate:convex-parity": "bun tools/check-convex-parity.ts",
    "validate:convex-parity:live": "bun tools/check-convex-parity.ts --live",
    "validate:all": "bun --filter salvageunion-reference validate:all && bun tools/check-bun-version.ts && bun run validate:architecture && bun run validate:doc-drift && bun run validate:observability && bun run validate:convex-codegen && bun run validate:convex-parity && bun run check:catalog",
    "clean": "bun --filter \"*\" clean || true",
    "reap": "tools/prune-stale-worktrees.sh",
    "knip": "knip",
    "check:schemas": "bun run build:package && git diff --exit-code -- packages/salvageunion-reference/schemas packages/salvageunion-reference/docs packages/salvageunion-reference/lib/generated packages/salvageunion-reference/lib/index.ts packages/salvageunion-reference/etc .vscode/settings.json",
    "check:audit": "bun audit --audit-level=high --ignore=GHSA-w3rx-r6r6-pgpr --ignore=GHSA-5p2g-fcmc-qvqq",
    "check:tokens": "bun tools/check-design-tokens.ts",
    "check:styling": "bun tools/check-styling-ownership.ts",
    "check:ci-aggregator": "bun tools/check-ci-aggregator.ts",
    "check:printed-names": "bun tools/check-printed-names.ts",
    "check:fast": "concurrently -g 'bun run lint' 'bun run validate:all' 'bun run knip' && bun run typecheck",
    "check:srd-output": "bun --filter srd gate",
    "check:all": "bun run check:schemas && concurrently -g 'bun run lint' 'bun run format:check' && bun run typecheck && concurrently -g 'bun run test' 'bun run validate:all' 'bun run knip' 'bun run check:audit' 'bun run check:tokens' 'bun run check:styling' 'bun run check:ci-aggregator' 'bun run check:srd-output'",
    "ladle": "bun --filter component-lib ladle",
    "check:catalog": "bun tools/check-catalog.ts"
  },
  "patchedDependencies": {
    "@ladle/react@5.1.1": "patches/@ladle%2Freact@5.1.1.patch"
  }
}
