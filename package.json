{
  "name": "SURef",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "license": "https://leyline.press/pages/salvage-union-open-game-licence-1-0b",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tools"
    ],
    "catalog": {
      "@base-ui/react": "1.6.0",
      "@fontsource/barlow": "5.3.0",
      "@fontsource/barlow-semi-condensed": "5.3.0",
      "@sentry/browser": "10.69.0",
      "lucide-react": "1.33.0",
      "react": "19.2.8",
      "react-dom": "19.2.8"
    }
  },
  "overrides": {
    "sharp": ">=0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@happy-dom/global-registrator": "20.11.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react-swc": "4.3.3",
    "bun-types": "1.4.0",
    "fake-indexeddb": "6.2.5",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.147.0"
  },
  "scripts": {
    "prepare": "[ -z \"$CI\" ] && [ -d .git ] && bunx lefthook install || true",
    "dev": "bun --filter srd dev",
    "dev:itun": "bun --filter itun dev",
    "build": "bun run build:web && bun run build:itun",
    "build:web": "bun --filter srd build",
    "build:itun": "bun --filter itun build",
    "build:package": "bun --filter salvageunion-reference build",
    "deploy-commands": "bun --filter discord-bot deploy-commands",
    "deploy-commands:global": "bun --filter discord-bot deploy-commands:global",
    "rules:extract": "bun tools/extract-rules.ts",
    "typecheck": "bun --filter \"*\" typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun --filter \"*\" test",
    "test:coverage": "bun tools/run-coverage.ts",
    "e2e:itun": "cd apps/itun && bunx playwright test",
    "clean": "bun --filter \"*\" clean || true",
    "knip": "knip",
    "check": "bun tools/check.ts",
    "check:fast": "bun tools/check.ts --profile=fast",
    "audit": "bun audit --ignore=GHSA-vfj7-8cjw-p6xm",
    "check:printed-names": "bun tools/check-printed-names.ts",
    "assets:export": "bun tools/export-lp-assets.ts",
    "assets:upload": "bun tools/upload-lp-assets.ts",
    "ladle": "bun --filter component-lib ladle"
  }
}
