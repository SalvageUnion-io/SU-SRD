{
  "name": "SURef",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "https://leyline.press/pages/salvage-union-open-game-licence-1-0b",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "undici": "6.27.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@happy-dom/global-registrator": "20.10.6",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.12.1",
    "bun-types": "1.3.14",
    "concurrently": "10.0.3",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "knip": "6.24.0",
    "lefthook": "2.1.9",
    "prettier": "3.9.4",
    "puppeteer-core": "25.3.0",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  },
  "scripts": {
    "prepare": "[ -z \"$CI\" ] && [ -d .git ] && bunx lefthook install || true",
    "dev": "bun run build:package && bun --filter suref-web dev",
    "dev:watch": "bun run dev",
    "dev:bot": "bun run build:package && bun --filter @suref/discord-bot dev",
    "dev:bot:watch": "bun --filter @suref/discord-bot dev:watch",
    "dev:itun": "bun run build:package && bun --filter in-the-union-now dev",
    "build": "bun run build:package && bun run build:web && bun run build:itun && bun run build:bot",
    "build:web": "bun --filter suref-web build",
    "build:itun": "bun --filter in-the-union-now build",
    "build:bot": "bun --filter @suref/discord-bot build",
    "build:package": "bun --filter salvageunion-reference build",
    "build:package:watch": "bun --filter salvageunion-reference watch",
    "deploy-commands": "bun --filter @suref/discord-bot deploy-commands",
    "deploy-commands:global": "bun --filter @suref/discord-bot deploy-commands:global",
    "rules:extract": "bun tools/extract-rules.ts",
    "rules:briefs": "bun tools/rules-digest/regenerate.ts briefs",
    "rules:regen": "bun tools/rules-digest/regenerate.ts",
    "assets:webp": "bun tools/convert-lp-assets-to-webp.ts",
    "typecheck": "bun --filter salvageunion-reference typecheck && concurrently -g 'bun --filter suref-react typecheck' 'bun --filter suref-web typecheck' 'bun --filter in-the-union-now typecheck' 'bun --filter @suref/discord-bot typecheck'",
    "typecheck:package": "bun --filter salvageunion-reference typecheck",
    "typecheck:react": "bun --filter suref-react typecheck",
    "typecheck:web": "bun --filter suref-web typecheck",
    "typecheck:itun": "bun --filter in-the-union-now typecheck",
    "lint": "bun --filter \"*\" lint",
    "lint:package": "bun --filter salvageunion-reference lint",
    "lint:react": "bun --filter suref-react lint",
    "lint:web": "bun --filter suref-web lint",
    "lint:itun": "bun --filter in-the-union-now lint",
    "format": "bun --filter \"*\" format",
    "format:check": "bun --filter \"*\" format:check",
    "test": "bun --filter \"*\" test",
    "test:coverage": "bun --filter \"*\" test:coverage",
    "test:package": "bun --filter salvageunion-reference test",
    "test:react": "bun --filter suref-react test",
    "test:web": "bun --filter suref-web test",
    "test:itun": "bun --filter in-the-union-now test",
    "e2e:itun": "cd apps/in-the-union-now && bunx playwright test",
    "e2e:itun:install": "cd apps/in-the-union-now && bunx playwright install --with-deps chromium",
    "e2e:itun:ui": "cd apps/in-the-union-now && bunx playwright test --ui",
    "validate:ids": "bun --filter salvageunion-reference validate:ids",
    "validate:references": "bun --filter salvageunion-reference validate:references",
    "validate:actions": "bun --filter salvageunion-reference validate:actions",
    "validate:action-backrefs": "bun --filter salvageunion-reference validate:action-backrefs",
    "validate:all": "bun --filter salvageunion-reference validate:all && bun tools/check-bun-version.ts",
    "clean": "bun --filter \"*\" clean || true",
    "knip": "knip",
    "check:schemas": "bun run build:package && git diff --exit-code -- packages/salvageunion-reference/schemas",
    "check:audit": "bun audit --audit-level=high",
    "check:all": "bun run check:schemas && concurrently -g 'bun run lint' 'bun run format:check' && bun run typecheck && concurrently -g 'bun run test' 'bun run validate:all' 'bun run knip' 'bun run check:audit'",
    "fix:all": "bun run lint -- --fix && bun run format",
    "ladle": "bun --filter suref-react ladle",
    "ladle:web": "bun --filter suref-web ladle",
    "ladle:itun": "bun --filter in-the-union-now ladle"
  }
}
