{
  "name": "SURef",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "https://leyline.press/pages/salvage-union-open-game-licence-1-0b",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@fontsource/barlow": "5.3.0",
      "@fontsource/barlow-semi-condensed": "5.3.0",
      "@playwright/test": "1.62.1",
      "@randsum/roller": "^4.0.0",
      "@sentry/browser": "10.69.0",
      "@sentry/vite-plugin": "5.4.0",
      "@tailwindcss/vite": "4.3.3",
      "@testing-library/jest-dom": "7.0.0",
      "@testing-library/react": "16.3.2",
      "@vitejs/plugin-react-swc": "^4.3.3",
      "fake-indexeddb": "6.2.5",
      "lucide-react": "^1.28.0",
      "playwright": "1.62.1",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "vite": "^8.2.0",
      "wrangler": "4.132.0"
    }
  },
  "overrides": {
    "@discordjs/rest": "^2.6.3",
    "fast-uri": ">=3.1.6 <4",
    "filelist": ">=1.0.6",
    "nanoid": ">=3.3.18",
    "shell-quote": ">=1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@happy-dom/global-registrator": "20.11.6",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "axe-core": "4.13.0",
    "bun-types": "1.4.0",
    "concurrently": "10.0.5",
    "fake-indexeddb": "catalog:",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "playwright": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-classic": "npm:typescript@6.0.3"
  },
  "scripts": {
    "prepare": "[ -z \"$CI\" ] && [ -d .git ] && bunx lefthook install || true",
    "dev": "bun run build:package && bun --filter srd dev",
    "dev:itun": "bun run build:package && bun --filter itun dev",
    "build": "bun run build:package && bun run build:web && bun run build:itun",
    "build:web": "bun --filter srd build",
    "build:itun": "bun --filter itun build",
    "build:package": "bun --filter salvageunion-reference build",
    "deploy-commands": "bun --filter discord-bot deploy-commands",
    "deploy-commands:global": "bun --filter discord-bot deploy-commands:global",
    "rules:extract": "bun tools/extract-rules.ts",
    "typecheck": "concurrently -g 'tsc --noEmit -p tsconfig.tools.json' 'bun --filter \"*\" typecheck'",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun run test:workspaces; a=$?; bun run test:tools; b=$?; [ \"$a\" = 0 ] && [ \"$b\" = 0 ]",
    "test:workspaces": "bun --filter \"*\" test",
    "test:coverage": "bun tools/run-coverage.ts",
    "test:tools": "bun test ./tools",
    "e2e:itun": "cd apps/itun && bunx playwright test",
    "clean": "bun --filter \"*\" clean || true",
    "reap": "tools/prune-stale-worktrees.sh",
    "knip": "knip",
    "check": "bun tools/check.ts",
    "check:fast": "bun tools/check.ts --profile=fast",
    "check:observability:live": "bun tools/check-observability.ts --live",
    "check:convex-parity:live": "bun tools/check-convex-parity.ts",
    "check:printed-names": "bun tools/check-printed-names.ts",
    "assets:export": "bun tools/export-lp-assets.ts",
    "assets:upload": "bun tools/upload-lp-assets.ts",
    "ladle": "bun --filter component-lib ladle"
  },
  "patchedDependencies": {
    "@ladle/react@5.1.1": "patches/@ladle%2Freact@5.1.1.patch"
  }
}
