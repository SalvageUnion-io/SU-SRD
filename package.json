{
  "name": "SURef",
  "private": true,
  "version": "3.0.12",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "license": "https://leyline.press/pages/salvage-union-open-game-licence-1-0b",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tools"
    ],
    "catalog": {
      "@base-ui/react": "1.6.0",
      "@randsum/roller": "4.0.0",
      "@randsum/salvageunion": "1.0.1",
      "@fontsource/barlow": "5.3.0",
      "@fontsource/barlow-semi-condensed": "5.3.0",
      "@fontsource/caveat": "5.3.0",
      "@sentry/browser": "10.69.0",
      "convex": "1.45.0",
      "lucide-react": "1.33.0",
      "react": "19.2.8",
      "react-dom": "19.2.8"
    }
  },
  "overrides": {
    "@randsum/roller": "4.0.0",
    "salvageunion-reference": "workspace:*",
    "sharp": ">=0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@cloudflare/workers-types": "5.20261001.1",
    "@happy-dom/global-registrator": "20.11.6",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react-swc": "4.3.3",
    "bun-types": "1.4.2",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "salvageunion-reference": "workspace:*",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.147.0"
  },
  "scripts": {
    "postinstall": "su-ref-generate",
    "prepare": "[ -z \"$CI\" ] && [ -d .git ] && bunx lefthook install || true",
    "dev": "bun --filter srd dev",
    "dev:itun": "bun --filter itun dev",
    "build": "su-ref-generate && bun --filter srd build && bun --filter itun build",
    "build:package": "bun --filter salvageunion-reference build",
    "deploy-commands": "bun --filter discord-bot deploy-commands",
    "deploy-commands:global": "bun --filter discord-bot deploy-commands:global",
    "brand": "bun --filter srd brand",
    "brand:discord": "bun apps/srd/scripts/brand/build.ts --upload-discord",
    "rules:extract": "bun tools/extract-rules.ts",
    "rules:find": "bun tools/rules-find.ts",
    "typecheck": "su-ref-generate && tsc -b",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "su-ref-generate && bun --filter \"*\" test",
    "test:coverage": "bun tools/run-coverage.ts",
    "e2e:itun": "cd apps/itun && bunx playwright test",
    "knip": "knip",
    "check": "bun tools/check.ts",
    "check:fast": "bun tools/check.ts --profile=fast",
    "audit": "bun audit",
    "check:rules-fidelity": "bun tools/check-rules-fidelity.ts",
    "assets:export": "bun tools/export-lp-assets.ts",
    "assets:upload": "bun tools/upload-lp-assets.ts",
    "assets:crop": "bun tools/art-crop.ts",
    "gallery": "bun tools/gallery.ts",
    "shot": "bun tools/shot.ts"
  }
}
