{
  "name": "susrd",
  "private": true,
  "version": "3.20.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "license": "https://leyline.press/pages/salvage-union-open-game-licence-1-0b",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tools"
    ],
    "catalog": {
      "@base-ui/react": "1.6.0",
      "@randsum/roller": "4.0.0",
      "@randsum/salvageunion": "1.0.1",
      "@fontsource/barlow": "5.3.0",
      "@fontsource/barlow-semi-condensed": "5.3.0",
      "@fontsource/caveat": "5.3.0",
      "convex": "1.45.0",
      "lucide-react": "1.33.0",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "sharp": "0.35.5"
    }
  },
  "overrides": {
    "@randsum/roller": "4.0.0",
    "salvageunion-reference": "workspace:*",
    "sharp": ">=0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "bun-types": "1.4.2",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "salvageunion-reference": "workspace:*",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  },
  "scripts": {
    "postinstall": "ref-generate",
    "prepare": "[ -z \"$CI\" ] && [ -d .git ] && bunx lefthook install || true",
    "dev": "bun --filter web dev",
    "build": "ref-generate && bun --filter web build",
    "build:package": "bun --filter salvageunion-reference build",
    "deploy-commands": "bun --filter discord-bot deploy-commands",
    "deploy-commands:global": "bun --filter discord-bot deploy-commands:global",
    "brand": "bun --filter web brand",
    "brand:discord": "bun --filter web brand:discord",
    "rules:extract": "bun tools/extract-rules.ts",
    "rules:find": "bun tools/rules-find.ts",
    "typecheck": "ref-generate && tsc -b",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "ref-generate && bun --filter \"*\" test",
    "test:coverage": "bun tools/run-coverage.ts",
    "e2e": "bun --filter web e2e",
    "knip": "knip",
    "check": "bun tools/check.ts",
    "check:fast": "bun tools/check.ts --profile=fast",
    "audit": "bun audit",
    "rules:fidelity": "bun tools/check-rules-fidelity.ts",
    "assets:export": "bun tools/export-lp-assets.ts",
    "assets:upload": "bun tools/upload-lp-assets.ts",
    "assets:crop": "bun tools/art-crop.ts",
    "gallery": "bun tools/gallery.ts",
    "shot": "bun tools/shot.ts"
  }
}
