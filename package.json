{
  "name": "suref",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "Salvage Union Open Game Licence 1.0b",
  "scripts": {
    "dev": "vite dev",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc --noEmit",
    "build:analyze": "vite build --mode analyze",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sanity": "bun run lint -- --fix && bun run format && bun run typecheck",
    "gen:types": "bunx supabase gen types typescript --project-id opxrguskxuogghzcnppk --schema public > src/types/database-generated.types.ts",
    "gen:zod": "bunx supazod --input src/types/database-generated.types.ts --output src/types/database-generated.zod.ts",
    "gen:all": "bun run gen:types && bun run gen:zod",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "validate": "bun run tools/validate.ts",
    "validate:ids": "bun run tools/validate.ts ids",
    "fix:ids": "bun run tools/generateMissingIds.ts",
    "validate:references": "bun run tools/validate.ts refs",
    "validate:actions": "bun run tools/validate.ts actions",
    "validate:generated": "bun run tools/validate.ts generated",
    "validate:all": "bun run tools/validate.ts all",
    "docs": "bun run tools/generators/docs.ts",
    "docs:schemas": "bun run tools/generators/schemaDocs.ts",
    "generate:json-schemas": "bun run tools/generators/jsonSchemas.ts",
    "clean": "rm -rf dist .vite node_modules/.vite",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "check:all": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run validate:all",
    "fix:all": "bun run lint -- --fix && bun run format"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.29.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@randsum/roller": "^0.27.0",
    "@randsum/salvageunion": "^0.37.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.81.1",
    "@tanstack/react-form": "^1.25.0",
    "@tanstack/react-query": "^5.90.9",
    "@tanstack/react-router": "^1.136.1",
    "@tanstack/react-start": "^1.136.1",
    "@tanstack/react-virtual": "^3.13.12",
    "@tanstack/router-plugin": "^1.136.1",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "framer-motion": "^12.23.24",
    "lightningcss": "^1.30.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "type-fest": "^5.2.0",
    "web-vitals": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@happy-dom/global-registrator": "^20.0.10",
    "@netlify/vite-plugin-tanstack-start": "^1.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.22",
    "bun-types": "^1.3.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "json-schema-to-typescript": "^15.0.4",
    "jsonschema": "^1.5.0",
    "netlify-cli": "^23.12.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "supazod": "^4.1.0",
    "terser": "^5.44.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.2",
    "vitest": "^4.0.14",
    "zod-to-json-schema": "^3.23.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
