# (Netlify + Render). Auth is via env vars (e.g. RENDER_API_KEY) / OAuth —
# never put tokens in it.

# Editor directories and files
.vscode/*
!.vscode/extensions.json
# $schema wiring for packages/salvageunion-reference/data/*.json — see that
# file's header comment.
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Netlify
.netlify

# Salvage Union rules content is NOT checked into git. The source PDFs and their
# text extract / authoring briefs (rules/) are copyright-bearing verbatim
# material; the condensed digest (docs/rules/) is derived from them. Both are
# generated and local-only — produce them with `bun run rules:regen`. Only the
# tooling (tools/rules-digest/, tools/extract-rules.ts) lives in git.
rules/*
docs/rules/

# Playwright artifacts (per-app)
apps/itun/playwright-report
apps/itun/test-results
.design-bundle/

# Parity baseline for ssg/parity.ts — an Astro-era dist that cannot be
# regenerated from this repo (Astro is deleted). Kept locally, never committed.
apps/srd/.parity-baseline/
