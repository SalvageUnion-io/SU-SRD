# Logs
*.log

# Dependencies
node_modules
# Another package manager's lockfile: bun.lock is the only one, so a stray
# install's lockfile never reaches a commit.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist
*.local
*.tsbuildinfo
# Swift Package Manager's cache directory (a stray `swift` run at the root)
.build/

# Test/E2E output
**/playwright-report/
**/test-results/
**/.playwright-mcp/
# Coverage output (each workspace's lcov from `bun run test:coverage`)
**/coverage/

# Profiling artifacts (bun --cpu-prof / --heap-prof, bun build --metafile-md).
# These default to the cwd, so without this they land beside the source they
# profiled and get swept into the next `git add -A`.
/.profiles/
*.cpuprofile
*.heapsnapshot

# salvageunion-reference build output. Regenerated from lib/schemas/ by
# the package's ref-generate bin (tools/ensureGenerated.ts), which postinstall,
# the root typecheck/test/build, bun run check, each app's dev and the test
# preload run first.
packages/salvageunion-reference/lib/generated/
packages/salvageunion-reference/lib/.generated.lock/
packages/salvageunion-reference/schemas/

# Vite
.vite

# TanStack Router temporary files
**/.tanstack
# generate-route-tree's scratch tree, left behind only if the run was killed
apps/web/src/.routeTree.gen.*.ts

# Environment variables
.env
.env.local
.env.*.local
# Wrangler's local secrets (a developer's Discord secret, the test build's TEST_AUTH)
.dev.vars*

# Claude Code
.claude/settings.local.json
# Agent/background-job worktrees: full checkouts that must never be committed.
.claude/worktrees/
# Per-agent memory a subagent writes for itself (e.g. a design reviewer's notes):
# working state, not project docs. Durable rules go in .claude/rules.
.claude/agent-memory/
# .mcp.json IS tracked: it is the shared, secret-free project MCP config
# (Cloudflare, Context7). Every server authenticates by OAuth on
# first connect — never put tokens in it.

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.sw?


# Salvage Union rules content is NOT checked into this public repo. The source
# PDFs and their text extract (rules/) are copyright-bearing verbatim material;
# their source of record is the private repo SalvageUnion-io/su-rules (a cloud
# session attaches it as a second repository). Locally, produce the extract with
# `bun run rules:extract`. Only the tooling (tools/extract-rules.ts) lives here.
/rules/*

# wrangler's local state and build scratch. `wrangler dev` writes its bundled
# Worker (plus the miniflare middleware it injects) into `.wrangler/tmp/`, which
# is generated JS nobody wrote — it is not just untracked noise, it is 69 lint
# errors the moment a dev server has run. Ignoring it keeps `bun run lint` from
# depending on whether someone left a server up.
.wrangler/

# `bun run shot`'s screenshots (tools/shot.ts)
/.shots/
# `bun run dev:backend`'s local state: the Worker's rooms, shared database and seed (tools/dev-backend.ts)
/.dev-backend/
# chrome-headless-shell for a sandbox the full Chromium cannot start in (packages/gates/lib/chromium.ts)
/.pw-browsers/

# Astro (ADR-065 spike): its generated types and its build
apps/web/.astro/
