# Logs
logs
*.log
.legacy/

# Dependencies
node_modules
**/node_modules

# Build outputs
dist
dist-ssr
**/dist
build-ladle
*.local
*.tsbuildinfo
core
.design-bundle/

# Test/E2E output
**/playwright-report/
**/test-results/
**/.playwright-mcp/
# Coverage output (bun test --coverage lcov reporter / CI capture file)
**/coverage/
coverage-output.txt
# Aggregated coverage report artifact (tools/coverage-report.ts), CI-only
/coverage-report/

# Temporary declaration emit for the reference package's API surface report
# (the committed snapshot lives at packages/salvageunion-reference/etc/)
packages/salvageunion-reference/.api-dts/

# Profiling artifacts (bun --cpu-prof / --heap-prof, bun build --metafile-md).
# These default to the cwd, so without this they land beside the source they
# profiled and get swept into the next `git add -A`.
/.profiles/
*.cpuprofile
*.heapsnapshot

# Vite
.vite
apps/srd/.vite

# TanStack Router temporary files
**/.tanstack

# Ladle
.ladle

# Environment variables
.env
.env.local
.env.*.local

# Claude Code
.claude/settings.local.json
# Agent/background-job worktrees: full checkouts that must never be committed.
# Prune abandoned ones with tools/prune-stale-worktrees.sh.
.claude/worktrees/
# .mcp.json IS tracked: it is the shared, secret-free project MCP config
# (Cloudflare, Sentry, Convex, Context7). Every server authenticates by OAuth on
# first connect — never put tokens in it.

# Editor directories and files
.vscode/*
!.vscode/extensions.json
# $schema wiring for packages/salvageunion-reference/data/*.json — see that
# file's header comment.
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# Salvage Union rules content is NOT checked into git. The source PDFs and their
# text extract (rules/) are copyright-bearing verbatim material, generated and
# local-only — produce the extract with `bun run rules:extract`. Only the tooling
# (tools/extract-rules.ts) lives in git.
#
# `docs/rules/` was listed here for a digest that was never authored; the
# generator behind it is retired. Nothing writes that path now.
rules/*

# Playwright artifacts (per-app)
apps/itun/playwright-report
apps/itun/test-results
.design-bundle/

# wrangler's local state and build scratch. `wrangler dev` writes its bundled
# Worker (plus the miniflare middleware it injects) into `.wrangler/tmp/`, which
# is generated JS nobody wrote — it is not just untracked noise, it is 69 lint
# errors the moment a dev server has run. Ignoring it keeps `bun run lint` from
# depending on whether someone left a server up.
.wrangler/

# claude.ai/design sync (design-sync skill)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
packages/component-lib/types/
packages/component-lib/.ds-css/
packages/component-lib/index.d.ts
.design-sync/tsconfig.dts.tsbuildinfo
