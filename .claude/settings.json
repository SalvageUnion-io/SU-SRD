{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun *)",
      "Bash(bun)",
      "Bash(bunx *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git checkout -b *)",
      "Bash(git checkout -B *)",
      "Bash(git switch *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git merge-base *)",
      "Bash(git cherry-pick *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(gh *)"
    ],
    "ask": [
      "Bash(bunx wrangler deploy*)",
      "Bash(bunx wrangler delete*)",
      "Bash(bunx wrangler secret *)",
      "Bash(bunx wrangler r2 object delete*)",
      "Bash(bunx wrangler r2 bucket delete*)",
      "Bash(bunx convex deploy*)",
      "Bash(bunx convex env set*)",
      "Bash(bunx convex env remove*)",
      "Bash(bunx convex import*)",
      "Bash(bun run deploy-commands*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(git branch -D*)",
      "Bash(git push * --delete*)",
      "Bash(git push * :*)",
      "Bash(bun x wrangler deploy*)",
      "Bash(bunx wrangler@* deploy*)",
      "Bash(bunx wrangler@* delete*)",
      "Bash(bunx wrangler@* secret *)",
      "Bash(bunx wrangler@* r2 * delete*)",
      "Bash(bunx convex@* deploy*)",
      "Bash(gh api * DELETE*)",
      "Bash(gh api *=DELETE*)",
      "Bash(gh workflow run*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch * --discard-changes*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git push * -d *)",
      "Bash(git push * --no-verify*)",
      "Bash(git switch --force*)",
      "Bash(git switch * --force*)",
      "Bash(bun *deploy-commands*)",
      "Bash(bun run wrangler *)",
      "Bash(bun x wrangler@* deploy*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh run rerun*)"
    ],
    "deny": [
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(git stash*)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push -f)",
      "Bash(git push -uf*)",
      "Bash(git push -fu*)",
      "Bash(git push * -uf*)",
      "Bash(git push * -fu*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --mirror*)",
      "Bash(git reset --hard*)",
      "Bash(git worktree remove*)",
      "Bash(rm -rf *)",
      "Read(./apps/srd/ssg/output-snapshot.json)"
    ]
  },
  "sandbox": {
    "network": {
      "allowUnixSockets": [
        "~/.cache/chrome-a11y"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-scoped.sh",
            "statusMessage": "Typechecking the edited workspace..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-generated-files.sh",
            "statusMessage": "Checking for protected files..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/enforce-bun.sh",
            "statusMessage": "Checking package manager..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "statusMessage": "Preparing the repo toolchain...",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
