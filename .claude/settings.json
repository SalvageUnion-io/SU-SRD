{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun *)",
      "Bash(bun)",
      "Bash(bunx *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git checkout -b *)",
      "Bash(git checkout -B *)",
      "Bash(git switch *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git merge-base *)",
      "Bash(git cherry-pick *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(gh *)"
    ],
    "ask": [
      "Bash(* deploy)",
      "Bash(* deploy *)",
      "Bash(*deploy-commands*)",
      "Bash(*wrangler* delete*)",
      "Bash(*wrangler* secret *)",
      "Bash(*convex* env set*)",
      "Bash(*convex* env remove*)",
      "Bash(*convex* import*)",
      "Bash(*convex*prod*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(git branch -D*)",
      "Bash(git push * --delete*)",
      "Bash(git push * :*)",
      "Bash(gh api -X*)",
      "Bash(gh api * -X*)",
      "Bash(gh api --method*)",
      "Bash(gh api * --method*)",
      "Bash(gh api -f*)",
      "Bash(gh api * -f*)",
      "Bash(gh api -F*)",
      "Bash(gh api * -F*)",
      "Bash(gh api --field*)",
      "Bash(gh api * --field*)",
      "Bash(gh api --raw-field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api --input*)",
      "Bash(gh api * --input*)",
      "Bash(gh issue delete*)",
      "Bash(gh run delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo rename*)",
      "mcp__convex__envSet",
      "mcp__convex__envRemove",
      "mcp__convex__run",
      "Bash(gh workflow run*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch * --discard-changes*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git push * -d *)",
      "Bash(git push * --no-verify*)",
      "Bash(git switch --force*)",
      "Bash(git switch * --force*)",
      "Bash(gh run rerun*)"
    ],
    "deny": [
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(git stash*)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push -f)",
      "Bash(git push -uf*)",
      "Bash(git push -fu*)",
      "Bash(git push * -uf*)",
      "Bash(git push * -fu*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --mirror*)",
      "Bash(git reset --hard*)",
      "Bash(git worktree remove*)",
      "Bash(rm -rf *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-scoped.sh",
            "statusMessage": "Typechecking the repo..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-generated-files.sh",
            "statusMessage": "Checking for protected files..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/enforce-bun.sh",
            "statusMessage": "Checking package manager..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "statusMessage": "Preparing the repo toolchain...",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
